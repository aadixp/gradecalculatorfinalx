</style>

<script define:vars={{ idPrefix }}>
  (function() {
    // -------------------------------------------------------------
    // Common Constants & Helper Functions
    // -------------------------------------------------------------
    const UGC_GRADES = [
      { letter: 'O', point: 10, label: 'O (Outstanding - 10)' },
      { letter: 'A+', point: 9, label: 'A+ (Excellent - 9)' },
      { letter: 'A', point: 8, label: 'A (Very Good - 8)' },
      { letter: 'B+', point: 7, label: 'B+ (Good - 7)' },
      { letter: 'B', point: 6, label: 'B (Above Average - 6)' },
      { letter: 'C', point: 5, label: 'C (Average - 5)' },
      { letter: 'P', point: 4, label: 'P (Pass - 4)' },
      { letter: 'F', point: 0, label: 'F (Fail - 0)' },
      { letter: 'Ab', point: 0, label: 'Ab (Absent - 0)' },
    ];

    const uid = () => Math.random().toString(36).substring(2, 9);

    function getStanding(cgpa) {
      if (cgpa >= 8.5) return { text: 'First Class with Distinction', class: 'badge-green' };
      if (cgpa >= 6.75) return { text: 'First Class', class: 'badge-blue' };
      if (cgpa >= 5.75) return { text: 'Higher Second Class', class: 'badge-amber' };
      if (cgpa >= 5.0) return { text: 'Second Class', class: 'badge-amber' };
      if (cgpa >= 4.0) return { text: 'Pass Class', class: 'badge-blue' };
      return { text: 'Remedial / Fail', class: 'badge-red' };
    }

    // -------------------------------------------------------------
    // View Switcher (Selector, Quick, Detailed)
    // -------------------------------------------------------------
    const viewSelector = document.getElementById(`${idPrefix}-view-selector`);
    const viewQuick = document.getElementById(`${idPrefix}-view-quick`);
    const viewDetailed = document.getElementById(`${idPrefix}-view-detailed`);

    let currentView = 'selector';

    function setView(viewName) {
      currentView = viewName;
      if (viewSelector) viewSelector.style.display = viewName === 'selector' ? 'block' : 'none';
      if (viewQuick) viewQuick.style.display = viewName === 'quick' ? 'block' : 'none';
      if (viewDetailed) viewDetailed.style.display = viewName === 'detailed' ? 'block' : 'none';

      if (viewName === 'quick') {
        renderQuickSemesters();
      } else if (viewName === 'detailed') {
        renderRows();
      }
    }

    // Choice Cards & Buttons Clicks
    const cardQuick = document.getElementById(`${idPrefix}-card-quick`);
    const cardDetailed = document.getElementById(`${idPrefix}-card-detailed`);

    const openQuick = (e) => {
      if (e) { e.preventDefault(); e.stopPropagation(); }
      setView('quick');
    };

    const openDetailed = (e) => {
      if (e) { e.preventDefault(); e.stopPropagation(); }
      setView('detailed');
    };

    cardQuick?.addEventListener('click', openQuick);
    cardQuick?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openQuick(); }
    });

    cardDetailed?.addEventListener('click', openDetailed);
    cardDetailed?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openDetailed(); }
    });

    // Link inside Quick CGPA explanation text to switch to subjects
    document.getElementById(`${idPrefix}-quick-switch-to-detailed`)?.addEventListener('click', openDetailed);

    // Back Buttons
    document.getElementById(`${idPrefix}-quick-back-btn`)?.addEventListener('click', () => setView('selector'));
    document.getElementById(`${idPrefix}-detailed-back-btn`)?.addEventListener('click', () => setView('selector'));

    // Mode Switch Pills
    document.getElementById(`${idPrefix}-quick-pill-quick`)?.addEventListener('click', () => setView('quick'));
    document.getElementById(`${idPrefix}-quick-pill-detailed`)?.addEventListener('click', () => setView('detailed'));
    document.getElementById(`${idPrefix}-detailed-pill-quick`)?.addEventListener('click', () => setView('quick'));
    document.getElementById(`${idPrefix}-detailed-pill-detailed`)?.addEventListener('click', () => setView('detailed'));

    // -------------------------------------------------------------
    // QUICK CGPA CALCULATOR LOGIC (Semester-Based)
    // -------------------------------------------------------------
    const sampleSemesters = [
      { id: uid(), name: 'Semester 1', sgpa: 8.50, credits: 22 },
      { id: uid(), name: 'Semester 2', sgpa: 8.80, credits: 22 },
      { id: uid(), name: 'Semester 3', sgpa: 8.60, credits: 22 },
      { id: uid(), name: 'Semester 4', sgpa: 8.90, credits: 22 },
      { id: uid(), name: 'Semester 5', sgpa: 8.70, credits: 22 },
      { id: uid(), name: 'Semester 6', sgpa: 9.10, credits: 22 },
      { id: uid(), name: 'Semester 7', sgpa: 8.65, credits: 22 },
      { id: uid(), name: 'Semester 8', sgpa: 8.75, credits: 22 },
    ];

    function createBlankSemesters() {
      return [
        { id: uid(), name: 'Semester 1', sgpa: null, credits: null },
        { id: uid(), name: 'Semester 2', sgpa: null, credits: null },
        { id: uid(), name: 'Semester 3', sgpa: null, credits: null },
        { id: uid(), name: 'Semester 4', sgpa: null, credits: null },
        { id: uid(), name: 'Semester 5', sgpa: null, credits: null },
        { id: uid(), name: 'Semester 6', sgpa: null, credits: null },
        { id: uid(), name: 'Semester 7', sgpa: null, credits: null },
        { id: uid(), name: 'Semester 8', sgpa: null, credits: null },
      ];
    }

    let semesters = createBlankSemesters();

    const quickTbody = document.getElementById(`${idPrefix}-quick-tbody`);
    const qCgpaEl = document.getElementById(`${idPrefix}-quick-result-cgpa`);
    const qPctEl = document.getElementById(`${idPrefix}-quick-result-pct`);
    const qStandingBadge = document.getElementById(`${idPrefix}-quick-standing-badge`);
    const qDispSems = document.getElementById(`${idPrefix}-quick-disp-sems`);
    const qDispCredits = document.getElementById(`${idPrefix}-quick-disp-credits`);
    const qFooterCount = document.getElementById(`${idPrefix}-quick-footer-count`);
    const qBreakdownEl = document.getElementById(`${idPrefix}-quick-breakdown-text`);

    function renderQuickSemesters() {
      if (!quickTbody) return;
      quickTbody.innerHTML = '';

      semesters.forEach((sem, idx) => {
        const trRow = document.createElement('tr');
        trRow.className = 'mobile-card-row quick-sem-card-row';
        trRow.style.borderBottom = '1px solid var(--color-hairline)';

        trRow.innerHTML = `
          <td class="td-quick-sem-name" style="padding: 0.5rem 0.75rem; font-weight: 500; color: var(--color-ink);">
            <span class="quick-sem-title">${sem.name || `Semester ${idx + 1}`}</span>
          </td>
          <td class="td-quick-sem-sgpa" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Semester SGPA (0 - 10)</span>
            <input type="number" step="0.01" min="0" max="10" class="form-input form-input-mono sem-sgpa-input" data-id="${sem.id}" value="${sem.sgpa !== null ? sem.sgpa : ''}" placeholder="e.g. 8.50" />
          </td>
          <td class="td-quick-sem-credits" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Semester Credits (Optional)</span>
            <input type="number" step="0.5" min="0" max="40" class="form-input form-input-mono sem-credits-input" data-id="${sem.id}" value="${sem.credits !== null && sem.credits !== '' ? sem.credits : ''}" placeholder="Optional (e.g. 22)" />
          </td>
          <td class="td-quick-sem-del" style="padding: 0.5rem 0.75rem; text-align: right;">
            ${semesters.length > 1 ? `
              <button type="button" class="btn btn-ghost btn-icon delete-sem-btn" data-id="${sem.id}" title="Remove semester" aria-label="Remove semester">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            ` : ''}
          </td>
        `;

        quickTbody.appendChild(trRow);
      });

      calcQuickCgpa();
    }

    function calcQuickCgpa() {
      const validSems = [];

      semesters.forEach((sem, idx) => {
        const sgpaNum = sem.sgpa !== null && !isNaN(sem.sgpa) && sem.sgpa !== '' ? parseFloat(sem.sgpa) : null;
        const creditsNum = sem.credits !== null && !isNaN(sem.credits) && sem.credits !== '' ? parseFloat(sem.credits) : null;

        if (sgpaNum !== null && sgpaNum >= 0 && sgpaNum <= 10) {
          validSems.push({
            name: sem.name || `Semester ${idx + 1}`,
            sgpa: sgpaNum,
            credits: creditsNum
          });
        }
      });

      if (qFooterCount) qFooterCount.textContent = validSems.length.toString();

      if (validSems.length > 0) {
        // Check if credits are used
        const semsWithCredits = validSems.filter(s => s.credits !== null && s.credits > 0);
        const hasCredits = semsWithCredits.length > 0;

        // Check if all entered credits are identical
        const allCreditsEqual = hasCredits && validSems.every(s => s.credits !== null && s.credits === validSems[0].credits);

        let finalCgpa = 0;
        let totalCredits = 0;
        let totalWeightedPoints = 0;
        let isWeighted = false;

        if (hasCredits && !allCreditsEqual) {
          isWeighted = true;
          // If some semesters have credits entered and some are blank, default blank ones to average of entered credits
          const avgCredit = semsWithCredits.reduce((acc, s) => acc + s.credits, 0) / semsWithCredits.length;

          validSems.forEach(s => {
            const c = (s.credits !== null && s.credits > 0) ? s.credits : avgCredit;
            totalCredits += c;
            totalWeightedPoints += (s.sgpa * c);
          });
          finalCgpa = totalCredits > 0 ? (totalWeightedPoints / totalCredits) : 0;
        } else {
          // Equal credit weighting: simple average of entered semester SGPAs
          const sumSgpa = validSems.reduce((acc, s) => acc + s.sgpa, 0);
          finalCgpa = sumSgpa / validSems.length;
          totalCredits = hasCredits ? (validSems.length * (validSems[0].credits || 20)) : (validSems.length * 20);
        }

        const approxPct = finalCgpa * 9.5;
        const standing = getStanding(finalCgpa);

        if (qCgpaEl) qCgpaEl.textContent = finalCgpa.toFixed(2);
        if (qPctEl) qPctEl.textContent = `${approxPct.toFixed(2)}%`;
        if (qStandingBadge) {
          qStandingBadge.textContent = standing.text;
          qStandingBadge.className = `badge ${standing.class}`;
        }
        if (qDispSems) qDispSems.textContent = validSems.length.toString();
        if (qDispCredits) {
          qDispCredits.textContent = isWeighted ? `${totalCredits.toFixed(1)} Credits` : 'Equal Weight';
        }

        if (qBreakdownEl) {
          if (isWeighted) {
            qBreakdownEl.innerHTML = `
              <p style="margin-bottom: 0.5rem; color: var(--color-ink);">
                <strong>Weighted CGPA</strong> = Total Quality Points (${totalWeightedPoints.toFixed(1)}) &divide; Total Semester Credits (${totalCredits.toFixed(1)}) = <strong>${finalCgpa.toFixed(2)}</strong>
              </p>
              <p style="margin-bottom: 0.5rem; color: var(--color-ink);">
                <strong>Approx. Percentage</strong> = CGPA (${finalCgpa.toFixed(2)}) &times; 9.5 = <strong>${approxPct.toFixed(2)}%</strong>
              </p>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-mute); background: var(--color-canvas); padding: 0.4rem 0.6rem; border-radius: var(--radius-xs); border: 1px solid var(--color-hairline);">
                Formula: CGPA = &Sigma;(SGPA<sub>i</sub> &times; Credits<sub>i</sub>) &divide; &Sigma;Credits<sub>i</sub>
              </div>
            `;
          } else {
            const semSgpaList = validSems.map(s => s.sgpa.toFixed(2)).join(' + ');
            qBreakdownEl.innerHTML = `
              <p style="margin-bottom: 0.5rem; color: var(--color-ink);">
                <strong>Equal-Weight CGPA</strong> = (${semSgpaList}) &divide; ${validSems.length} Semesters = <strong>${finalCgpa.toFixed(2)}</strong>
              </p>
              <p style="margin-bottom: 0.5rem; color: var(--color-ink);">
                <strong>Approx. Percentage</strong> = CGPA (${finalCgpa.toFixed(2)}) &times; 9.5 = <strong>${approxPct.toFixed(2)}%</strong>
              </p>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-mute); background: var(--color-canvas); padding: 0.4rem 0.6rem; border-radius: var(--radius-xs); border: 1px solid var(--color-hairline);">
                Formula: CGPA = (&Sigma;SGPA<sub>i</sub>) &divide; N (${allCreditsEqual ? `all semesters have equal credits: ${validSems[0].credits} credits each` : 'equal credit weighting across all semesters'})
              </div>
            `;
          }
        }
      } else {
        if (qCgpaEl) qCgpaEl.textContent = '--';
        if (qPctEl) qPctEl.textContent = '--%';
        if (qStandingBadge) {
          qStandingBadge.textContent = 'Awaiting Input';
          qStandingBadge.className = 'badge badge-blue';
        }
        if (qDispSems) qDispSems.textContent = '0';
        if (qDispCredits) qDispCredits.textContent = 'Equal Weight';
        if (qBreakdownEl) {
          qBreakdownEl.textContent = 'Enter your semester SGPAs above to see the calculation breakdown.';
        }
      }
    }

    quickTbody?.addEventListener('input', (e) => {
      const target = e.target;
      const id = target.getAttribute('data-id');
      if (!id) return;
      const sem = semesters.find(x => x.id === id);
      if (!sem) return;

      if (target.classList.contains('sem-sgpa-input')) {
        sem.sgpa = target.value === '' ? null : Math.min(10, Math.max(0, parseFloat(target.value) || 0));
      } else if (target.classList.contains('sem-credits-input')) {
        sem.credits = target.value === '' ? null : Math.max(0, parseFloat(target.value) || 0);
      }

      calcQuickCgpa();
    });

    quickTbody?.addEventListener('click', (e) => {
      const btn = e.target.closest('.delete-sem-btn');
      if (!btn) return;
      const id = btn.getAttribute('data-id');
      if (!id) return;
      semesters = semesters.filter(x => x.id !== id);
      // Re-number remaining default semester names
      semesters.forEach((s, idx) => {
        if (!s.name || s.name.startsWith('Semester ')) {
          s.name = `Semester ${idx + 1}`;
        }
      });
      renderQuickSemesters();
    });

    document.getElementById(`${idPrefix}-quick-add-sem-btn`)?.addEventListener('click', () => {
      const nextNum = semesters.length + 1;
      semesters.push({
        id: uid(),
        name: `Semester ${nextNum}`,
        sgpa: null,
        credits: null
      });
      renderQuickSemesters();
    });

    document.getElementById(`${idPrefix}-quick-sample-btn`)?.addEventListener('click', () => {
      semesters = JSON.parse(JSON.stringify(sampleSemesters));
      renderQuickSemesters();
    });

    document.getElementById(`${idPrefix}-quick-reset-btn`)?.addEventListener('click', () => {
      semesters = createBlankSemesters();
      renderQuickSemesters();
    });

    // -------------------------------------------------------------
    // CALCULATE CGPA FROM SUBJECTS LOGIC (Preserved & Intact)
    // -------------------------------------------------------------
    const defaultSubjects = [
      { id: uid(), name: 'Engineering Mathematics', grade: 'O', point: 10, credits: 4 },
      { id: uid(), name: 'Data Structures & Algorithms', grade: 'A+', point: 9, credits: 4 },
      { id: uid(), name: 'Computer Organization', grade: 'A', point: 8, credits: 3 },
      { id: uid(), name: 'Object Oriented Programming', grade: 'A+', point: 9, credits: 4 },
      { id: uid(), name: 'Digital Electronics', grade: 'B+', point: 7, credits: 3 },
    ];

    let subjects = JSON.parse(JSON.stringify(defaultSubjects));

    const tbody = document.getElementById(`${idPrefix}-tbody`);
    const cgpaEl = document.getElementById(`${idPrefix}-result-cgpa`);
    const pctEl = document.getElementById(`${idPrefix}-result-pct`);
    const standingBadge = document.getElementById(`${idPrefix}-standing-badge`);
    const totalCreditsEl = document.getElementById(`${idPrefix}-total-credits`);
    const totalPointsEl = document.getElementById(`${idPrefix}-total-points`);
    const footerCreditsEl = document.getElementById(`${idPrefix}-footer-credits`);
    const footerPointsEl = document.getElementById(`${idPrefix}-footer-points`);
    const breakdownEl = document.getElementById(`${idPrefix}-breakdown-text`);

    function renderRows() {
      if (!tbody) return;
      tbody.innerHTML = '';

      subjects.forEach((subj, idx) => {
        const tr = document.createElement('tr');
        tr.className = 'mobile-card-row subject-card-row';
        tr.style.borderBottom = '1px solid var(--color-hairline)';

        const ptsEarned = ((subj.point || 0) * (subj.credits || 0)).toFixed(1);

        tr.innerHTML = `
          <td class="td-cgpa-name" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Subject #${idx + 1}</span>
            <input type="text" class="form-input subj-name-input" data-id="${subj.id}" value="${subj.name || ''}" placeholder="e.g. Engineering Maths" />
          </td>
          <td class="td-cgpa-grade" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Letter Grade</span>
            <select class="form-select subj-grade-select" data-id="${subj.id}">
              <option value="">-- Select Grade --</option>
              ${UGC_GRADES.map(g => `<option value="${g.letter}" ${g.letter === subj.grade ? 'selected' : ''}>${g.label}</option>`).join('')}
              <option value="custom" ${subj.grade === 'custom' ? 'selected' : ''}>Custom Grade Point</option>
            </select>
          </td>
          <td class="td-cgpa-point" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Grade Point (0-10)</span>
            <input type="number" step="0.1" min="0" max="10" class="form-input form-input-mono subj-point-input" data-id="${subj.id}" value="${subj.point !== null ? subj.point : ''}" placeholder="0-10" />
          </td>
          <td class="td-cgpa-credits" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Credits</span>
            <input type="number" step="0.5" min="0" max="15" class="form-input form-input-mono subj-credits-input" data-id="${subj.id}" value="${subj.credits || ''}" placeholder="Credits" />
          </td>
          <td class="td-cgpa-pts-earned" style="padding: 0.5rem 0.75rem; text-align: right; font-family: var(--font-mono); font-weight: 600; color: var(--color-ink);">
            <span class="mobile-input-label">Credit Points</span>
            <span>${ptsEarned}</span>
          </td>
          <td class="td-cgpa-del" style="padding: 0.5rem 0.75rem; text-align: right;">
            <button type="button" class="btn btn-ghost btn-icon delete-subj-btn" data-id="${subj.id}" title="Remove subject" aria-label="Remove subject">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </td>
        `;

        tbody.appendChild(tr);
      });

      calculate();
    }

    function calculate() {
      let totalCredits = 0;
      let totalPoints = 0;
      const breakdownRows = [];

      subjects.forEach((s) => {
        const c = Number(s.credits) || 0;
        const p = s.point !== null && !isNaN(s.point) ? Number(s.point) : null;

        if (c > 0 && p !== null) {
          totalCredits += c;
          const weighted = p * c;
          totalPoints += weighted;
          breakdownRows.push({
            name: s.name || 'Subject',
            point: p,
            credits: c,
            weighted: weighted
          });
        }
      });

      if (totalCredits > 0) {
        const cgpa = totalPoints / totalCredits;
        const approxPct = (cgpa * 9.5);
        const standing = getStanding(cgpa);

        if (cgpaEl) cgpaEl.textContent = cgpa.toFixed(2);
        if (pctEl) pctEl.textContent = `${approxPct.toFixed(2)}%`;
        if (standingBadge) {
          standingBadge.textContent = standing.text;
          standingBadge.className = `badge ${standing.class}`;
        }
        if (totalCreditsEl) totalCreditsEl.textContent = totalCredits.toFixed(1);
        if (totalPointsEl) totalPointsEl.textContent = totalPoints.toFixed(1);
        if (footerCreditsEl) footerCreditsEl.textContent = totalCredits.toFixed(1);
        if (footerPointsEl) footerPointsEl.textContent = totalPoints.toFixed(1);

        if (breakdownEl) {
          const breakdownTable = `
            <div style="overflow-x: auto; margin-top: 0.75rem;">
              <table style="width: 100%; border-collapse: collapse; font-size: 0.8125rem;">
                <thead>
                  <tr style="border-bottom: 1px solid var(--color-hairline); text-align: left;">
                    <th style="padding: 0.4rem 0.5rem;">Subject</th>
                    <th style="padding: 0.4rem 0.5rem; text-align: center;">Grade Point</th>
                    <th style="padding: 0.4rem 0.5rem; text-align: center;">Credits</th>
                    <th style="padding: 0.4rem 0.5rem; text-align: right;">Weighted Points (Grade &times; Credits)</th>
                  </tr>
                </thead>
                <tbody>
                  ${breakdownRows.map(r => `
                    <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
                      <td style="padding: 0.4rem 0.5rem; color: var(--color-ink); font-weight: 500;">${r.name}</td>
                      <td style="padding: 0.4rem 0.5rem; text-align: center; font-family: var(--font-mono);">${r.point}</td>
                      <td style="padding: 0.4rem 0.5rem; text-align: center; font-family: var(--font-mono);">${r.credits}</td>
                      <td style="padding: 0.4rem 0.5rem; text-align: right; font-family: var(--font-mono);">${r.weighted.toFixed(1)}</td>
                    </tr>
                  `).join('')}
                  <tr style="font-weight: 600; color: var(--color-ink); background: var(--color-canvas-hover);">
                    <td style="padding: 0.5rem;">Total / Calculation:</td>
                    <td style="padding: 0.5rem; text-align: center;">--</td>
                    <td style="padding: 0.5rem; text-align: center; font-family: var(--font-mono);">${totalCredits.toFixed(1)}</td>
                    <td style="padding: 0.5rem; text-align: right; font-family: var(--font-mono);">${totalPoints.toFixed(1)}</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p style="margin-top: 0.75rem; font-size: 0.8125rem; font-family: var(--font-mono);">
              <strong>Final CGPA</strong> = Total Weighted Quality Points (${totalPoints.toFixed(1)}) &divide; Total Credits (${totalCredits.toFixed(1)}) = <strong>${cgpa.toFixed(2)}</strong> / 10.0
            </p>
          `;
          breakdownEl.innerHTML = breakdownTable;
        }
      } else {
        if (cgpaEl) cgpaEl.textContent = '--';
        if (pctEl) pctEl.textContent = '--%';
        if (standingBadge) {
          standingBadge.textContent = 'Awaiting Input';
          standingBadge.className = 'badge badge-blue';
        }
        if (totalCreditsEl) totalCreditsEl.textContent = '0';
        if (totalPointsEl) totalPointsEl.textContent = '0.0';
        if (footerCreditsEl) footerCreditsEl.textContent = '0';
        if (footerPointsEl) footerPointsEl.textContent = '0.0';
        if (breakdownEl) {
          breakdownEl.textContent = 'Add subjects, select grades and enter credit hours to view the weighted breakdown.';
        }
      }
    }

    // Input delegations
    tbody?.addEventListener('input', (e) => {
      const target = e.target;
      const id = target.getAttribute('data-id');
      if (!id) return;
      const s = subjects.find(x => x.id === id);
      if (!s) return;

      if (target.classList.contains('subj-name-input')) {
        s.name = target.value;
      } else if (target.classList.contains('subj-point-input')) {
        s.point = target.value === '' ? null : Math.min(10, Math.max(0, parseFloat(target.value) || 0));
        const matched = UGC_GRADES.find(g => g.point === s.point);
        s.grade = matched ? matched.letter : 'custom';
        const select = tbody.querySelector(`.subj-grade-select[data-id="${id}"]`);
        if (select) select.value = s.grade;
      } else if (target.classList.contains('subj-credits-input')) {
        s.credits = target.value === '' ? null : parseFloat(target.value) || 0;
      }

      const ptsCell = target.closest('tr')?.querySelector('.td-cgpa-pts-earned span:not(.mobile-input-label)');
      if (ptsCell) {
        ptsCell.textContent = ((s.point || 0) * (s.credits || 0)).toFixed(1);
      }

      calculate();
    });

    tbody?.addEventListener('change', (e) => {
      const target = e.target;
      const id = target.getAttribute('data-id');
      if (!id) return;
      const s = subjects.find(x => x.id === id);
      if (!s) return;

      if (target.classList.contains('subj-grade-select')) {
        const val = target.value;
        s.grade = val;
        const matched = UGC_GRADES.find(g => g.letter === val);
        if (matched) {
          s.point = matched.point;
          const pointInput = tbody.querySelector(`.subj-point-input[data-id="${id}"]`);
          if (pointInput) pointInput.value = matched.point.toString();
        }
        const ptsCell = target.closest('tr')?.querySelector('.td-cgpa-pts-earned span:not(.mobile-input-label)');
        if (ptsCell) {
          ptsCell.textContent = ((s.point || 0) * (s.credits || 0)).toFixed(1);
        }
        calculate();
      }
    });

    tbody?.addEventListener('click', (e) => {
      const btn = e.target.closest('.delete-subj-btn');
      if (!btn) return;
      const id = btn.getAttribute('data-id');
      if (!id) return;
      subjects = subjects.filter(x => x.id !== id);
      renderRows();
    });

    // Add subject
    const addFn = () => {
      subjects.push({
        id: uid(),
        name: '',
        grade: 'A',
        point: 8,
        credits: 3
      });
      renderRows();
    };
    document.getElementById(`${idPrefix}-add-subject-btn`)?.addEventListener('click', addFn);
    document.getElementById(`${idPrefix}-add-subject-bottom-btn`)?.addEventListener('click', addFn);

    // Sample data
    document.getElementById(`${idPrefix}-sample-btn`)?.addEventListener('click', () => {
      subjects = JSON.parse(JSON.stringify(defaultSubjects));
      renderRows();
    });

    // Reset
    document.getElementById(`${idPrefix}-reset-btn`)?.addEventListener('click', () => {
      subjects = [
        { id: uid(), name: '', grade: '', point: null, credits: null },
        { id: uid(), name: '', grade: '', point: null, credits: null },
        { id: uid(), name: '', grade: '', point: null, credits: null },
      ];
      renderRows();
    });

    // Listen for tab switch to reset to initial option selector view
    window.addEventListener('gradecalc:cgpa-reset-view', () => {
      setView('selector');
    });

    // Initial load starts at Selector view
    setView('selector');
  })();
</script>
