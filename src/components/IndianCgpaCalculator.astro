---
// src/components/IndianCgpaCalculator.astro
interface Props {
  idPrefix?: string;
  lang?: string;
}
const { idPrefix = 'cgpa' } = Astro.props;
---

<div id={`${idPrefix}-calculator-panel`} class="calc-component-root">
  <!-- VIEW 1: Initial Option Selector (Two Compact Square Cards) -->
  <div id={`${idPrefix}-view-selector`} class="cgpa-view-container">
    <div class="cgpa-choice-wrapper">
      <div class="cgpa-choice-header-text">
        <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.35rem; display: inline-block;">Indian University 10-Point CBCS Grading System</span>
        <h2 class="heading-lg" style="font-size: clamp(1.35rem, 3vw, 1.75rem); letter-spacing: -0.02em; color: var(--color-ink); margin-bottom: 0.4rem;">
          Choose CGPA Calculation Method
        </h2>
        <p style="font-size: 0.9375rem; color: var(--color-mute); line-height: 1.5; margin: 0 auto; max-width: 520px;">
          Select how you would like to calculate your Cumulative Grade Point Average (CGPA):
        </p>
      </div>

      <!-- Two compact near-square cards side by side on desktop, stacked on mobile -->
      <div class="cgpa-square-cards-grid">
        <!-- Option 1: Quick CGPA Calculator -->
        <div class="cgpa-square-card" id={`${idPrefix}-card-quick`} role="button" tabindex="0" aria-label="Open Quick CGPA Calculator">
          <div class="cgpa-card-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <h3 class="cgpa-card-title">Quick CGPA Calculator</h3>
          <p class="cgpa-card-desc">
            Calculate overall CGPA directly from your semester SGPAs without typing subject details.
          </p>
          <div class="cgpa-card-btn-wrap">
            <span class="btn btn-secondary btn-sm cgpa-card-btn">
              Select &rarr;
            </span>
          </div>
        </div>

        <!-- Option 2: Calculate CGPA from Subjects -->
        <div class="cgpa-square-card" id={`${idPrefix}-card-detailed`} role="button" tabindex="0" aria-label="Open Calculate CGPA from Subjects">
          <div class="cgpa-card-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h3 class="cgpa-card-title">Calculate CGPA from Subjects</h3>
          <p class="cgpa-card-desc">
            Calculate CGPA from individual course titles, UGC letter grades, grade points, and credits.
          </p>
          <div class="cgpa-card-btn-wrap">
            <span class="btn btn-secondary btn-sm cgpa-card-btn">
              Select &rarr;
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- VIEW 2: Quick CGPA Calculator (Semester-based) -->
  <div id={`${idPrefix}-view-quick`} class="cgpa-view-container" style="display: none;">
    <!-- Navigation Bar -->
    <div class="cgpa-mode-bar">
      <button type="button" class="btn btn-ghost btn-sm cgpa-back-btn" id={`${idPrefix}-quick-back-btn`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Choose Calculation Method
      </button>

      <div class="cgpa-mode-pills">
        <button type="button" class="cgpa-mode-pill active" id={`${idPrefix}-quick-pill-quick`}>Quick CGPA</button>
        <button type="button" class="cgpa-mode-pill" id={`${idPrefix}-quick-pill-detailed`}>From Subjects</button>
      </div>
    </div>

    <!-- Quick Result Card -->
    <div class="geist-card geist-card-floating" style="padding: 1.5rem; margin-bottom: 1.5rem; background: linear-gradient(180deg, var(--color-canvas-elevated) 0%, var(--color-canvas-subtle) 100%);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.25rem; align-items: center;">
        <div>
          <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.25rem;">Cumulative GPA (10.0 Scale)</span>
          <div style="display: flex; align-items: baseline; gap: 0.75rem;">
            <span id={`${idPrefix}-quick-result-cgpa`} class="display-xl" style="font-feature-settings: 'tnum';">--</span>
            <span id={`${idPrefix}-quick-standing-badge`} class="badge badge-blue">Awaiting Input</span>
          </div>
          <p style="font-size: 0.875rem; color: var(--color-mute); margin-top: 0.25rem;">
            Approx. Percentage: <strong style="color: var(--color-ink);" id={`${idPrefix}-quick-result-pct`}>--%</strong>
            <span style="font-size: 0.75rem;">(AICTE &times; 9.5 Standard)</span>
          </p>
        </div>

        <!-- Breakdown Info -->
        <div class="responsive-col-divider" style="border-left: 1px solid var(--color-hairline); padding-left: 1.25rem;">
          <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
            <span style="color: var(--color-mute);">Completed Semesters:</span>
            <span id={`${idPrefix}-quick-disp-sems`} style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">0</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.5rem;">
            <span style="color: var(--color-mute);">Calculation Mode:</span>
            <span id={`${idPrefix}-quick-disp-credits`} style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">Equal Weight</span>
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-mute); background: var(--color-canvas-subtle); padding: 0.35rem 0.5rem; border-radius: var(--radius-xs); border: 1px solid var(--color-hairline);">
            CGPA = &Sigma;(SGPA<sub>i</sub> &times; Credits<sub>i</sub>) &divide; &Sigma;Credits
          </div>
        </div>

        <!-- Actions -->
        <div style="display: flex; flex-direction: column; gap: 0.5rem; justify-content: center;">
          <button id={`${idPrefix}-quick-sample-btn`} type="button" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem;">
            Load 8-Semester Sample
          </button>
          <button id={`${idPrefix}-quick-reset-btn`} type="button" class="btn btn-ghost" style="font-size: 0.8125rem; color: var(--color-mute);">
            Reset to Blank
          </button>
        </div>
      </div>
    </div>

    <!-- Quick Semesters Inputs Card -->
    <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
      <div style="margin-bottom: 1.25rem;">
        <h3 class="heading-md" style="margin-bottom: 0.35rem;">Enter Your Semester SGPA</h3>
        <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.5; margin: 0 0 0.4rem 0;">
          Already know your SGPA for each semester? Enter your Semester 1, Semester 2, Semester 3, etc. SGPA above to calculate your overall CGPA.
        </p>
        <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.5; margin: 0;">
          Don't know your SGPA? Use <button type="button" class="cgpa-text-link-btn" id={`${idPrefix}-quick-switch-to-detailed`}>Calculate CGPA from Subjects</button> to calculate it from your individual subjects, grades, grade points, and credits.
        </p>
      </div>

      <!-- Info on Credits -->
      <div style="background: var(--color-canvas-subtle); padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); margin-bottom: 1.25rem; font-size: 0.8125rem; color: var(--color-mute); line-height: 1.5;">
        <strong style="color: var(--color-ink);">Optional Semester Credits:</strong> If your university assigns different credit weights to different semesters (for example, 20 credits in Semester 1 vs 24 in Semester 2), enter credits for an exact credit-weighted CGPA. If left blank or if all semesters have equal credits, the overall CGPA is calculated directly from your semester SGPAs.
      </div>

      <!-- Semesters Table / Rows -->
      <div class="mobile-table-card-wrap" style="width: 100%; overflow-x: auto; margin-bottom: 1rem;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 1px solid var(--color-hairline); text-align: left; font-size: 0.8125rem; color: var(--color-mute);">
              <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 170px;">Semester</th>
              <th style="padding: 0.5rem 0.75rem; font-weight: 500;">Semester SGPA (0 - 10)</th>
              <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 220px;">Semester Credits (Optional)</th>
              <th style="padding: 0.5rem 0.75rem; width: 44px;"></th>
            </tr>
          </thead>
          <tbody id={`${idPrefix}-quick-tbody`}>
            <!-- Rendered dynamically by script -->
          </tbody>
        </table>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--color-hairline);">
        <button id={`${idPrefix}-quick-add-sem-btn`} type="button" class="btn btn-secondary" style="font-weight: 600; font-size: 0.8125rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Another Semester
        </button>

        <div style="font-size: 0.8125rem; color: var(--color-mute);">
          Semesters Entered: <strong id={`${idPrefix}-quick-footer-count`} style="color: var(--color-ink); font-family: var(--font-mono);">0</strong>
        </div>
      </div>
    </div>

    <!-- Quick Breakdown Card -->
    <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem; background: var(--color-canvas-subtle);">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
        <span class="badge badge-green">CGPA Breakdown</span>
        <h4 class="heading-md" style="font-size: 1rem;">Calculation Breakdown</h4>
      </div>
      <div id={`${idPrefix}-quick-breakdown-text`} style="font-size: 0.875rem; color: var(--color-body); line-height: 1.6;">
        Enter your semester SGPAs above to see the calculation breakdown.
      </div>
    </div>
  </div>

  <!-- VIEW 3: Calculate CGPA from Subjects (Intact Logic) -->
  <div id={`${idPrefix}-view-detailed`} class="cgpa-view-container" style="display: none;">
    <!-- Navigation Bar -->
    <div class="cgpa-mode-bar">
      <button type="button" class="btn btn-ghost btn-sm cgpa-back-btn" id={`${idPrefix}-detailed-back-btn`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Choose Calculation Method
      </button>

      <div class="cgpa-mode-pills">
        <button type="button" class="cgpa-mode-pill" id={`${idPrefix}-detailed-pill-quick`}>Quick CGPA</button>
        <button type="button" class="cgpa-mode-pill active" id={`${idPrefix}-detailed-pill-detailed`}>From Subjects</button>
      </div>
    </div>

    <!-- Live Result Summary Card -->
    <div class="geist-card geist-card-floating" style="padding: 1.5rem; margin-bottom: 1.5rem; background: linear-gradient(180deg, var(--color-canvas-elevated) 0%, var(--color-canvas-subtle) 100%);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.25rem; align-items: center;">
        <div>
          <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.25rem;">Cumulative GPA (10.0 Scale)</span>
          <div style="display: flex; align-items: baseline; gap: 0.75rem;">
            <span id={`${idPrefix}-result-cgpa`} class="display-xl" style="font-feature-settings: 'tnum';">8.94</span>
            <span id={`${idPrefix}-standing-badge`} class="badge badge-green">First Class with Distinction</span>
          </div>
          <p style="font-size: 0.875rem; color: var(--color-mute); margin-top: 0.25rem;">
            Approx. Percentage: <strong style="color: var(--color-ink);" id={`${idPrefix}-result-pct`}>84.93%</strong>
            <span style="font-size: 0.75rem;">(AICTE &times; 9.5)</span>
          </p>
        </div>

        <!-- Credits & Points Breakdown -->
        <div class="responsive-col-divider" style="border-left: 1px solid var(--color-hairline); padding-left: 1.25rem;">
          <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
            <span style="color: var(--color-mute);">Total Earned Credits:</span>
            <span id={`${idPrefix}-total-credits`} style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">18.0</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.5rem;">
            <span style="color: var(--color-mute);">Total Quality Points:</span>
            <span id={`${idPrefix}-total-points`} style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">161.0</span>
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-mute); background: var(--color-canvas-subtle); padding: 0.35rem 0.5rem; border-radius: var(--radius-xs); border: 1px solid var(--color-hairline);">
            CGPA = &Sigma;(Grade Point &times; Credits) &divide; &Sigma;Credits
          </div>
        </div>

        <!-- Actions -->
        <div style="display: flex; flex-direction: column; gap: 0.5rem; justify-content: center;">
          <button id={`${idPrefix}-sample-btn`} type="button" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem;">
            Load Realistic Sample
          </button>
          <button id={`${idPrefix}-reset-btn`} type="button" class="btn btn-ghost" style="font-size: 0.8125rem; color: var(--color-mute);">
            Reset to Blank
          </button>
        </div>
      </div>
    </div>

    <!-- Main Subject Table Card -->
    <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem;">
        <div>
          <h3 class="heading-md">Subjects & Credit Hours</h3>
          <p style="font-size: 0.875rem; color: var(--color-mute);">
            Enter subject names, UGC letter grades (or grade points), and course credit weighting.
          </p>
        </div>

        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <button id={`${idPrefix}-add-subject-btn`} type="button" class="btn btn-secondary" style="font-weight: 600; font-size: 0.8125rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add Subject
          </button>
        </div>
      </div>

      <!-- Subjects Table -->
      <div class="mobile-table-card-wrap" style="width: 100%; overflow-x: auto; margin-bottom: 1rem;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 1px solid var(--color-hairline); text-align: left; font-size: 0.8125rem; color: var(--color-mute);">
              <th style="padding: 0.5rem 0.75rem; font-weight: 500;">Subject / Course Title</th>
              <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 170px;">Letter Grade</th>
              <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 120px;">Grade Point</th>
              <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 110px;">Credits</th>
              <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 130px; text-align: right;">Credit Points</th>
              <th style="padding: 0.5rem 0.75rem; width: 44px;"></th>
            </tr>
          </thead>
          <tbody id={`${idPrefix}-tbody`}>
            <!-- Rendered dynamically by script -->
          </tbody>
        </table>
      </div>

      <!-- Footer summary in table -->
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--color-hairline);">
        <button id={`${idPrefix}-add-subject-bottom-btn`} type="button" class="btn btn-secondary" style="font-weight: 600;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Another Subject
        </button>

        <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.8125rem;">
          <span style="color: var(--color-mute);">Total Credits: <strong id={`${idPrefix}-footer-credits`} style="color: var(--color-ink); font-family: var(--font-mono);">0</strong></span>
          <span style="color: var(--color-mute);">Weighted Points: <strong id={`${idPrefix}-footer-points`} style="color: var(--color-ink); font-family: var(--font-mono);">0.0</strong></span>
        </div>
      </div>
    </div>

    <!-- Detailed Calculation Breakdown Card -->
    <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem; background: var(--color-canvas-subtle);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span class="badge badge-blue">Formula Breakdown</span>
          <h4 class="heading-md" style="font-size: 1rem;">Mathematical Step-by-Step Verification</h4>
        </div>
      </div>

      <div id={`${idPrefix}-breakdown-text`} style="font-size: 0.875rem; color: var(--color-body); line-height: 1.6;">
        Enter your subjects and credits above to see the calculation breakdown.
      </div>
    </div>
  </div>
</div>

<style>
  /* Compact Near-Square Cards Grid */
  .cgpa-choice-wrapper {
    margin: 1rem auto 2.5rem auto;
    max-width: 620px;
  }
  .cgpa-choice-header-text {
    text-align: center;
    margin-bottom: 2rem;
  }
  .cgpa-square-cards-grid {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    align-items: stretch;
  }
  .cgpa-square-card {
    flex: 0 1 260px;
    width: 260px;
    height: 260px;
    box-sizing: border-box;
    background: var(--color-canvas-elevated);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    user-select: none;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: var(--shadow-whisper);
  }
  .cgpa-square-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-floating);
  }
  .cgpa-square-card:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .cgpa-card-icon-box {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-subtle);
    border: 1px solid var(--color-hairline);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    flex-shrink: 0;
    transition: border-color var(--transition-fast);
  }
  .cgpa-square-card:hover .cgpa-card-icon-box {
    border-color: var(--color-hairline-strong);
  }
  .cgpa-card-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    line-height: 1.35;
    margin: 0 0 0.45rem 0;
  }
  .cgpa-card-desc {
    font-size: 0.8125rem;
    color: var(--color-mute);
    line-height: 1.45;
    margin: 0 0 1.15rem 0;
    max-width: 220px;
  }
  .cgpa-card-btn-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .cgpa-card-btn {
    pointer-events: none;
    width: 100%;
    max-width: 150px;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .cgpa-square-card:hover .cgpa-card-btn {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
  }

  /* Text link button inside paragraph */
  .cgpa-text-link-btn {
    display: inline;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: inherit;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    cursor: pointer;
  }
  .cgpa-text-link-btn:hover {
    color: var(--color-blue);
  }

  /* Navigation Bar */
  .cgpa-mode-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .cgpa-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-mute);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .cgpa-back-btn:hover {
    color: var(--color-ink);
    background: var(--color-canvas-subtle);
  }
  .cgpa-mode-pills {
    display: inline-flex;
    background: var(--color-canvas-subtle);
    padding: 3px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    gap: 3px;
  }
  .cgpa-mode-pill {
    padding: 0.35rem 0.85rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-mute);
    background: transparent;
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }
  .cgpa-mode-pill:hover {
    color: var(--color-ink);
  }
  .cgpa-mode-pill.active {
    background: var(--color-canvas-elevated);
    color: var(--color-ink);
    font-weight: 600;
    box-shadow: var(--shadow-whisper);
  }

  @media (max-width: 640px) {
