      max-width: 270px;
      height: 270px;
      padding: 1.5rem 1.25rem;
    }
    .cgpa-mode-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .cgpa-mode-pills {
      width: 100%;
      justify-content: center;
    }
    .cgpa-mode-pill {
