      text-align: center;
    }
  }

  /* Quick Semester CGPA Cards (View 2) */
  :global(.quick-sem-card-row .sem-sgpa-input) {
    max-width: 200px;
  }
  :global(.quick-sem-card-row .sem-credits-input) {
    max-width: 220px;
  }

  @media (max-width: 680px) {
    :global(.mobile-card-row.quick-sem-card-row) {
      display: grid !important;
      grid-template-columns: repeat(12, 1fr) !important;
      column-gap: 0.75rem !important;
      row-gap: 0.625rem !important;
      padding: 0.875rem 1rem !important;
      background: var(--color-canvas-subtle) !important;
      border: 1px solid var(--color-hairline) !important;
      border-radius: var(--radius-md) !important;
      margin-bottom: 0.75rem !important;
