---
// src/components/pages/SemesterCgpaPage.astro
import Layout from '../../layouts/Layout.astro';
import SemesterCgpaCalculator from '../SemesterCgpaCalculator.astro';
import { useTranslations, useTranslatedPath, type Lang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const breadcrumbs = [
  { name: t('nav.home'), item: translatePath('/') },
  { name: t('menu.sem_cgpa'), item: translatePath('/semester-cgpa-calculator') }
];

const faqSchema = [
  {
    question: t('semcgpa.faq1_q'),
    answer: t('semcgpa.faq1_a')
  },
  {
    question: t('semcgpa.faq2_q'),
    answer: t('semcgpa.faq2_a')
  },
  {
    question: t('semcgpa.faq3_q'),
    answer: t('semcgpa.faq3_a')
  },
  {
    question: t('semcgpa.faq4_q'),
    answer: t('semcgpa.faq4_a')
  }
];
---

<Layout
  title={t('semcgpa.pageTitle') || t('semcgpa.title')}
  description={t('semcgpa.pageDesc') || t('semcgpa.desc')}
  breadcrumbs={breadcrumbs}
  faqSchema={faqSchema}
  lang={lang}
  softwareSchema={{
    name: t('semcgpa.h1') || t('menu.sem_cgpa'),
    description: t('semcgpa.pageDesc') || t('semcgpa.desc'),
    applicationCategory: "EducationalApplication"
  }}
>
  <div class="container" style="max-width: 960px; padding-top: 2.5rem; padding-bottom: 5rem;">
    <!-- Breadcrumbs -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.8125rem; color: var(--color-mute);">
        <a href={translatePath('/')} style="color: var(--color-mute); text-decoration: none;" data-i18n="nav.home">{t('nav.home')}</a>
        <span style="margin: 0 0.5rem; color: var(--color-hairline);">&gt;</span>
        <span style="color: var(--color-ink); font-weight: 500;" data-i18n="semcgpa.h1">{t('semcgpa.h1')}</span>
      </nav>
      <div style="display: flex; gap: 0.5rem;">
        <a href={translatePath('/indian-sgpa-calculator')} class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          <span data-i18n="menu.isgpa">{t('menu.isgpa')}</span> &rarr;
        </a>
        <a href={translatePath('/target-cgpa-calculator')} class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          <span data-i18n="menu.target_cgpa">{t('menu.target_cgpa')}</span> &rarr;
        </a>
      </div>
    </div>

    <!-- Header Section -->
    <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 1.5rem;">
      <span class="mono-eyebrow" style="color: var(--color-violet); margin-bottom: 0.35rem;" data-i18n="semcgpa.eyebrow">{t('semcgpa.eyebrow')}</span>
      <h1 class="heading-lg" style="color: var(--color-ink); font-size: clamp(1.85rem, 4vw, 2.5rem); letter-spacing: -0.02em; margin-top: 0.25rem;" data-i18n="semcgpa.h1">
        {t('semcgpa.h1')}
      </h1>
      <p style="font-size: 1.05rem; color: var(--color-body); margin-top: 0.75rem; line-height: 1.6; max-width: 780px;" data-i18n="semcgpa.desc">
        {t('semcgpa.desc')}
      </p>
    </header>

    <!-- Interactive Calculator -->
    <section style="margin-bottom: 3rem;">
      <SemesterCgpaCalculator idPrefix="page-semcgpa" lang={lang} />
    </section>

    <!-- Guide & Formula Section -->
    <article class="geist-card" style="padding: 2.25rem 2rem; line-height: 1.75; color: var(--color-body); margin-bottom: 2rem;">
      <h2 class="heading-md" style="color: var(--color-ink); font-size: 1.35rem; margin-bottom: 1rem;" data-i18n="semcgpa.why_heading">
        {t('semcgpa.why_heading')}
      </h2>
      <p style="margin-bottom: 1rem;" data-i18n="semcgpa.why_p1">
        {t('semcgpa.why_p1')}
      </p>
      <div style="background: var(--color-canvas-subtle); padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); font-family: var(--font-mono); font-size: 0.8125rem; margin-bottom: 1rem; color: var(--color-red);" data-i18n="semcgpa.why_incorrect">
        {t('semcgpa.why_incorrect')}
      </div>
      <p style="margin-bottom: 1rem;" data-i18n="semcgpa.why_p2">
        {t('semcgpa.why_p2')}
      </p>
      <p style="margin-bottom: 1.25rem;" data-i18n="semcgpa.why_p3">
        {t('semcgpa.why_p3')}
      </p>
      <div style="background: var(--color-canvas-subtle); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: 1.25rem; color: var(--color-emerald);" data-i18n="semcgpa.why_correct">
        {t('semcgpa.why_correct')}
      </div>
    </article>

    <!-- FAQs -->
    <section class="faq-card" style="margin-bottom: 3rem;">
      <h2 class="heading-md" style="margin-bottom: 1.25rem; color: var(--color-ink);" data-i18n="semcgpa.faq_heading">
        {t('semcgpa.faq_heading')}
      </h2>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <details class="geist-card" style="padding: 1rem 1.25rem; background: var(--color-canvas);">
          <summary style="font-weight: 600; cursor: pointer; color: var(--color-ink);" data-i18n="semcgpa.faq1_q">{t('semcgpa.faq1_q')}</summary>
          <p style="margin-top: 0.75rem; font-size: 0.9375rem; color: var(--color-body); line-height: 1.6;" data-i18n="semcgpa.faq1_a">
            {t('semcgpa.faq1_a')}
          </p>
        </details>
        <details class="geist-card" style="padding: 1rem 1.25rem; background: var(--color-canvas);">
          <summary style="font-weight: 600; cursor: pointer; color: var(--color-ink);" data-i18n="semcgpa.faq2_q">{t('semcgpa.faq2_q')}</summary>
          <p style="margin-top: 0.75rem; font-size: 0.9375rem; color: var(--color-body); line-height: 1.6;" data-i18n="semcgpa.faq2_a">
            {t('semcgpa.faq2_a')}
          </p>
        </details>
        <details class="geist-card" style="padding: 1rem 1.25rem; background: var(--color-canvas);">
          <summary style="font-weight: 600; cursor: pointer; color: var(--color-ink);" data-i18n="semcgpa.faq3_q">{t('semcgpa.faq3_q')}</summary>
          <p style="margin-top: 0.75rem; font-size: 0.9375rem; color: var(--color-body); line-height: 1.6;" data-i18n="semcgpa.faq3_a">
            {t('semcgpa.faq3_a')}
          </p>
        </details>
        <details class="geist-card" style="padding: 1rem 1.25rem; background: var(--color-canvas);">
          <summary style="font-weight: 600; cursor: pointer; color: var(--color-ink);" data-i18n="semcgpa.faq4_q">{t('semcgpa.faq4_q')}</summary>
          <p style="margin-top: 0.75rem; font-size: 0.9375rem; color: var(--color-body); line-height: 1.6;" data-i18n="semcgpa.faq4_a">
            {t('semcgpa.faq4_a')}
          </p>
        </details>
      </div>
    </section>
  </div>
</Layout>
