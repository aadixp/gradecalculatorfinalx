---
// src/components/pages/IndianSgpaPage.astro
import Layout from '../../layouts/Layout.astro';
import IndianSgpaCalculator from '../IndianSgpaCalculator.astro';
import { useTranslations, useTranslatedPath, type Lang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const breadcrumbs = [
  { name: t('nav.home'), item: translatePath('/') },
  { name: t('menu.isgpa'), item: translatePath('/indian-sgpa-calculator') }
];

const faqSchema = [
  {
    question: t('isgpa.faq1_q'),
    answer: t('isgpa.faq1_a')
  },
  {
    question: t('isgpa.faq2_q'),
    answer: t('isgpa.faq2_a')
  },
  {
    question: t('isgpa.faq3_q'),
    answer: t('isgpa.faq3_a')
  },
  {
    question: t('isgpa.faq4_q'),
    answer: t('isgpa.faq4_a')
  }
];
---

<Layout
  title={t('isgpa.pageTitle') || t('isgpa.title')}
  description={t('isgpa.pageDesc') || t('isgpa.desc')}
  breadcrumbs={breadcrumbs}
  faqSchema={faqSchema}
  lang={lang}
  softwareSchema={{
    name: t('isgpa.h1') || t('menu.isgpa'),
    description: t('isgpa.pageDesc') || t('isgpa.desc'),
    applicationCategory: "EducationalApplication"
  }}
>
  <div class="container" style="max-width: 960px; padding-top: 2.5rem; padding-bottom: 5rem;">
    <!-- Breadcrumbs -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.8125rem; color: var(--color-mute);">
        <a href={translatePath('/')} style="color: var(--color-mute); text-decoration: none;" data-i18n="nav.home">{t('nav.home')}</a>
        <span style="margin: 0 0.5rem; color: var(--color-hairline);">&gt;</span>
        <span style="color: var(--color-ink); font-weight: 500;" data-i18n="isgpa.h1">{t('isgpa.h1')}</span>
      </nav>
      <div style="display: flex; gap: 0.5rem;">
        <a href={translatePath('/indian-cgpa-calculator')} class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          <span data-i18n="menu.icgpa">{t('menu.icgpa')}</span> &rarr;
        </a>
        <a href={translatePath('/semester-cgpa-calculator')} class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          <span data-i18n="menu.sem_cgpa">{t('menu.sem_cgpa')}</span> &rarr;
        </a>
      </div>
    </div>

    <!-- Header Section -->
    <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 1.5rem;">
      <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.35rem;" data-i18n="isgpa.eyebrow">{t('isgpa.eyebrow')}</span>
      <h1 class="heading-lg" style="color: var(--color-ink); font-size: clamp(1.85rem, 4vw, 2.5rem); letter-spacing: -0.02em; margin-top: 0.25rem;" data-i18n="isgpa.h1">
        {t('isgpa.h1')}
      </h1>
      <p style="font-size: 1.05rem; color: var(--color-body); margin-top: 0.75rem; line-height: 1.6; max-width: 780px;" data-i18n="isgpa.desc">
        {t('isgpa.desc')}
      </p>
    </header>

    <!-- Interactive Calculator -->
    <section style="margin-bottom: 3rem;">
      <IndianSgpaCalculator idPrefix="page-sgpa" lang={lang} />
    </section>

    <!-- Guide & Formula Section -->
    <article class="geist-card" style="padding: 2.25rem 2rem; line-height: 1.75; color: var(--color-body); margin-bottom: 2rem;">
      <h2 class="heading-md" style="color: var(--color-ink); font-size: 1.35rem; margin-bottom: 1rem;" data-i18n="isgpa.guide_heading">
        {t('isgpa.guide_heading')}
      </h2>
      <p style="margin-bottom: 1rem;" data-i18n="isgpa.guide_p1">
        {t('isgpa.guide_p1')}
      </p>

      <h3 class="heading-md" style="font-size: 1.15rem; color: var(--color-ink); margin-bottom: 0.75rem;" data-i18n="isgpa.formula_heading">
        {t('isgpa.formula_heading')}
      </h3>
      <div style="background: var(--color-canvas-subtle); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: 1.25rem;">
        SGPA (S<sub>i</sub>) = &Sigma;(C<sub>i</sub> &times; G<sub>i</sub>) &divide; &Sigma;C<sub>i</sub>
      </div>
      <p style="margin-bottom: 1rem;" data-i18n="isgpa.formula_desc">
        {t('isgpa.formula_desc')}
      </p>
      <ul style="padding-left: 1.25rem; margin-bottom: 1.25rem;">
        <li><strong data-i18n="isgpa.c1_label">{t('isgpa.c1_label')}</strong></li>
        <li><strong data-i18n="isgpa.g1_label">{t('isgpa.g1_label')}</strong></li>
      </ul>

      <h3 class="heading-md" style="font-size: 1.15rem; color: var(--color-ink); margin-top: 1.5rem; margin-bottom: 0.75rem;">
        Standard UGC 10-Point CBCS Grading Scale
      </h3>
      <p style="margin-bottom: 1rem; font-size: 0.9375rem;">
        The University Grants Commission (UGC) Choice Based Credit System (CBCS) prescribes the following standard 10-point letter grade and grade point structure:
      </p>
      <div style="overflow-x: auto; margin-bottom: 1.5rem;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem; text-align: left;">
          <thead>
            <tr style="border-bottom: 1px solid var(--color-hairline); color: var(--color-ink);">
              <th style="padding: 0.5rem 0.75rem;">Letter Grade</th>
              <th style="padding: 0.5rem 0.75rem;">Grade Point (10.0)</th>
              <th style="padding: 0.5rem 0.75rem;">Marks Percentage Range</th>
              <th style="padding: 0.5rem 0.75rem;">Performance Description</th>
            </tr>
          </thead>
          <tbody style="font-family: var(--font-mono); font-size: 0.8125rem;">
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);"><td style="padding: 0.45rem 0.75rem; font-weight: 600; color: var(--color-ink);">O</td><td style="padding: 0.45rem 0.75rem;">10</td><td style="padding: 0.45rem 0.75rem;">90% – 100%</td><td style="padding: 0.45rem 0.75rem; font-family: var(--font-sans); color: var(--color-green); font-weight: 600;">Outstanding</td></tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);"><td style="padding: 0.45rem 0.75rem; font-weight: 600; color: var(--color-ink);">A+</td><td style="padding: 0.45rem 0.75rem;">9</td><td style="padding: 0.45rem 0.75rem;">80% – 89%</td><td style="padding: 0.45rem 0.75rem; font-family: var(--font-sans); color: var(--color-green);">Excellent</td></tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);"><td style="padding: 0.45rem 0.75rem; font-weight: 600; color: var(--color-ink);">A</td><td style="padding: 0.45rem 0.75rem;">8</td><td style="padding: 0.45rem 0.75rem;">70% – 79%</td><td style="padding: 0.45rem 0.75rem; font-family: var(--font-sans); color: var(--color-blue);">Very Good</td></tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);"><td style="padding: 0.45rem 0.75rem; font-weight: 600; color: var(--color-ink);">B+</td><td style="padding: 0.45rem 0.75rem;">7</td><td style="padding: 0.45rem 0.75rem;">60% – 69%</td><td style="padding: 0.45rem 0.75rem; font-family: var(--font-sans); color: var(--color-blue);">Good (First Class Cutoff)</td></tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);"><td style="padding: 0.45rem 0.75rem; font-weight: 600; color: var(--color-ink);">B</td><td style="padding: 0.45rem 0.75rem;">6</td><td style="padding: 0.45rem 0.75rem;">55% – 59%</td><td style="padding: 0.45rem 0.75rem; font-family: var(--font-sans); color: var(--color-amber);">Above Average</td></tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);"><td style="padding: 0.45rem 0.75rem; font-weight: 600; color: var(--color-ink);">C</td><td style="padding: 0.45rem 0.75rem;">5</td><td style="padding: 0.45rem 0.75rem;">50% – 54%</td><td style="padding: 0.45rem 0.75rem; font-family: var(--font-sans); color: var(--color-amber);">Average</td></tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);"><td style="padding: 0.45rem 0.75rem; font-weight: 600; color: var(--color-ink);">P</td><td style="padding: 0.45rem 0.75rem;">4</td><td style="padding: 0.45rem 0.75rem;">40% – 49%</td><td style="padding: 0.45rem 0.75rem; font-family: var(--font-sans); color: var(--color-mute);">Pass</td></tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);"><td style="padding: 0.45rem 0.75rem; font-weight: 600; color: var(--color-red);">F</td><td style="padding: 0.45rem 0.75rem;">0</td><td style="padding: 0.45rem 0.75rem;">Below 40%</td><td style="padding: 0.45rem 0.75rem; font-family: var(--font-sans); color: var(--color-red);">Fail (Arrear / Backlog)</td></tr>
            <tr><td style="padding: 0.45rem 0.75rem; font-weight: 600; color: var(--color-red);">Ab</td><td style="padding: 0.45rem 0.75rem;">0</td><td style="padding: 0.45rem 0.75rem;">--</td><td style="padding: 0.45rem 0.75rem; font-family: var(--font-sans); color: var(--color-red);">Absent</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="heading-md" style="font-size: 1.15rem; color: var(--color-ink); margin-bottom: 0.75rem;" data-i18n="isgpa.impact_heading">
        {t('isgpa.impact_heading')}
      </h3>
      <p style="margin-bottom: 1rem;" data-i18n="isgpa.impact_p1">
        {t('isgpa.impact_p1')}
      </p>
      <div style="background: var(--color-canvas-subtle); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: 1.25rem;" data-i18n="isgpa.impact_formula">
        {t('isgpa.impact_formula')}
      </div>
      <p data-i18n="isgpa.impact_p2">
        {t('isgpa.impact_p2')}
      </p>
    </article>

    <!-- FAQs -->
    <section class="faq-card" style="margin-bottom: 3rem;">
      <h2 class="heading-md" style="margin-bottom: 1.25rem; color: var(--color-ink);" data-i18n="isgpa.faq_heading">
        {t('isgpa.faq_heading')}
      </h2>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div class="faq-item">
          <div class="faq-question" data-i18n="isgpa.faq1_q">{t('isgpa.faq1_q')}</div>
          <div class="faq-answer" data-i18n="isgpa.faq1_a">
            {t('isgpa.faq1_a')}
          </div>
        </div>
        <div class="faq-item">
          <div class="faq-question" data-i18n="isgpa.faq2_q">{t('isgpa.faq2_q')}</div>
          <div class="faq-answer" data-i18n="isgpa.faq2_a">
            {t('isgpa.faq2_a')}
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question" data-i18n="isgpa.faq3_q">{t('isgpa.faq3_q')}</div>
          <div class="faq-answer" data-i18n="isgpa.faq3_a">
            {t('isgpa.faq3_a')}
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question" data-i18n="isgpa.faq4_q">{t('isgpa.faq4_q')}</div>
          <div class="faq-answer" data-i18n="isgpa.faq4_a">
            {t('isgpa.faq4_a')}
          </div>
        </div>
      </div>
    </section>

    <!-- Related Links -->
    <section>
      <h3 class="heading-md" style="margin-bottom: 1rem; color: var(--color-ink);" data-i18n="isgpa.related_heading">{t('isgpa.related_heading')}</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <a href={translatePath('/semester-cgpa-calculator')} class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;" data-i18n="menu.sem_cgpa">{t('menu.sem_cgpa')}</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;" data-i18n="semcgpa.desc">{t('semcgpa.desc')}</p>
        </a>
        <a href={translatePath('/indian-cgpa-calculator')} class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;" data-i18n="menu.icgpa">{t('menu.icgpa')}</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;" data-i18n="icgpa.desc">{t('icgpa.desc')}</p>
        </a>
        <a href={translatePath('/cgpa-to-percentage')} class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;" data-i18n="menu.cgpato">{t('menu.cgpato')}</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;" data-i18n="cgpato.desc">{t('cgpato.desc')}</p>
        </a>
        <a href={translatePath('/target-cgpa-calculator')} class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;" data-i18n="menu.target_cgpa">{t('menu.target_cgpa')}</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;" data-i18n="targetcgpa.desc">{t('targetcgpa.desc')}</p>
        </a>
      </div>
    </section>
  </div>
</Layout>
