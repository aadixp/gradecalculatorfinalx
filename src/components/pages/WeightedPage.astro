---
// src/components/pages/WeightedPage.astro
import Layout from '../../layouts/Layout.astro';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const breadcrumbs = [
  { name: t('page.home'), item: translatePath('/') },
  { name: t('wgc.h1'), item: translatePath('/weighted-grade-calculator') }
];
---

<Layout
  title={t('wgc.pageTitle')}
  description={t('wgc.pageDesc')}
  lang={lang}
  breadcrumbs={breadcrumbs}
  softwareSchema={{
    name: t('wgc.h1'),
    description: t('wgc.pageDesc'),
    applicationCategory: "EducationalApplication"
  }}
>
  <div class="container" style="max-width: 960px; padding-top: 2.5rem; padding-bottom: 5rem;">
    <!-- Breadcrumbs -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.8125rem; color: var(--color-mute);">
        <a href={translatePath('/')} style="color: var(--color-mute); text-decoration: none;" data-i18n="page.home">{t('page.home')}</a>
        <span style="margin: 0 0.5rem; color: var(--color-hairline);">&gt;</span>
        <span style="color: var(--color-ink); font-weight: 500;" data-i18n="wgc.h1">{t('wgc.h1')}</span>
      </nav>
      <div style="display: flex; gap: 0.5rem;">
        <a href={translatePath('/final-exam-calculator')} class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;" data-i18n="fec.h1">
          {t('fec.h1')} &rarr;
        </a>
        <a href={translatePath('/gpa-calculator')} class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;" data-i18n="gpa.h1">
          {t('gpa.h1')} &rarr;
        </a>
      </div>
    </div>

    <!-- Header Section -->
    <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 1.5rem;">
      <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.35rem;" data-i18n="wgc.eyebrow">{t('wgc.eyebrow')}</span>
      <h1 class="heading-lg" style="color: var(--color-ink); font-size: clamp(1.85rem, 4vw, 2.5rem); letter-spacing: -0.02em; margin-top: 0.25rem;" data-i18n="wgc.h1">
        {t('wgc.h1')}
      </h1>
      <p style="font-size: 1.05rem; color: var(--color-body); margin-top: 0.75rem; line-height: 1.6; max-width: 780px;" data-i18n="wgc.lead">
        {t('wgc.lead')}
      </p>
    </header>

    <!-- Calculator Live Results Showcase Card -->
    <div class="geist-card geist-card-floating" style="padding: 1.5rem; margin-bottom: 1.5rem; background: linear-gradient(180deg, var(--color-canvas-elevated) 0%, var(--color-canvas-subtle) 100%);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; align-items: center;">
        <div>
          <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.25rem;" data-i18n="wgc.liveStanding">{t('wgc.liveStanding')}</span>
          <div style="display: flex; align-items: baseline; gap: 0.75rem;">
            <span id="wgc-grade-pct" class="display-xl" style="font-feature-settings: 'tnum'; color: var(--color-ink);">88.40%</span>
            <span id="wgc-grade-letter" class="badge badge-blue" style="font-size: 1rem; padding: 0.25rem 0.75rem;">B+</span>
          </div>
          <p style="font-size: 0.875rem; color: var(--color-mute); margin-top: 0.25rem;">
            <span data-i18n="wgc.equivGpa">{t('wgc.equivGpa')}</span> <strong style="color: var(--color-ink);" id="wgc-gpa-equiv">3.30</strong>
          </p>
        </div>

        <div class="responsive-col-divider" style="border-left: 1px solid var(--color-hairline); padding-left: 1.25rem;">
          <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
            <span style="color: var(--color-mute);" data-i18n="wgc.weightAccounted">{t('wgc.weightAccounted')}</span>
            <span id="wgc-weight-label" style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">100%</span>
          </div>
          <div style="width: 100%; height: 8px; background: var(--color-canvas-hover); border-radius: var(--radius-pill); overflow: hidden; margin-bottom: 0.5rem; position: relative;">
            <div id="wgc-progress-bar" style="width: 100%; height: 100%; background: var(--color-emerald); border-radius: var(--radius-pill); transition: width 0.3s ease;"></div>
          </div>
          <div id="wgc-weight-msg" style="font-size: 0.75rem; color: var(--color-emerald);">
            Weights sum to 100%
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.5rem; justify-content: center;">
          <button id="wgc-normalize-btn" type="button" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; display: none;" data-i18n="wgc.normalizeBtn">
            {t('wgc.normalizeBtn')}
          </button>
          <a href={translatePath('/final-exam-calculator')} class="btn btn-ghost" style="font-size: 0.8125rem; text-decoration: none; text-align: center;" data-i18n="wgc.planFinalBtn">
            {t('wgc.planFinalBtn')}
          </a>
        </div>
      </div>
    </div>

    <!-- Main Interactive Table Card -->
    <div class="geist-card" style="padding: 1.5rem; margin-bottom: 2.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem;">
        <div>
          <h3 class="heading-md" style="font-size: 1.15rem; color: var(--color-ink);" data-i18n="wgc.tableHeading">{t('wgc.tableHeading')}</h3>
          <p style="font-size: 0.875rem; color: var(--color-mute);" data-i18n="wgc.tableSubheading">{t('wgc.tableSubheading')}</p>
        </div>
        <button id="wgc-reset-btn" type="button" class="btn btn-ghost" style="font-size: 0.8125rem; color: var(--color-mute);" data-i18n="wgc.resetBtn">
          {t('wgc.resetBtn')}
        </button>
      </div>

      <div class="mobile-table-card-wrap" style="overflow-x: auto;">
        <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
          <thead>
            <tr style="border-bottom: 1px solid var(--color-hairline); text-align: left;">
              <th style="padding: 0.6rem 0.5rem;" data-i18n="wgc.colAssign">{t('wgc.colAssign')}</th>
              <th style="padding: 0.6rem 0.5rem; width: 110px;" data-i18n="wgc.colScore">{t('wgc.colScore')}</th>
              <th style="padding: 0.6rem 0.5rem; width: 110px;" data-i18n="wgc.colMax">{t('wgc.colMax')}</th>
              <th style="padding: 0.6rem 0.5rem; width: 100px;" data-i18n="wgc.colWeight">{t('wgc.colWeight')}</th>
              <th style="padding: 0.6rem 0.5rem; width: 90px; text-align: right;" data-i18n="wgc.colCalc">{t('wgc.colCalc')}</th>
              <th style="padding: 0.6rem 0.5rem; width: 40px;"></th>
            </tr>
          </thead>
          <tbody id="wgc-tbody">
            <tr class="mobile-card-row" style="border-bottom: 1px solid var(--color-hairline);">
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colAssign')} #1</span>
                <input type="text" class="form-input row-name" data-index="0" value="Homework Assignments" placeholder="e.g. Homework" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colScore')}</span>
                <input type="number" step="0.1" class="form-input form-input-mono row-score" data-index="0" value="92" placeholder="92" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colMax')}</span>
                <input type="number" step="0.1" class="form-input form-input-mono row-max" data-index="0" value="100" placeholder="100" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colWeight')}</span>
                <input type="number" step="0.5" class="form-input form-input-mono row-weight" data-index="0" value="20" placeholder="20" />
              </td>
              <td style="padding: 0.6rem 0.5rem; text-align: right; font-family: var(--font-mono); font-weight: 600; color: var(--color-ink);">
                <span class="mobile-input-label">{t('wgc.colCalc')}</span>
                <span>18.40%</span>
              </td>
              <td style="padding: 0.6rem 0.5rem; text-align: right;">
                <button type="button" class="btn btn-ghost btn-icon delete-row-btn" data-index="0" title="Delete">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
              </td>
            </tr>
            <tr class="mobile-card-row" style="border-bottom: 1px solid var(--color-hairline);">
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colAssign')} #2</span>
                <input type="text" class="form-input row-name" data-index="1" value="Midterm Exam 1" placeholder="e.g. Midterm 1" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colScore')}</span>
                <input type="number" step="0.1" class="form-input form-input-mono row-score" data-index="1" value="85" placeholder="85" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colMax')}</span>
                <input type="number" step="0.1" class="form-input form-input-mono row-max" data-index="1" value="100" placeholder="100" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colWeight')}</span>
                <input type="number" step="0.5" class="form-input form-input-mono row-weight" data-index="1" value="25" placeholder="25" />
              </td>
              <td style="padding: 0.6rem 0.5rem; text-align: right; font-family: var(--font-mono); font-weight: 600; color: var(--color-ink);">
                <span class="mobile-input-label">{t('wgc.colCalc')}</span>
                <span>21.25%</span>
              </td>
              <td style="padding: 0.6rem 0.5rem; text-align: right;">
                <button type="button" class="btn btn-ghost btn-icon delete-row-btn" data-index="1" title="Delete">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
              </td>
            </tr>
            <tr class="mobile-card-row" style="border-bottom: 1px solid var(--color-hairline);">
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colAssign')} #3</span>
                <input type="text" class="form-input row-name" data-index="2" value="Midterm Exam 2" placeholder="e.g. Midterm 2" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colScore')}</span>
                <input type="number" step="0.1" class="form-input form-input-mono row-score" data-index="2" value="78" placeholder="78" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colMax')}</span>
                <input type="number" step="0.1" class="form-input form-input-mono row-max" data-index="2" value="100" placeholder="100" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colWeight')}</span>
                <input type="number" step="0.5" class="form-input form-input-mono row-weight" data-index="2" value="25" placeholder="25" />
              </td>
              <td style="padding: 0.6rem 0.5rem; text-align: right; font-family: var(--font-mono); font-weight: 600; color: var(--color-ink);">
                <span class="mobile-input-label">{t('wgc.colCalc')}</span>
                <span>19.50%</span>
              </td>
              <td style="padding: 0.6rem 0.5rem; text-align: right;">
                <button type="button" class="btn btn-ghost btn-icon delete-row-btn" data-index="2" title="Delete">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
              </td>
            </tr>
            <tr class="mobile-card-row" style="border-bottom: 1px solid var(--color-hairline);">
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colAssign')} #4</span>
                <input type="text" class="form-input row-name" data-index="3" value="Weekly Quizzes" placeholder="e.g. Quizzes" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colScore')}</span>
                <input type="number" step="0.1" class="form-input form-input-mono row-score" data-index="3" value="95" placeholder="95" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colMax')}</span>
                <input type="number" step="0.1" class="form-input form-input-mono row-max" data-index="3" value="100" placeholder="100" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colWeight')}</span>
                <input type="number" step="0.5" class="form-input form-input-mono row-weight" data-index="3" value="15" placeholder="15" />
              </td>
              <td style="padding: 0.6rem 0.5rem; text-align: right; font-family: var(--font-mono); font-weight: 600; color: var(--color-ink);">
                <span class="mobile-input-label">{t('wgc.colCalc')}</span>
                <span>14.25%</span>
              </td>
              <td style="padding: 0.6rem 0.5rem; text-align: right;">
                <button type="button" class="btn btn-ghost btn-icon delete-row-btn" data-index="3" title="Delete">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
              </td>
            </tr>
            <tr class="mobile-card-row" style="border-bottom: 1px solid var(--color-hairline);">
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colAssign')} #5</span>
                <input type="text" class="form-input row-name" data-index="4" value="Class Participation" placeholder="e.g. Participation" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colScore')}</span>
                <input type="number" step="0.1" class="form-input form-input-mono row-score" data-index="4" value="100" placeholder="100" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colMax')}</span>
                <input type="number" step="0.1" class="form-input form-input-mono row-max" data-index="4" value="100" placeholder="100" />
              </td>
              <td style="padding: 0.6rem 0.5rem;">
                <span class="mobile-input-label">{t('wgc.colWeight')}</span>
                <input type="number" step="0.5" class="form-input form-input-mono row-weight" data-index="4" value="15" placeholder="15" />
              </td>
              <td style="padding: 0.6rem 0.5rem; text-align: right; font-family: var(--font-mono); font-weight: 600; color: var(--color-ink);">
                <span class="mobile-input-label">{t('wgc.colCalc')}</span>
                <span>15.00%</span>
              </td>
              <td style="padding: 0.6rem 0.5rem; text-align: right;">
                <button type="button" class="btn btn-ghost btn-icon delete-row-btn" data-index="4" title="Delete">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div style="margin-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
        <button id="wgc-add-row-btn" type="button" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; display: inline-flex; align-items: center; gap: 0.4rem;" data-i18n="wgc.addRowBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>{t('wgc.addRowBtn')}</span>
        </button>
      </div>
    </div>

    <!-- Guide & Formula Section -->
    <article class="geist-card" style="padding: 2.25rem 2rem; line-height: 1.75; color: var(--color-body); margin-bottom: 2rem;">
      <h2 class="heading-md" style="color: var(--color-ink); font-size: 1.35rem; margin-bottom: 1rem;" data-i18n="wgc.howToTitle">
        {t('wgc.howToTitle')}
      </h2>
      <p style="margin-bottom: 1rem;" data-i18n="wgc.howToP1">
        {t('wgc.howToP1')}
      </p>
      <div style="background: var(--color-canvas-subtle); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: 1.25rem; color: var(--color-blue);" data-i18n="wgc.howToFormula">
        {t('wgc.howToFormula')}
      </div>

      <h3 class="heading-md" style="font-size: 1.15rem; color: var(--color-ink); margin-bottom: 0.75rem;" data-i18n="wgc.midsemTitle">
        {t('wgc.midsemTitle')}
      </h3>
      <p style="margin-bottom: 1rem;" data-i18n="wgc.midsemP1">
        {t('wgc.midsemP1')}
      </p>
    </article>

    <!-- Related Links -->
    <section>
      <h3 class="heading-md" style="margin-bottom: 1rem; color: var(--color-ink);" data-i18n="page.relatedCalculators">{t('page.relatedCalculators')}</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <a href={translatePath('/final-exam-calculator')} class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;" data-i18n="fec.h1">{t('fec.h1')}</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;" data-i18n="fec.lead">{t('fec.lead')}</p>
        </a>
        <a href={translatePath('/gpa-calculator')} class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;" data-i18n="gpa.h1">{t('gpa.h1')}</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;" data-i18n="gpa.lead">{t('gpa.lead')}</p>
        </a>
        <a href={translatePath('/target-gpa-calculator')} class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;" data-i18n="targetgpa.h1">{t('targetgpa.h1')}</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;" data-i18n="targetgpa.lead">{t('targetgpa.lead')}</p>
        </a>
      </div>
    </section>
  </div>

  <script>
    interface RowData {
      name: string;
      score: number;
      max: number;
      weight: number;
    }

    const defaultRows: RowData[] = [
      { name: 'Homework Assignments', score: 92, max: 100, weight: 20 },
      { name: 'Midterm Exam 1', score: 85, max: 100, weight: 25 },
      { name: 'Midterm Exam 2', score: 78, max: 100, weight: 25 },
      { name: 'Weekly Quizzes', score: 95, max: 100, weight: 15 },
      { name: 'Class Participation', score: 100, max: 100, weight: 15 }
    ];

    let rows: RowData[] = JSON.parse(JSON.stringify(defaultRows));

    function getLetterAndGpa(pct: number): { letter: string; gpa: string } {
      if (pct >= 93) return { letter: 'A', gpa: '4.00' };
      if (pct >= 90) return { letter: 'A-', gpa: '3.70' };
      if (pct >= 87) return { letter: 'B+', gpa: '3.30' };
      if (pct >= 83) return { letter: 'B', gpa: '3.00' };
      if (pct >= 80) return { letter: 'B-', gpa: '2.70' };
      if (pct >= 77) return { letter: 'C+', gpa: '2.30' };
      if (pct >= 73) return { letter: 'C', gpa: '2.00' };
      if (pct >= 70) return { letter: 'C-', gpa: '1.70' };
      if (pct >= 67) return { letter: 'D+', gpa: '1.30' };
      if (pct >= 60) return { letter: 'D', gpa: '1.00' };
      return { letter: 'F', gpa: '0.00' };
    }

    function renderTable() {
      const tbody = document.getElementById('wgc-tbody');
      if (!tbody) return;
      tbody.innerHTML = '';

      rows.forEach((r, idx) => {
        const tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid var(--color-hairline-soft)';
        const pctEarned = r.max > 0 ? (r.score / r.max) * 100 : 0;

        tr.innerHTML = `
          <td style="padding: 0.5rem;">
            <input type="text" class="form-input row-name" data-idx="${idx}" value="${r.name}" style="width: 100%; padding: 0.35rem 0.5rem; font-size: 0.8125rem;" />
          </td>
          <td style="padding: 0.5rem;">
            <input type="number" class="form-input form-input-mono row-score" data-idx="${idx}" value="${r.score}" min="0" step="0.5" style="width: 100%; padding: 0.35rem 0.5rem; font-size: 0.8125rem;" />
          </td>
          <td style="padding: 0.5rem;">
            <input type="number" class="form-input form-input-mono row-max" data-idx="${idx}" value="${r.max}" min="1" step="0.5" style="width: 100%; padding: 0.35rem 0.5rem; font-size: 0.8125rem;" />
          </td>
          <td style="padding: 0.5rem;">
            <input type="number" class="form-input form-input-mono row-weight" data-idx="${idx}" value="${r.weight}" min="0" step="0.5" style="width: 100%; padding: 0.35rem 0.5rem; font-size: 0.8125rem;" />
          </td>
          <td style="padding: 0.5rem; text-align: right; font-family: var(--font-mono); font-weight: 600; color: var(--color-ink);">
            ${pctEarned.toFixed(1)}%
          </td>
          <td style="padding: 0.5rem; text-align: center;">
            <button type="button" class="btn-remove-row" data-idx="${idx}" style="background: none; border: none; cursor: pointer; color: var(--color-mute); font-size: 1.1rem; line-height: 1;" title="Remove row">&times;</button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      attachRowEvents();
      recalc();
    }

    function attachRowEvents() {
      document.querySelectorAll('.row-name').forEach(inp => {
        inp.addEventListener('input', (e) => {
          const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
          rows[idx].name = (e.target as HTMLInputElement).value;
        });
      });
      document.querySelectorAll('.row-score').forEach(inp => {
        inp.addEventListener('input', (e) => {
          const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
          rows[idx].score = parseFloat((e.target as HTMLInputElement).value) || 0;
          recalc();
        });
      });
      document.querySelectorAll('.row-max').forEach(inp => {
        inp.addEventListener('input', (e) => {
          const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
          rows[idx].max = parseFloat((e.target as HTMLInputElement).value) || 100;
          recalc();
        });
      });
      document.querySelectorAll('.row-weight').forEach(inp => {
        inp.addEventListener('input', (e) => {
          const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
          rows[idx].weight = parseFloat((e.target as HTMLInputElement).value) || 0;
          recalc();
        });
      });
      document.querySelectorAll('.btn-remove-row').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
          if (rows.length > 1) {
            rows.splice(idx, 1);
            renderTable();
          }
        });
      });
    }

    function recalc() {
      let totalWeight = 0;
      let weightedSum = 0;

      rows.forEach(r => {
        if (r.max > 0 && r.weight > 0) {
          totalWeight += r.weight;
          weightedSum += (r.score / r.max) * 100 * r.weight;
        }
      });

      const finalPct = totalWeight > 0 ? weightedSum / totalWeight : 0;
      const { letter, gpa } = getLetterAndGpa(finalPct);

      const gradePct = document.getElementById('wgc-grade-pct');
      const gradeLetter = document.getElementById('wgc-grade-letter');
      const gpaVal = document.getElementById('wgc-gpa-equiv');
      const weightLabel = document.getElementById('wgc-weight-label');
      const progressBar = document.getElementById('wgc-progress-bar');
      const weightMsg = document.getElementById('wgc-weight-msg');

      if (gradePct) gradePct.textContent = `${finalPct.toFixed(2)}%`;
      if (gradeLetter) gradeLetter.textContent = letter;
      if (gpaVal) gpaVal.textContent = gpa;
      if (weightLabel) weightLabel.textContent = `${totalWeight.toFixed(1)}%`;
      if (progressBar) {
        const p = Math.min(totalWeight, 100);
        progressBar.style.width = `${p}%`;
        progressBar.style.backgroundColor = totalWeight === 100 ? 'var(--color-emerald)' : totalWeight > 100 ? 'var(--color-amber)' : 'var(--color-blue)';
      }
      if (weightMsg) {
        if (totalWeight === 100) {
          weightMsg.textContent = '100% of course weight accounted for. Complete!';
          weightMsg.style.color = 'var(--color-emerald)';
        } else if (totalWeight > 100) {
          weightMsg.textContent = `Weights exceed 100% (currently ${totalWeight.toFixed(1)}%)`;
          weightMsg.style.color = 'var(--color-amber)';
        } else {
          weightMsg.textContent = `Auto-normalized: ${totalWeight.toFixed(1)}% accounted for`;
          weightMsg.style.color = 'var(--color-mute)';
        }
      }
    }

    renderTable();

    document.getElementById('wgc-add-row-btn')?.addEventListener('click', () => {
      rows.push({
        name: `Assignment ${rows.length + 1}`,
        score: 85,
        max: 100,
        weight: 10
      });
      renderTable();
    });

    document.getElementById('wgc-reset-btn')?.addEventListener('click', () => {
      rows = JSON.parse(JSON.stringify(defaultRows));
      renderTable();
    });

    document.getElementById('wgc-normalize-btn')?.addEventListener('click', () => {
      let currentTotal = rows.reduce((acc, r) => acc + r.weight, 0);
      if (currentTotal > 0) {
        rows.forEach(r => {
          r.weight = Math.round((r.weight / currentTotal) * 1000) / 10;
        });
        renderTable();
      }
    });
  </script>
</Layout>
