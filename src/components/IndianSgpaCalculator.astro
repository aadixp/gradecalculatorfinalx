---
// src/components/IndianSgpaCalculator.astro
interface Props {
  idPrefix?: string;
  lang?: string;
}
const { idPrefix = 'sgpa' } = Astro.props;
---

<div id={`${idPrefix}-calculator-panel`} class="calc-component-root">
  <!-- VIEW 1: Initial Option Selector (Two Compact Square Cards) -->
  <div id={`${idPrefix}-view-selector`} class="sgpa-view-container">
    <div class="sgpa-choice-wrapper">
      <div class="sgpa-choice-header-text">
        <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.35rem; display: inline-block;">INDIAN UNIVERSITY 10-POINT CBCS GRADING SYSTEM</span>
        <h2 class="heading-lg" style="font-size: clamp(1.35rem, 3vw, 1.75rem); letter-spacing: -0.02em; color: var(--color-ink); margin-bottom: 0.4rem;">
          Choose SGPA Calculation Method
        </h2>
        <p style="font-size: 0.9375rem; color: var(--color-mute); line-height: 1.5; margin: 0 auto; max-width: 520px;">
          Select how you would like to calculate your Semester Grade Point Average (SGPA):
        </p>
      </div>

      <!-- Two compact near-square cards side by side on desktop, stacked on mobile -->
      <div class="sgpa-square-cards-grid">
        <!-- Option 1: Quick SGPA Calculator -->
        <div class="sgpa-square-card" id={`${idPrefix}-card-quick`} role="button" tabindex="0" aria-label="Open Quick SGPA Calculator">
          <div class="sgpa-card-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <h3 class="sgpa-card-title">Quick SGPA Calculator</h3>
          <p class="sgpa-card-desc">
            Calculate your SGPA quickly by entering your subject credits and grade points for a single semester.
          </p>
          <div class="sgpa-card-btn-wrap">
            <button type="button" class="btn btn-secondary btn-sm sgpa-card-btn" id={`${idPrefix}-btn-choose-quick`}>
              Select &rarr;
            </button>
          </div>
        </div>

        <!-- Option 2: Calculate SGPA from Subjects -->
        <div class="sgpa-square-card" id={`${idPrefix}-card-detailed`} role="button" tabindex="0" aria-label="Open Calculate SGPA from Subjects">
          <div class="sgpa-card-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h3 class="sgpa-card-title">Calculate SGPA from Subjects</h3>
          <p class="sgpa-card-desc">
            Calculate your SGPA from individual subject details, UGC letter grades, grade points, and credits for a detailed calculation.
          </p>
          <div class="sgpa-card-btn-wrap">
            <button type="button" class="btn btn-secondary btn-sm sgpa-card-btn" id={`${idPrefix}-btn-choose-detailed`}>
              Select &rarr;
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- VIEW 2: Quick SGPA Calculator -->
  <div id={`${idPrefix}-view-quick`} class="sgpa-view-container" style="display: none;">
    <!-- Navigation Bar -->
    <div class="sgpa-mode-bar">
      <button type="button" class="btn btn-ghost btn-sm sgpa-back-btn" id={`${idPrefix}-quick-back-btn`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Choose Calculation Method
      </button>

      <div class="sgpa-mode-pills">
        <button type="button" class="sgpa-mode-pill active" id={`${idPrefix}-quick-pill-quick`}>Quick SGPA</button>
        <button type="button" class="sgpa-mode-pill" id={`${idPrefix}-quick-pill-detailed`}>From Subjects</button>
      </div>
    </div>

    <!-- Quick Result Card -->
    <div class="geist-card geist-card-floating" style="padding: 1.5rem; margin-bottom: 1.5rem; background: linear-gradient(180deg, var(--color-canvas-elevated) 0%, var(--color-canvas-subtle) 100%);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.25rem; align-items: center;">
        <div>
          <span class="mono-eyebrow" style="color: var(--color-emerald); margin-bottom: 0.25rem;">Semester GPA (10.0 Scale)</span>
          <div style="display: flex; align-items: baseline; gap: 0.75rem;">
            <span id={`${idPrefix}-quick-result-sgpa`} class="display-xl" style="font-feature-settings: 'tnum';">8.94</span>
            <span id={`${idPrefix}-quick-standing-badge`} class="badge badge-green">First Class with Distinction</span>
          </div>
          <p style="font-size: 0.875rem; color: var(--color-mute); margin-top: 0.25rem;">
            Approx. Percentage: <strong style="color: var(--color-ink);" id={`${idPrefix}-quick-result-pct`}>84.93%</strong>
            <span style="font-size: 0.75rem;">(&times; 9.5 Standard)</span>
          </p>
        </div>

        <!-- Credits & Points Breakdown -->
        <div class="responsive-col-divider" style="border-left: 1px solid var(--color-hairline); padding-left: 1.25rem;">
          <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
            <span style="color: var(--color-mute);">Registered Semester Credits:</span>
            <span id={`${idPrefix}-quick-disp-credits`} style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">18.0</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.5rem;">
            <span style="color: var(--color-mute);">Earned Quality Points:</span>
            <span id={`${idPrefix}-quick-disp-points`} style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">161.0</span>
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-mute); background: var(--color-canvas-subtle); padding: 0.35rem 0.5rem; border-radius: var(--radius-xs); border: 1px solid var(--color-hairline);">
            SGPA = Total Quality Points &divide; Semester Credits
          </div>
        </div>

        <!-- Actions -->
        <div style="display: flex; flex-direction: column; gap: 0.5rem; justify-content: center;">
          <button id={`${idPrefix}-quick-sample-btn`} type="button" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem;">
            Load Sample (161 / 18)
          </button>
          <button id={`${idPrefix}-quick-reset-btn`} type="button" class="btn btn-ghost" style="font-size: 0.8125rem; color: var(--color-mute);">
            Reset to Blank
          </button>
        </div>
      </div>
    </div>

    <!-- Quick Inputs Card -->
    <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
      <div style="margin-bottom: 1.25rem;">
        <h3 class="heading-md">Quick SGPA Inputs</h3>
        <p style="font-size: 0.875rem; color: var(--color-mute);">
          Enter total points and credits directly from your semester marksheet or grade report.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-bottom: 0.5rem;">
        <!-- Total Quality Points -->
        <div>
          <label for={`${idPrefix}-quick-input-points`} style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
            Total Quality / Credit Points Earned
          </label>
          <input type="number" step="0.1" min="0" id={`${idPrefix}-quick-input-points`} class="form-input form-input-mono" value="161.0" placeholder="e.g. 161" style="font-size: 1rem; padding: 0.65rem 0.85rem;" />
          <span style="display: block; font-size: 0.75rem; color: var(--color-mute); margin-top: 0.4rem; line-height: 1.4;">
            Sum of (Grade Point &times; Subject Credits) &bull; Found on marksheet as 'Total Points' or 'Quality Pts'
          </span>
        </div>

        <!-- Total Semester Credits -->
        <div>
          <label for={`${idPrefix}-quick-input-credits`} style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
            Total Registered Semester Credits
          </label>
          <input type="number" step="0.5" min="0.5" id={`${idPrefix}-quick-input-credits`} class="form-input form-input-mono" value="18" placeholder="e.g. 18" style="font-size: 1rem; padding: 0.65rem 0.85rem;" />
          <span style="display: block; font-size: 0.75rem; color: var(--color-mute); margin-top: 0.4rem; line-height: 1.4;">
            Total credit hours registered for all subjects this semester (typically between 16 and 26 credits)
          </span>
        </div>
      </div>
    </div>

    <!-- Quick Breakdown Card -->
    <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem; background: var(--color-canvas-subtle);">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
        <span class="badge badge-green">SGPA Breakdown</span>
        <h4 class="heading-md" style="font-size: 1rem;">Calculation Breakdown</h4>
      </div>
      <div id={`${idPrefix}-quick-breakdown-text`}>
      </div>
    </div>
  </div>

  <!-- VIEW 3: Detailed Subject-based Calculator -->
  <div id={`${idPrefix}-view-detailed`} class="sgpa-view-container" style="display: none;">
    <!-- Navigation Bar -->
    <div class="sgpa-mode-bar">
      <button type="button" class="btn btn-ghost btn-sm sgpa-back-btn" id={`${idPrefix}-detailed-back-btn`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Choose Calculation Method
      </button>

      <div class="sgpa-mode-pills">
        <button type="button" class="sgpa-mode-pill" id={`${idPrefix}-detailed-pill-quick`}>Quick SGPA</button>
        <button type="button" class="sgpa-mode-pill active" id={`${idPrefix}-detailed-pill-detailed`}>From Subjects</button>
      </div>
    </div>

    <!-- Live Result Showcase Card -->
    <div class="geist-card geist-card-floating" style="padding: 1.5rem; margin-bottom: 1.5rem; background: linear-gradient(180deg, var(--color-canvas-elevated) 0%, var(--color-canvas-subtle) 100%);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.25rem; align-items: center;">
        <div>
          <span class="mono-eyebrow" style="color: var(--color-emerald); margin-bottom: 0.25rem;">Semester GPA (10.0 Scale)</span>
          <div style="display: flex; align-items: baseline; gap: 0.75rem;">
            <span id={`${idPrefix}-result-sgpa`} class="display-xl" style="font-feature-settings: 'tnum';">8.94</span>
            <span id={`${idPrefix}-standing-badge`} class="badge badge-green">First Class with Distinction</span>
          </div>
          <p style="font-size: 0.875rem; color: var(--color-mute); margin-top: 0.25rem;">
            Approx. Percentage: <strong style="color: var(--color-ink);" id={`${idPrefix}-result-pct`}>84.93%</strong>
            <span style="font-size: 0.75rem;">(&times; 9.5 Standard)</span>
          </p>
        </div>

        <!-- Credits & Points Breakdown -->
        <div class="responsive-col-divider" style="border-left: 1px solid var(--color-hairline); padding-left: 1.25rem;">
          <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
            <span style="color: var(--color-mute);">Semester Credits Registered:</span>
            <span id={`${idPrefix}-total-credits`} style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">18.0</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.5rem;">
            <span style="color: var(--color-mute);">Earned Quality Points:</span>
            <span id={`${idPrefix}-total-points`} style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">161.0</span>
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-mute); background: var(--color-canvas-subtle); padding: 0.35rem 0.5rem; border-radius: var(--radius-xs); border: 1px solid var(--color-hairline);">
            SGPA = &Sigma;(Grade Point &times; Semester Credits) &divide; &Sigma;Credits
          </div>
        </div>

        <!-- Actions -->
        <div style="display: flex; flex-direction: column; gap: 0.5rem; justify-content: center;">
          <button id={`${idPrefix}-sample-btn`} type="button" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem;">
            Load Semester Sample
          </button>
          <button id={`${idPrefix}-reset-btn`} type="button" class="btn btn-ghost" style="font-size: 0.8125rem; color: var(--color-mute);">
            Reset to Blank
          </button>
        </div>
      </div>
    </div>

    <!-- Subjects Card -->
    <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem;">
        <div>
          <h3 class="heading-md">Current Semester Courses</h3>
          <p style="font-size: 0.875rem; color: var(--color-mute);">
            Enter courses for this semester to calculate your SGPA.
          </p>
        </div>

        <button id={`${idPrefix}-add-subject-btn`} type="button" class="btn btn-secondary" style="font-weight: 600; font-size: 0.8125rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Subject
        </button>
      </div>

      <div class="mobile-table-card-wrap" style="width: 100%; overflow-x: auto; margin-bottom: 1rem;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 1px solid var(--color-hairline); text-align: left; font-size: 0.8125rem; color: var(--color-mute);">
              <th style="padding: 0.5rem 0.75rem; font-weight: 500;">Subject / Paper Name</th>
              <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 170px;">Letter Grade</th>
              <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 120px;">Grade Point</th>
              <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 110px;">Credits</th>
              <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 130px; text-align: right;">Weighted Points</th>
              <th style="padding: 0.5rem 0.75rem; width: 44px;"></th>
            </tr>
          </thead>
          <tbody id={`${idPrefix}-tbody`}>
            <!-- Rendered dynamically by script -->
          </tbody>
        </table>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--color-hairline);">
        <button id={`${idPrefix}-add-subject-bottom-btn`} type="button" class="btn btn-secondary" style="font-weight: 600;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Another Subject
        </button>

        <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.8125rem;">
          <span style="color: var(--color-mute);">Semester Credits: <strong id={`${idPrefix}-footer-credits`} style="color: var(--color-ink); font-family: var(--font-mono);">0</strong></span>
          <span style="color: var(--color-mute);">Total Points: <strong id={`${idPrefix}-footer-points`} style="color: var(--color-ink); font-family: var(--font-mono);">0.0</strong></span>
        </div>
      </div>
    </div>

    <!-- Breakdown Card -->
    <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem; background: var(--color-canvas-subtle);">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
        <span class="badge badge-green">SGPA Breakdown</span>
        <h4 class="heading-md" style="font-size: 1rem;">Credit Points Calculation</h4>
      </div>
      <div id={`${idPrefix}-breakdown-text`} style="font-size: 0.875rem; color: var(--color-body); line-height: 1.6;">
        Enter subject grades and credits to see the SGPA computation.
      </div>
    </div>
  </div>
</div>

<style>
  /* Compact Near-Square Cards Grid */
  .sgpa-choice-wrapper {
    margin: 1rem auto 2.5rem auto;
    max-width: 620px;
  }
  .sgpa-choice-header-text {
    text-align: center;
    margin-bottom: 2rem;
  }
  .sgpa-square-cards-grid {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    align-items: stretch;
  }
  .sgpa-square-card {
    flex: 0 1 260px;
    width: 260px;
    height: 260px;
    box-sizing: border-box;
    background: var(--color-canvas-elevated);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    user-select: none;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: var(--shadow-whisper);
  }
  .sgpa-square-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-floating);
  }
  .sgpa-square-card:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .sgpa-card-icon-box {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-subtle);
    border: 1px solid var(--color-hairline);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    flex-shrink: 0;
    transition: border-color var(--transition-fast);
  }
  .sgpa-square-card:hover .sgpa-card-icon-box {
    border-color: var(--color-hairline-strong);
  }
  .sgpa-card-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    line-height: 1.35;
    margin: 0 0 0.45rem 0;
  }
  .sgpa-card-desc {
    font-size: 0.8125rem;
    color: var(--color-mute);
    line-height: 1.45;
    margin: 0 0 1.15rem 0;
    max-width: 220px;
  }
  .sgpa-card-btn-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .sgpa-card-btn {
    pointer-events: none;
    width: 100%;
    max-width: 150px;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .sgpa-square-card:hover .sgpa-card-btn {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
  }
  .sgpa-mode-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .sgpa-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-mute);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .sgpa-back-btn:hover {
    color: var(--color-ink);
    background: var(--color-canvas-subtle);
  }
  .sgpa-mode-pills {
    display: inline-flex;
    background: var(--color-canvas-subtle);
    padding: 3px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    gap: 3px;
  }
  .sgpa-mode-pill {
    padding: 0.35rem 0.85rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-mute);
    background: transparent;
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }
  .sgpa-mode-pill:hover {
    color: var(--color-ink);
  }
  .sgpa-mode-pill.active {
    background: var(--color-canvas-elevated);
    color: var(--color-ink);
    font-weight: 600;
    box-shadow: var(--shadow-whisper);
  }
  @media (max-width: 640px) {
    .sgpa-square-cards-grid {
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
    }
    .sgpa-square-card {
      width: 100%;
      max-width: 270px;
      height: 270px;
      padding: 1.5rem 1.25rem;
    }
    .sgpa-mode-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .sgpa-mode-pills {
      width: 100%;
      justify-content: center;
    }
    .sgpa-mode-pill {
      flex: 1;
      text-align: center;
    }
  }
</style>

<script define:vars={{ idPrefix }}>
  (function() {
    // -------------------------------------------------------------
    // Constants & Types
    // -------------------------------------------------------------
    const UGC_GRADES = [
      { letter: 'O', point: 10, label: 'O (Outstanding - 10)' },
      { letter: 'A+', point: 9, label: 'A+ (Excellent - 9)' },
      { letter: 'A', point: 8, label: 'A (Very Good - 8)' },
      { letter: 'B+', point: 7, label: 'B+ (Good - 7)' },
      { letter: 'B', point: 6, label: 'B (Above Average - 6)' },
      { letter: 'C', point: 5, label: 'C (Average - 5)' },
      { letter: 'P', point: 4, label: 'P (Pass - 4)' },
      { letter: 'F', point: 0, label: 'F (Fail - 0)' },
      { letter: 'Ab', point: 0, label: 'Ab (Absent - 0)' },
    ];

    const uid = () => Math.random().toString(36).substring(2, 9);

    function getStanding(sgpa) {
      if (sgpa >= 8.5) return { text: 'First Class with Distinction', class: 'badge-green' };
      if (sgpa >= 6.75) return { text: 'First Class', class: 'badge-blue' };
      if (sgpa >= 5.75) return { text: 'Higher Second Class', class: 'badge-amber' };
      if (sgpa >= 5.0) return { text: 'Second Class', class: 'badge-amber' };
      if (sgpa >= 4.0) return { text: 'Pass Class', class: 'badge-blue' };
      return { text: 'Remedial / Fail', class: 'badge-red' };
    }

    // -------------------------------------------------------------
    // View Switcher (Selector, Quick, Detailed)
    // -------------------------------------------------------------
    const viewSelector = document.getElementById(`${idPrefix}-view-selector`);
    const viewQuick = document.getElementById(`${idPrefix}-view-quick`);
    const viewDetailed = document.getElementById(`${idPrefix}-view-detailed`);

    let currentView = 'selector';

    function setView(viewName) {
      currentView = viewName;
      if (viewSelector) viewSelector.style.display = viewName === 'selector' ? 'block' : 'none';
      if (viewQuick) viewQuick.style.display = viewName === 'quick' ? 'block' : 'none';
      if (viewDetailed) viewDetailed.style.display = viewName === 'detailed' ? 'block' : 'none';

      if (viewName === 'quick') {
        calcQuick();
      } else if (viewName === 'detailed') {
        renderRows();
      }
    }

    // Setup Option Selector Card & Button Clicks
    const cardQuick = document.getElementById(`${idPrefix}-card-quick`);
    const btnChooseQuick = document.getElementById(`${idPrefix}-btn-choose-quick`);
    const cardDetailed = document.getElementById(`${idPrefix}-card-detailed`);
    const btnChooseDetailed = document.getElementById(`${idPrefix}-btn-choose-detailed`);

    const openQuick = (e) => {
      if (e) { e.preventDefault(); e.stopPropagation(); }
      setView('quick');
    };

    const openDetailed = (e) => {
      if (e) { e.preventDefault(); e.stopPropagation(); }
      setView('detailed');
    };

    cardQuick?.addEventListener('click', openQuick);
    btnChooseQuick?.addEventListener('click', openQuick);
    cardQuick?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openQuick(); }
    });

    cardDetailed?.addEventListener('click', openDetailed);
    btnChooseDetailed?.addEventListener('click', openDetailed);
    cardDetailed?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openDetailed(); }
    });

    // Back Buttons
    document.getElementById(`${idPrefix}-quick-back-btn`)?.addEventListener('click', () => setView('selector'));
    document.getElementById(`${idPrefix}-detailed-back-btn`)?.addEventListener('click', () => setView('selector'));

    // Mode Switch Pills
    document.getElementById(`${idPrefix}-quick-pill-quick`)?.addEventListener('click', () => setView('quick'));
    document.getElementById(`${idPrefix}-quick-pill-detailed`)?.addEventListener('click', () => setView('detailed'));
    document.getElementById(`${idPrefix}-detailed-pill-quick`)?.addEventListener('click', () => setView('quick'));
    document.getElementById(`${idPrefix}-detailed-pill-detailed`)?.addEventListener('click', () => setView('detailed'));

    // -------------------------------------------------------------
    // Quick SGPA Calculator Logic
    // -------------------------------------------------------------
    const qPointsInput = document.getElementById(`${idPrefix}-quick-input-points`);
    const qCreditsInput = document.getElementById(`${idPrefix}-quick-input-credits`);
    const qSgpaEl = document.getElementById(`${idPrefix}-quick-result-sgpa`);
    const qPctEl = document.getElementById(`${idPrefix}-quick-result-pct`);
    const qStandingBadge = document.getElementById(`${idPrefix}-quick-standing-badge`);
    const qDispCredits = document.getElementById(`${idPrefix}-quick-disp-credits`);
    const qDispPoints = document.getElementById(`${idPrefix}-quick-disp-points`);
    const qBreakdownEl = document.getElementById(`${idPrefix}-quick-breakdown-text`);

    function calcQuick() {
      const pointsVal = qPointsInput?.value?.trim();
      const creditsVal = qCreditsInput?.value?.trim();

      const points = pointsVal !== '' && !isNaN(pointsVal) ? parseFloat(pointsVal) : null;
      const credits = creditsVal !== '' && !isNaN(creditsVal) ? parseFloat(creditsVal) : null;

      if (points !== null && credits !== null && credits > 0 && points >= 0) {
        const sgpa = points / credits;
        const approxPct = sgpa * 9.5;
        const standing = getStanding(sgpa);

        if (qSgpaEl) qSgpaEl.textContent = sgpa.toFixed(2);
        if (qPctEl) qPctEl.textContent = `${approxPct.toFixed(2)}%`;
        if (qStandingBadge) {
          qStandingBadge.textContent = standing.text;
          qStandingBadge.className = `badge ${standing.class}`;
        }
        if (qDispCredits) qDispCredits.textContent = credits.toFixed(1);
        if (qDispPoints) qDispPoints.textContent = points.toFixed(1);

        if (qBreakdownEl) {
          qBreakdownEl.innerHTML = `
            <p style="margin-bottom: 0.5rem; color: var(--color-ink);">
              <strong>SGPA</strong> = Earned Quality Points (${points.toFixed(1)}) &divide; Registered Credits (${credits.toFixed(1)}) = <strong>${sgpa.toFixed(2)}</strong>
            </p>
            <p style="margin-bottom: 0.5rem; color: var(--color-ink);">
              <strong>Approx. Percentage</strong> = SGPA (${sgpa.toFixed(2)}) &times; 9.5 = <strong>${approxPct.toFixed(2)}%</strong>
            </p>
            <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-mute); margin-top: 0.5rem; background: var(--color-canvas); padding: 0.4rem 0.6rem; border-radius: var(--radius-xs); border: 1px solid var(--color-hairline);">
              Formula: SGPA = Total Grade Points (&Sigma;[C<sub>i</sub> &times; G<sub>i</sub>]) &divide; Total Credits (&Sigma;C<sub>i</sub>)
            </div>
          `;
        }
      } else {
        if (qSgpaEl) qSgpaEl.textContent = '--';
        if (qPctEl) qPctEl.textContent = '--%';
        if (qStandingBadge) {
          qStandingBadge.textContent = 'Awaiting Input';
          qStandingBadge.className = 'badge badge-blue';
        }
        if (qDispCredits) qDispCredits.textContent = '0.0';
        if (qDispPoints) qDispPoints.textContent = '0.0';
        if (qBreakdownEl) {
          qBreakdownEl.innerHTML = `
            <p style="color: var(--color-mute); margin: 0;">
              Enter both your earned credit points and registered credits to see the computed SGPA, percentage, and division standing.
            </p>
          `;
        }
      }
    }

    qPointsInput?.addEventListener('input', calcQuick);
    qCreditsInput?.addEventListener('input', calcQuick);

    document.getElementById(`${idPrefix}-quick-sample-btn`)?.addEventListener('click', () => {
      if (qPointsInput) qPointsInput.value = '161.0';
      if (qCreditsInput) qCreditsInput.value = '18.0';
      calcQuick();
    });

    document.getElementById(`${idPrefix}-quick-reset-btn`)?.addEventListener('click', () => {
      if (qPointsInput) qPointsInput.value = '';
      if (qCreditsInput) qCreditsInput.value = '';
      calcQuick();
    });

    // -------------------------------------------------------------
    // Detailed Subject-based Calculator Logic (Intact)
    // -------------------------------------------------------------
    const defaultSubjects = [
      { id: uid(), name: 'Algorithms Design & Analysis', grade: 'O', point: 10, credits: 4 },
      { id: uid(), name: 'Database Management Systems', grade: 'A+', point: 9, credits: 4 },
      { id: uid(), name: 'Operating Systems', grade: 'A', point: 8, credits: 4 },
      { id: uid(), name: 'DBMS Lab Practical', grade: 'O', point: 10, credits: 2 },
      { id: uid(), name: 'Discrete Mathematics', grade: 'B+', point: 7, credits: 3 },
      { id: uid(), name: 'Technical Communication', grade: 'A', point: 8, credits: 2 },
    ];

    let subjects = JSON.parse(JSON.stringify(defaultSubjects));

    const tbody = document.getElementById(`${idPrefix}-tbody`);
    const sgpaEl = document.getElementById(`${idPrefix}-result-sgpa`);
    const pctEl = document.getElementById(`${idPrefix}-result-pct`);
    const standingBadge = document.getElementById(`${idPrefix}-standing-badge`);
    const totalCreditsEl = document.getElementById(`${idPrefix}-total-credits`);
    const totalPointsEl = document.getElementById(`${idPrefix}-total-points`);
    const footerCreditsEl = document.getElementById(`${idPrefix}-footer-credits`);
    const footerPointsEl = document.getElementById(`${idPrefix}-footer-points`);
    const breakdownEl = document.getElementById(`${idPrefix}-breakdown-text`);

    function renderRows() {
      if (!tbody) return;
      tbody.innerHTML = '';

      subjects.forEach((subj, idx) => {
        const trRow = document.createElement('tr');
        trRow.className = 'mobile-card-row subject-card-row';
        trRow.style.borderBottom = '1px solid var(--color-hairline)';

        const ptsEarned = ((subj.point || 0) * (subj.credits || 0)).toFixed(1);

        trRow.innerHTML = `
          <td class="td-cgpa-name" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Subject #${idx + 1}</span>
            <input type="text" class="form-input subj-name-input" data-id="${subj.id}" value="${subj.name || ''}" placeholder="Subject name" />
          </td>
          <td class="td-cgpa-grade" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Letter Grade</span>
            <select class="form-select subj-grade-select" data-id="${subj.id}">
              <option value="">-- Select Grade --</option>
              ${UGC_GRADES.map(g => `<option value="${g.letter}" ${g.letter === subj.grade ? 'selected' : ''}>${g.label}</option>`).join('')}
              <option value="custom" ${subj.grade === 'custom' ? 'selected' : ''}>Custom Grade Point</option>
            </select>
          </td>
          <td class="td-cgpa-point" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Grade Point</span>
            <input type="number" step="0.1" min="0" max="10" class="form-input form-input-mono subj-point-input" data-id="${subj.id}" value="${subj.point !== null ? subj.point : ''}" placeholder="0-10" />
          </td>
          <td class="td-cgpa-credits" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Credits</span>
            <input type="number" step="0.5" min="0" max="12" class="form-input form-input-mono subj-credits-input" data-id="${subj.id}" value="${subj.credits || ''}" placeholder="Credits" />
          </td>
          <td class="td-cgpa-pts-earned" style="padding: 0.5rem 0.75rem; text-align: right; font-family: var(--font-mono); font-weight: 600; color: var(--color-ink);">
            <span class="mobile-input-label">Weighted Pts</span>
            <span>${ptsEarned}</span>
          </td>
          <td class="td-cgpa-del" style="padding: 0.5rem 0.75rem; text-align: right;">
            <button type="button" class="btn btn-ghost btn-icon delete-subj-btn" data-id="${subj.id}" title="Remove subject" aria-label="Remove subject">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </td>
        `;

        tbody.appendChild(trRow);
      });

      calculate();
    }

    function calculate() {
      let totalCredits = 0;
      let totalPoints = 0;

      subjects.forEach((s) => {
        const c = Number(s.credits) || 0;
        const p = s.point !== null && !isNaN(s.point) ? Number(s.point) : null;

        if (c > 0 && p !== null) {
          totalCredits += c;
          const weighted = p * c;
          totalPoints += weighted;
        }
      });

      if (totalCredits > 0) {
        const sgpa = totalPoints / totalCredits;
        const approxPct = (sgpa * 9.5);
        const standing = getStanding(sgpa);

        if (sgpaEl) sgpaEl.textContent = sgpa.toFixed(2);
        if (pctEl) pctEl.textContent = `${approxPct.toFixed(2)}%`;
        if (standingBadge) {
          standingBadge.textContent = standing.text;
          standingBadge.className = `badge ${standing.class}`;
        }
        if (totalCreditsEl) totalCreditsEl.textContent = totalCredits.toFixed(1);
        if (totalPointsEl) totalPointsEl.textContent = totalPoints.toFixed(1);
        if (footerCreditsEl) footerCreditsEl.textContent = totalCredits.toFixed(1);
        if (footerPointsEl) footerPointsEl.textContent = totalPoints.toFixed(1);

        if (breakdownEl) {
          breakdownEl.innerHTML = `
            <p style="margin-bottom: 0.5rem; color: var(--color-ink);">
              <strong>SGPA</strong> = Total Weighted Quality Points (${totalPoints.toFixed(1)}) &divide; Semester Credits (${totalCredits.toFixed(1)}) = <strong>${sgpa.toFixed(2)}</strong>
            </p>
            <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-mute);">
              Formula: SGPA = &Sigma;(C<sub>i</sub> &times; G<sub>i</sub>) / &Sigma;C<sub>i</sub>
            </div>
          `;
        }
      } else {
        if (sgpaEl) sgpaEl.textContent = '--';
        if (pctEl) pctEl.textContent = '--%';
        if (standingBadge) {
          standingBadge.textContent = 'Awaiting Input';
          standingBadge.className = 'badge badge-blue';
        }
        if (totalCreditsEl) totalCreditsEl.textContent = '0';
        if (totalPointsEl) totalPointsEl.textContent = '0.0';
        if (footerCreditsEl) footerCreditsEl.textContent = '0';
        if (footerPointsEl) footerPointsEl.textContent = '0.0';
        if (breakdownEl) {
          breakdownEl.textContent = 'Enter subject grades and credits to see the SGPA computation.';
        }
      }
    }

    tbody?.addEventListener('input', (e) => {
      const target = e.target;
      const id = target.getAttribute('data-id');
      if (!id) return;
      const s = subjects.find(x => x.id === id);
      if (!s) return;

      if (target.classList.contains('subj-name-input')) {
        s.name = target.value;
      } else if (target.classList.contains('subj-point-input')) {
        s.point = target.value === '' ? null : Math.min(10, Math.max(0, parseFloat(target.value) || 0));
        const matched = UGC_GRADES.find(g => g.point === s.point);
        s.grade = matched ? matched.letter : 'custom';
        const select = tbody.querySelector(`.subj-grade-select[data-id="${id}"]`);
        if (select) select.value = s.grade;
      } else if (target.classList.contains('subj-credits-input')) {
        s.credits = target.value === '' ? null : parseFloat(target.value) || 0;
      }

      const ptsCell = target.closest('tr')?.querySelector('.td-cgpa-pts-earned span:not(.mobile-input-label)');
      if (ptsCell) {
        ptsCell.textContent = ((s.point || 0) * (s.credits || 0)).toFixed(1);
      }

      calculate();
    });

    tbody?.addEventListener('change', (e) => {
      const target = e.target;
      const id = target.getAttribute('data-id');
      if (!id) return;
      const s = subjects.find(x => x.id === id);
      if (!s) return;

      if (target.classList.contains('subj-grade-select')) {
        const val = target.value;
        s.grade = val;
        const matched = UGC_GRADES.find(g => g.letter === val);
        if (matched) {
          s.point = matched.point;
          const pointInput = tbody.querySelector(`.subj-point-input[data-id="${id}"]`);
          if (pointInput) pointInput.value = matched.point.toString();
        }
        const ptsCell = target.closest('tr')?.querySelector('.td-cgpa-pts-earned span:not(.mobile-input-label)');
        if (ptsCell) {
          ptsCell.textContent = ((s.point || 0) * (s.credits || 0)).toFixed(1);
        }
        calculate();
      }
    });

    tbody?.addEventListener('click', (e) => {
      const btn = e.target.closest('.delete-subj-btn');
      if (!btn) return;
      const id = btn.getAttribute('data-id');
      if (!id) return;
      subjects = subjects.filter(x => x.id !== id);
      renderRows();
    });

    const addFn = () => {
      subjects.push({
        id: uid(),
        name: '',
        grade: 'A',
        point: 8,
        credits: 3
      });
      renderRows();
    };
    document.getElementById(`${idPrefix}-add-subject-btn`)?.addEventListener('click', addFn);
    document.getElementById(`${idPrefix}-add-subject-bottom-btn`)?.addEventListener('click', addFn);

    document.getElementById(`${idPrefix}-sample-btn`)?.addEventListener('click', () => {
      subjects = JSON.parse(JSON.stringify(defaultSubjects));
      renderRows();
    });

    document.getElementById(`${idPrefix}-reset-btn`)?.addEventListener('click', () => {
      subjects = [
        { id: uid(), name: '', grade: '', point: null, credits: null },
        { id: uid(), name: '', grade: '', point: null, credits: null },
        { id: uid(), name: '', grade: '', point: null, credits: null },
      ];
      renderRows();
    });

    // Listen for tab switch to reset to initial option selector view
    window.addEventListener('gradecalc:sgpa-reset-view', () => {
      setView('selector');
    });

    // Start in Option Selector view
    setView('selector');
  })();
</script>
