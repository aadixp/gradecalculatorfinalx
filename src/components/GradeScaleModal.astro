---
// src/components/GradeScaleModal.astro
---

<div id="grade-scale-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="scale-modal-title">
  <div class="modal-panel">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem;">
      <div>
        <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.25rem;" data-i18n="modal.scaleConfig">Scale Configuration</span>
        <h3 id="scale-modal-title" class="heading-md" data-i18n="modal.scaleTitle">Grading Scale & Cutoffs</h3>
        <p style="font-size: 0.875rem; color: var(--color-mute); margin-top: 0.25rem;" data-i18n="modal.scaleDesc">
          Select an academic scale preset or customize threshold percentages to match your syllabus.
        </p>
      </div>
      <button id="close-scale-modal" class="btn btn-ghost btn-icon" aria-label="Close modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Scale Presets -->
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
      <button type="button" class="btn btn-secondary btn-pill preset-scale-btn active" data-preset="standard">Standard US (4.0)</button>
      <button type="button" class="btn btn-secondary btn-pill preset-scale-btn" data-preset="us5">US 5.0 (AP/Honors)</button>
      <button type="button" class="btn btn-secondary btn-pill preset-scale-btn" data-preset="indian10">Indian 10-Point (UGC)</button>
      <button type="button" class="btn btn-secondary btn-pill preset-scale-btn" data-preset="straight10">10-Point Simple</button>
      <button type="button" class="btn btn-secondary btn-pill preset-scale-btn" data-preset="uk">UK Honours</button>
      <button type="button" class="btn btn-secondary btn-pill preset-scale-btn" data-preset="canadian">Canadian</button>
    </div>

    <!-- Scale Table -->
    <div style="border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); overflow-x: auto; margin-bottom: 1.25rem;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
        <thead>
          <tr style="background: var(--color-canvas-subtle); border-bottom: 1px solid var(--color-hairline); text-align: left;">
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);" data-i18n="modal.colLetterGrade">Letter Grade</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);" data-i18n="modal.colMinPct">Min Percentage (%)</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);" data-i18n="modal.colGpaPoints">GPA Points</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);" data-i18n="modal.colDescription">Description</th>
          </tr>
        </thead>
        <tbody id="scale-table-body">
          <!-- Populated dynamically by script -->
        </tbody>
      </table>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; border-top: 1px solid var(--color-hairline);">
      <button id="reset-scale-btn" type="button" class="btn btn-ghost" style="font-size: 0.8125rem;" data-i18n="btn.resetDefault">
        Reset to Default
      </button>
      <div style="display: flex; gap: 0.5rem;">
        <button id="cancel-scale-btn" type="button" class="btn btn-secondary" data-i18n="btn.done">Done</button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const STORAGE_KEY_SCALE = 'gradecalc_active_scale_v2';
    const STORAGE_KEY_PRESET = 'gradecalc_active_scale_preset_v2';

    const PRESET_SCALES: Record<string, Array<{ grade: string; min: number; gpa: number; desc: string }>> = {
      standard: [
        { grade: 'A+', min: 97, gpa: 4.0, desc: 'Excellent' },
        { grade: 'A', min: 93, gpa: 4.0, desc: 'Superior' },
        { grade: 'A-', min: 90, gpa: 3.7, desc: 'Very Good' },
        { grade: 'B+', min: 87, gpa: 3.3, desc: 'Good' },
        { grade: 'B', min: 83, gpa: 3.0, desc: 'Above Average' },
        { grade: 'B-', min: 80, gpa: 2.7, desc: 'Fully Competent' },
        { grade: 'C+', min: 77, gpa: 2.3, desc: 'Average' },
        { grade: 'C', min: 73, gpa: 2.0, desc: 'Acceptable' },
        { grade: 'C-', min: 70, gpa: 1.7, desc: 'Below Average' },
        { grade: 'D+', min: 67, gpa: 1.3, desc: 'Marginal Pass' },
        { grade: 'D', min: 63, gpa: 1.0, desc: 'Poor' },
        { grade: 'D-', min: 60, gpa: 0.7, desc: 'Minimum Pass' },
        { grade: 'F', min: 0, gpa: 0.0, desc: 'Failing' },
      ],
      us5: [
        { grade: 'A+', min: 97, gpa: 5.0, desc: 'AP/Honors Max' },
        { grade: 'A', min: 93, gpa: 5.0, desc: 'AP/Honors Superior' },
        { grade: 'A-', min: 90, gpa: 4.7, desc: 'AP/Honors High' },
        { grade: 'B+', min: 87, gpa: 4.3, desc: 'AP/Honors Good' },
        { grade: 'B', min: 83, gpa: 4.0, desc: 'AP/Honors Standard' },
        { grade: 'B-', min: 80, gpa: 3.7, desc: 'AP/Honors Competent' },
        { grade: 'C+', min: 77, gpa: 3.3, desc: 'AP/Honors Average' },
        { grade: 'C', min: 73, gpa: 3.0, desc: 'AP/Honors Acceptable' },
        { grade: 'D', min: 60, gpa: 2.0, desc: 'Passing' },
        { grade: 'F', min: 0, gpa: 0.0, desc: 'Failing' },
      ],
      indian10: [
        { grade: 'O', min: 90, gpa: 10.0, desc: 'Outstanding' },
        { grade: 'A+', min: 80, gpa: 9.0, desc: 'Excellent' },
        { grade: 'A', min: 70, gpa: 8.0, desc: 'Very Good' },
        { grade: 'B+', min: 60, gpa: 7.0, desc: 'Good' },
        { grade: 'B', min: 50, gpa: 6.0, desc: 'Above Average' },
        { grade: 'C', min: 45, gpa: 5.0, desc: 'Average' },
        { grade: 'P', min: 40, gpa: 4.0, desc: 'Pass' },
        { grade: 'F', min: 0, gpa: 0.0, desc: 'Fail' },
      ],
      straight10: [
        { grade: 'A', min: 90, gpa: 4.0, desc: 'Excellent (90-100)' },
        { grade: 'B', min: 80, gpa: 3.0, desc: 'Good (80-89)' },
        { grade: 'C', min: 70, gpa: 2.0, desc: 'Satisfactory (70-79)' },
        { grade: 'D', min: 60, gpa: 1.0, desc: 'Passing (60-69)' },
        { grade: 'F', min: 0, gpa: 0.0, desc: 'Failing (<60)' },
      ],
      uk: [
        { grade: '1st', min: 70, gpa: 4.0, desc: 'First Class Honours' },
        { grade: '2:1', min: 60, gpa: 3.3, desc: 'Upper Second Class' },
        { grade: '2:2', min: 50, gpa: 2.7, desc: 'Lower Second Class' },
        { grade: '3rd', min: 40, gpa: 2.0, desc: 'Third Class Honours' },
        { grade: 'Fail', min: 0, gpa: 0.0, desc: 'Fail' },
      ],
      canadian: [
        { grade: 'A+', min: 90, gpa: 4.0, desc: 'Exceptional' },
        { grade: 'A', min: 85, gpa: 3.9, desc: 'Excellent' },
        { grade: 'A-', min: 80, gpa: 3.7, desc: 'Superior' },
        { grade: 'B+', min: 77, gpa: 3.3, desc: 'Very Good' },
        { grade: 'B', min: 73, gpa: 3.0, desc: 'Good' },
        { grade: 'B-', min: 70, gpa: 2.7, desc: 'Competent' },
        { grade: 'C+', min: 67, gpa: 2.3, desc: 'Fair' },
        { grade: 'C', min: 63, gpa: 2.0, desc: 'Satisfactory' },
        { grade: 'C-', min: 60, gpa: 1.7, desc: 'Marginal' },
        { grade: 'D', min: 50, gpa: 1.0, desc: 'Pass' },
        { grade: 'F', min: 0, gpa: 0.0, desc: 'Inadequate' },
      ],
    };

    let currentPreset = 'standard';
    try {
      currentPreset = localStorage.getItem(STORAGE_KEY_PRESET) || 'standard';
    } catch (e) {}

    let currentScale = PRESET_SCALES[currentPreset] || PRESET_SCALES.standard;
    try {
      const saved = localStorage.getItem(STORAGE_KEY_SCALE);
      if (saved) currentScale = JSON.parse(saved);
    } catch (e) {}

    function renderScaleRows() {
      const tbody = document.getElementById('scale-table-body');
      if (!tbody) return;
      tbody.innerHTML = '';

      currentScale.forEach((row, idx) => {
        const tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid var(--color-hairline)';
        tr.innerHTML = `
          <td style="padding: 0.5rem 0.875rem; font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">${row.grade}</td>
          <td style="padding: 0.5rem 0.875rem;">
            <input type="number" step="0.5" min="0" max="100" class="form-input form-input-mono scale-min-input" data-idx="${idx}" value="${row.min}" style="width: 80px; padding: 0.25rem 0.5rem; font-size: 0.8125rem;" />
          </td>
          <td style="padding: 0.5rem 0.875rem; font-family: var(--font-mono); color: var(--color-mute);">${row.gpa.toFixed(1)}</td>
          <td style="padding: 0.5rem 0.875rem; color: var(--color-body); font-size: 0.8125rem;">${row.desc}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function initScaleModal() {
      const modal = document.getElementById('grade-scale-modal');
      const openBtn = document.getElementById('open-scale-modal-btn');
      const closeBtn = document.getElementById('close-scale-modal');
      const cancelBtn = document.getElementById('cancel-scale-btn');
      const resetBtn = document.getElementById('reset-scale-btn');

      function openModal() {
        if (modal) {
          modal.classList.add('open');
          renderScaleRows();
        }
      }

      function closeModal() {
        if (modal) modal.classList.remove('open');
      }

      openBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openModal();
      });

      // Also listen on any active scale tags or triggers
      document.querySelectorAll('#active-scale-tag, .open-scale-trigger').forEach(el => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          openModal();
        });
      });

      closeBtn?.addEventListener('click', closeModal);
      cancelBtn?.addEventListener('click', closeModal);

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal?.classList.contains('open')) {
          closeModal();
        }
      });

      // Preset buttons
      document.querySelectorAll('.preset-scale-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const preset = btn.getAttribute('data-preset');
          if (preset && PRESET_SCALES[preset]) {
            currentPreset = preset;
            currentScale = JSON.parse(JSON.stringify(PRESET_SCALES[preset]));
            document.querySelectorAll('.preset-scale-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            try {
              localStorage.setItem(STORAGE_KEY_PRESET, currentPreset);
              localStorage.setItem(STORAGE_KEY_SCALE, JSON.stringify(currentScale));
            } catch (e) {}

            renderScaleRows();
            window.dispatchEvent(new CustomEvent('gradecalc:scale-changed', {
              detail: { preset: currentPreset, scale: currentScale }
            }));
          }
        });
      });

      // Custom cutoff edits
      document.getElementById('scale-table-body')?.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.classList.contains('scale-min-input')) {
          const idx = parseInt(target.getAttribute('data-idx') || '-1', 10);
          if (idx >= 0 && currentScale[idx]) {
            currentScale[idx].min = parseFloat(target.value) || 0;
            try {
              localStorage.setItem(STORAGE_KEY_SCALE, JSON.stringify(currentScale));
            } catch (err) {}

            window.dispatchEvent(new CustomEvent('gradecalc:scale-changed', {
              detail: { preset: currentPreset, scale: currentScale }
            }));
          }
        }
      });

      // Reset
      resetBtn?.addEventListener('click', () => {
        currentPreset = 'standard';
        currentScale = JSON.parse(JSON.stringify(PRESET_SCALES.standard));
        document.querySelectorAll('.preset-scale-btn').forEach(b => {
          b.classList.toggle('active', b.getAttribute('data-preset') === 'standard');
        });

        try {
          localStorage.setItem(STORAGE_KEY_PRESET, 'standard');
          localStorage.setItem(STORAGE_KEY_SCALE, JSON.stringify(currentScale));
        } catch (e) {}

        renderScaleRows();
        window.dispatchEvent(new CustomEvent('gradecalc:scale-changed', {
          detail: { preset: 'standard', scale: currentScale }
        }));
      });

      renderScaleRows();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScaleModal);
    } else {
      initScaleModal();
    }
  })();
</script>
