---
// src/components/FinalExamCalculator.astro
---

<div id="calculator-final" class="calculator-panel" style="display: none;">
  <!-- Callout & Live Result -->
  <div class="geist-card geist-card-floating" style="padding: 1.75rem; margin-bottom: 1.5rem; background: linear-gradient(180deg, var(--color-canvas-elevated) 0%, var(--color-canvas-subtle) 100%);">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; align-items: center;">
      <div>
        <span class="mono-eyebrow" style="color: var(--color-violet); margin-bottom: 0.25rem;">Final Exam Target</span>
        <div style="margin-top: 0.5rem;">
          <span style="font-size: 0.875rem; color: var(--color-mute); display: block;">Score Required on Final:</span>
          <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-top: 0.25rem;">
            <span id="final-required-score" class="display-xl" style="font-feature-settings: 'tnum';">--%</span>
            <span id="final-feasibility-badge" class="badge badge-blue">Ready</span>
          </div>
        </div>
        <p id="final-feasibility-desc" style="font-size: 0.875rem; color: var(--color-body); margin-top: 0.75rem; line-height: 1.4;">
          Enter your current grade and final exam weight to see what score you need.
        </p>
      </div>

      <!-- Quick Summary Card -->
      <div style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 1.25rem; background: var(--color-canvas-elevated);">
        <h4 style="font-size: 0.875rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.75rem;">Formula Breakdown</h4>
        <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-body); background: var(--color-canvas-subtle); padding: 0.5rem 0.75rem; border-radius: var(--radius-sm); margin-bottom: 0.75rem; border: 1px solid var(--color-hairline);">
          Final = (Target - Current &times; (1 - Weight)) / Weight
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; color: var(--color-mute);">
          <span>Current Impact: <strong id="final-current-weight-impact" style="color: var(--color-ink);">--</strong></span>
          <span>Final Worth: <strong id="final-weight-val-summary" style="color: var(--color-ink);">--</strong></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Input Form Controls Card -->
  <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
    <h3 class="heading-md" style="margin-bottom: 1.25rem;">Exam Target Parameters</h3>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem;">
      <!-- Current Grade -->
      <div>
        <label for="fe-current-grade" style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          Current Class Grade (%):
        </label>
        <input id="fe-current-grade" type="number" step="0.1" min="0" max="150" class="form-input form-input-mono" value="87.5" placeholder="e.g. 87.5" />
        <span style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.25rem; display: block;">Your grade before taking the final exam.</span>
      </div>

      <!-- Desired Target Grade -->
      <div>
        <label for="fe-target-grade" style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          Desired Final Class Grade (%):
        </label>
        <div style="display: flex; gap: 0.5rem;">
          <input id="fe-target-grade" type="number" step="0.1" min="0" max="100" class="form-input form-input-mono" value="90.0" placeholder="e.g. 90" />
          <select id="fe-target-quickpick" class="form-select" style="width: auto; min-width: 90px;">
            <option value="">Preset</option>
            <option value="93">A (93%)</option>
            <option value="90" selected>A- (90%)</option>
            <option value="87">B+ (87%)</option>
            <option value="83">B (83%)</option>
            <option value="80">B- (80%)</option>
            <option value="73">C (73%)</option>
            <option value="70">Passing (70%)</option>
          </select>
        </div>
        <span style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.25rem; display: block;">The overall course percentage you want to end with.</span>
      </div>

      <!-- Final Exam Weight -->
      <div>
        <label for="fe-weight" style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          Final Exam Weight (%):
        </label>
        <input id="fe-weight" type="number" step="0.5" min="1" max="100" class="form-input form-input-mono" value="25" placeholder="e.g. 25" />
        <span style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.25rem; display: block;">Percentage of overall course grade the exam counts.</span>
      </div>
    </div>
  </div>

  <!-- All Grades Scenario Matrix Table -->
  <div class="geist-card" style="padding: 1.5rem;">
    <div style="margin-bottom: 1rem;">
      <h3 class="heading-md">Target Matrix Comparison</h3>
      <p style="font-size: 0.875rem; color: var(--color-mute);">
        Required score on the final exam across every letter grade benchmark based on your current inputs.
      </p>
    </div>

    <div style="overflow-x: auto;">
      <table class="matrix-table" style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
        <thead>
          <tr style="background: var(--color-canvas-subtle); border-bottom: 1px solid var(--color-hairline); text-align: left;">
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);">Target Grade</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);">Minimum %</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);">Score Needed on Final</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);">Difficulty / Status</th>
          </tr>
        </thead>
        <tbody id="fe-matrix-tbody">
          <!-- Populated by JS -->
        </tbody>
      </table>
    </div>
  </div>
</div>
