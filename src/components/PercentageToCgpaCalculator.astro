---
// src/components/PercentageToCgpaCalculator.astro
interface Props {
  idPrefix?: string;
}
const { idPrefix = 'pct2cgpa' } = Astro.props;
---

<div id={`${idPrefix}-calculator-panel`} class="calc-component-root">
  <!-- Live Result Card -->
  <div class="geist-card geist-card-floating" style="padding: 1.75rem; margin-bottom: 1.5rem; background: linear-gradient(180deg, var(--color-canvas-elevated) 0%, var(--color-canvas-subtle) 100%);">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; align-items: center;">
      <div>
        <span class="mono-eyebrow" style="color: var(--color-cyan); margin-bottom: 0.25rem;">Estimated CGPA (10.0 Scale)</span>
        <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-top: 0.25rem;">
          <span id={`${idPrefix}-result-val`} class="display-xl" style="font-feature-settings: 'tnum';">--</span>
          <span id={`${idPrefix}-standing-badge`} class="badge badge-green">First Class</span>
        </div>
        <p id={`${idPrefix}-formula-caption`} style="font-size: 0.875rem; color: var(--color-mute); margin-top: 0.5rem; line-height: 1.4;">
          Approximate conversion based on standard formulas.
        </p>
      </div>

      <!-- Quick Comparison Box -->
      <div style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 1.25rem; background: var(--color-canvas-elevated);">
        <h4 style="font-size: 0.875rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.5rem;">Multi-Formula Quick Benchmark</h4>
        <div style="display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.8125rem;">
          <div style="display: flex; justify-content: space-between; color: var(--color-mute);">
            <span>AICTE / CBSE (&divide; 9.5):</span>
            <strong id={`${idPrefix}-bench-aicte`} style="color: var(--color-ink); font-family: var(--font-mono);">--</strong>
          </div>
          <div style="display: flex; justify-content: space-between; color: var(--color-mute);">
            <span>Direct Scale (&divide; 10):</span>
            <strong id={`${idPrefix}-bench-direct`} style="color: var(--color-ink); font-family: var(--font-mono);">--</strong>
          </div>
          <div style="display: flex; justify-content: space-between; color: var(--color-mute);">
            <span>VTU / Mumbai ((% &divide; 10) + 0.75):</span>
            <strong id={`${idPrefix}-bench-vtu`} style="color: var(--color-ink); font-family: var(--font-mono);">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Input Parameters Card -->
  <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
    <h3 class="heading-md" style="margin-bottom: 1.25rem;">Percentage Input & Formula</h3>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; align-items: flex-start;">
      <!-- Percentage Input -->
      <div>
        <label for={`${idPrefix}-pct-input`} style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          Aggregate Marks Percentage (%):
        </label>
        <input id={`${idPrefix}-pct-input`} type="number" step="0.1" min="0" max="100" class="form-input form-input-mono" value="82.5" placeholder="e.g. 82.5" />
        <span style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.25rem; display: block;">Enter your overall percentage (0.0 to 100.0%).</span>
      </div>

      <!-- University / Method Preset -->
      <div>
        <label for={`${idPrefix}-method-select`} style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          Reverse Conversion Rule:
        </label>
        <select id={`${idPrefix}-method-select`} class="form-select">
          <option value="aicte" selected>AICTE / CBSE Standard (Percentage &divide; 9.5)</option>
          <option value="direct10">Direct 10&times; (Percentage &divide; 10)</option>
          <option value="vtu">VTU / Mumbai University ((% &divide; 10) + 0.75)</option>
          <option value="custom">Custom Divisor</option>
        </select>
        <span style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.25rem; display: block;">Select the standard conversion guideline.</span>
      </div>

      <!-- Custom Divisor (Hidden unless custom selected) -->
      <div id={`${idPrefix}-custom-wrap`} style="display: none;">
        <label for={`${idPrefix}-custom-div`} style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          Custom Divisor:
        </label>
        <input id={`${idPrefix}-custom-div`} type="number" step="0.01" min="1" max="20" class="form-input form-input-mono" value="9.5" placeholder="e.g. 9.5" />
        <span style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.25rem; display: block;">CGPA = Percentage &divide; Divisor.</span>
      </div>
    </div>
  </div>

  <!-- Disclaimer Notice -->
  <div class="geist-card" style="padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; border-left: 3px solid var(--color-blue); background: var(--color-canvas-subtle);">
    <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-blue)" stroke-width="2" style="flex-shrink: 0; margin-top: 0.15rem;">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <div style="font-size: 0.8125rem; line-height: 1.6; color: var(--color-body);">
        <strong style="color: var(--color-ink);">Approximation Advisory:</strong>
        Converting an aggregate percentage back into a cumulative grade point average (CGPA) is an approximation unless your college or board provides an explicit reverse equivalence table. Individual subject grade distributions and credit weighting can yield minor differences in true CGPA.
      </div>
    </div>
  </div>
</div>

<script define:vars={{ idPrefix }}>
  (function() {
    const pctInput = document.getElementById(`${idPrefix}-pct-input`);
    const methodSelect = document.getElementById(`${idPrefix}-method-select`);
    const customWrap = document.getElementById(`${idPrefix}-custom-wrap`);
    const customDiv = document.getElementById(`${idPrefix}-custom-div`);
    const resultVal = document.getElementById(`${idPrefix}-result-val`);
    const standingBadge = document.getElementById(`${idPrefix}-standing-badge`);
    const captionEl = document.getElementById(`${idPrefix}-formula-caption`);

    const benchAicte = document.getElementById(`${idPrefix}-bench-aicte`);
    const benchDirect = document.getElementById(`${idPrefix}-bench-direct`);
    const benchVtu = document.getElementById(`${idPrefix}-bench-vtu`);

    function calculate() {
      const pct = parseFloat(pctInput?.value || '0');
      const method = methodSelect?.value || 'aicte';
      const customFactor = parseFloat(customDiv?.value || '9.5');

      if (customWrap) {
        customWrap.style.display = method === 'custom' ? 'block' : 'none';
      }

      if (isNaN(pct) || pct < 0) {
        if (resultVal) resultVal.textContent = '--';
        return;
      }

      const aicteCgpa = Math.min(10, Math.max(0, pct / 9.5));
      const directCgpa = Math.min(10, Math.max(0, pct / 10));
      const vtuCgpa = Math.min(10, Math.max(0, (pct / 10) + 0.75));

      if (benchAicte) benchAicte.textContent = aicteCgpa.toFixed(2);
      if (benchDirect) benchDirect.textContent = directCgpa.toFixed(2);
      if (benchVtu) benchVtu.textContent = vtuCgpa.toFixed(2);

      let selectedCgpa = aicteCgpa;
      let formulaText = `CGPA = ${pct.toFixed(1)}% &divide; 9.5 = <strong>${aicteCgpa.toFixed(2)}</strong> (AICTE standard benchmark)`;

      if (method === 'direct10') {
        selectedCgpa = directCgpa;
        formulaText = `CGPA = ${pct.toFixed(1)}% &divide; 10 = <strong>${directCgpa.toFixed(2)}</strong> (Direct 10-point scale)`;
      } else if (method === 'vtu') {
        selectedCgpa = vtuCgpa;
        formulaText = `CGPA = (${pct.toFixed(1)}% &divide; 10) + 0.75 = <strong>${vtuCgpa.toFixed(2)}</strong> (VTU / Mumbai University rule)`;
      } else if (method === 'custom') {
        selectedCgpa = Math.min(10, Math.max(0, pct / (customFactor || 1)));
        formulaText = `CGPA = ${pct.toFixed(1)}% &divide; ${customFactor} = <strong>${selectedCgpa.toFixed(2)}</strong> (Custom divisor)`;
      }

      if (resultVal) resultVal.textContent = selectedCgpa.toFixed(2);
      if (captionEl) captionEl.innerHTML = formulaText;

      if (standingBadge) {
        if (selectedCgpa >= 8.5) {
          standingBadge.textContent = 'Distinction';
          standingBadge.className = 'badge badge-green';
        } else if (selectedCgpa >= 6.75) {
          standingBadge.textContent = 'First Class';
          standingBadge.className = 'badge badge-blue';
        } else if (selectedCgpa >= 5.75) {
          standingBadge.textContent = 'Higher Second Class';
          standingBadge.className = 'badge badge-amber';
        } else if (selectedCgpa >= 4.0) {
          standingBadge.textContent = 'Pass Class';
          standingBadge.className = 'badge badge-blue';
        } else {
          standingBadge.textContent = 'Remedial / Fail';
          standingBadge.className = 'badge badge-red';
        }
      }
    }

    pctInput?.addEventListener('input', calculate);
    methodSelect?.addEventListener('change', calculate);
    customDiv?.addEventListener('input', calculate);

    calculate();
  })();
</script>
