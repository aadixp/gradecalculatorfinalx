  // -------------------------------------------------------------------------
  // EVENT LISTENERS & SETUP
  // -------------------------------------------------------------------------

  document.addEventListener('DOMContentLoaded', () => {
    loadInitialState();
    renderCourseSelector();
    renderWeightedTable();
    renderGpaTable();
    renderScaleModalTable();

    // Tab & Navigation Switching
    const primaryTabs = document.querySelectorAll('.tabs-header .tab-btn');
    const subnavCards = document.querySelectorAll('.subnav-calc-card');
    const panels = document.querySelectorAll('.calculator-panel');

    const HASH_MAP: Record<string, string> = {
      '#weighted': 'calculator-weighted',
      '#final': 'calculator-final',
      '#gpa': 'calculator-gpa',
      '#indian-cgpa': 'calculator-indian-cgpa',
      '#indian-sgpa': 'calculator-indian-sgpa',
      '#semester-cgpa': 'calculator-semester-cgpa',
      '#cgpa-to-pct': 'calculator-cgpa-to-pct',
      '#target-cgpa': 'calculator-target-cgpa',
      '#target-gpa': 'calculator-target-gpa',
      '#what-if': 'calculator-what-if',
      '#converter': 'calculator-converter'
    };

    const TARGET_TO_HASH: Record<string, string> = {
      'calculator-weighted': '#weighted',
      'calculator-final': '#final',
      'calculator-gpa': '#gpa',
      'calculator-indian-cgpa': '#indian-cgpa',
      'calculator-indian-sgpa': '#indian-sgpa',
      'calculator-semester-cgpa': '#semester-cgpa',
      'calculator-cgpa-to-pct': '#cgpa-to-pct',
      'calculator-target-cgpa': '#target-cgpa',
      'calculator-target-gpa': '#target-gpa',
      'calculator-what-if': '#what-if',
      'calculator-converter': '#converter'
    };

    function switchTab(targetId: string, shouldUpdateHash: boolean = true) {
      // 1. Primary tabs active toggle
      primaryTabs.forEach(t => {
        if (t.getAttribute('data-target') === targetId) {
          t.classList.add('active');
        } else {
          t.classList.remove('active');
        }
      });

      // 2. Secondary subnav cards active toggle
      subnavCards.forEach(c => {
        if (c.getAttribute('data-target') === targetId) {
          c.classList.add('active');
        } else {
          c.classList.remove('active');
        }
      });

      // 3. Panels display toggle
      panels.forEach(p => {
        if (p.id === targetId) {
          (p as HTMLElement).style.display = 'block';
        } else {
          (p as HTMLElement).style.display = 'none';
        }
      });

      // 4. Course profile banner visibility
      const courseBanner = document.getElementById('active-course-banner-wrap');
      if (courseBanner) {
        if (['calculator-weighted', 'calculator-final', 'calculator-gpa'].includes(targetId)) {
          courseBanner.style.display = 'flex';
        } else {
          courseBanner.style.display = 'none';
        }
      }

      // 5. Update browser URL & history
      if (shouldUpdateHash && TARGET_TO_HASH[targetId]) {
        const newHash = TARGET_TO_HASH[targetId];
        if (window.location.hash !== newHash) {
          history.pushState(null, '', newHash);
        }
      }
    }

    function scrollToCalculatorSection() {
      const panelsSection = document.getElementById('main-calculator-section');
      if (!panelsSection) return;

      const navHeight = 64;
      const targetY = panelsSection.getBoundingClientRect().top + window.pageYOffset - navHeight;

      window.scrollTo({
        top: Math.max(0, targetY),
        behavior: 'smooth'
      });
    }

    // Attach click listeners to primary tabs
    primaryTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        if (target) {
          switchTab(target, true);
          scrollToCalculatorSection();
        }
      });
    });

    // Attach click listeners to secondary subnav cards
    subnavCards.forEach(card => {
      card.addEventListener('click', () => {
        const target = card.getAttribute('data-target');
        if (target) {
          switchTab(target, true);
          scrollToCalculatorSection();
        }
      });
    });

    // Synchronize tab state with current window.location.hash
    function syncFromHash() {
      const currentHash = window.location.hash;
      const target = HASH_MAP[currentHash];
      if (target) {
        switchTab(target, false);
      } else {
        switchTab('calculator-weighted', false);
      }
    }

    // Hash change & popstate listener for back/forward navigation
    window.addEventListener('hashchange', syncFromHash);
    window.addEventListener('popstate', syncFromHash);

    // Initial check on page load
    syncFromHash();

    // Footer nav links
    document.querySelectorAll('.footer-nav-link').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const tabKey = (link as HTMLElement).dataset.tab;
        if (tabKey === 'weighted') switchTab('calculator-weighted', true);
        if (tabKey === 'final') switchTab('calculator-final', true);
        if (tabKey === 'gpa') switchTab('calculator-gpa', true);
        scrollToCalculatorSection();
      });
    });

    // Jump to Final Exam button inside Weighted Calculator
    document.getElementById('jump-to-final-btn')?.addEventListener('click', () => {
      switchTab('calculator-final', true);
      scrollToCalculatorSection();
    });

    // Course Selector Change
    document.getElementById('course-selector')?.addEventListener('change', (e) => {
      const sel = e.target as HTMLSelectElement;
      activeCourseId = sel.value;
      saveToLocalStorage();
      renderCourseSelector();
      renderWeightedTable();
      renderGpaTable();
    });

    // Global Course Change / Creation Listener
    window.addEventListener('gradecalc:course-changed', () => {
      loadInitialState();
      renderCourseSelector();
      renderWeightedTable();
      renderGpaTable();
    });

    // Mode Toggle (Percent vs Points)
    document.getElementById('mode-pct-btn')?.addEventListener('click', () => {
      getActiveCourse().inputMode = 'percentage';
      saveToLocalStorage();
      renderWeightedTable();
    });

    document.getElementById('mode-pts-btn')?.addEventListener('click', () => {
      getActiveCourse().inputMode = 'points';
      saveToLocalStorage();
      renderWeightedTable();
    });

    // Add Assignment Row
    document.getElementById('add-assignment-row-btn')?.addEventListener('click', () => {
      const course = getActiveCourse();
      course.assignments.push({
        id: uid(),
        name: '',
        score: null,
        maxPoints: null,
        weight: 0,
        dropLowest: false
      });
      saveToLocalStorage();
      renderWeightedTable();
    });

    // Clear All Assignments
    document.getElementById('clear-assignments-btn')?.addEventListener('click', () => {
      if (confirm('Clear all assignment rows for this course?')) {
        getActiveCourse().assignments = [];
        saveToLocalStorage();
        renderWeightedTable();
      }
    });

    // Auto-scale weights to 100%
    document.getElementById('normalize-weights-btn')?.addEventListener('click', () => {
      const course = getActiveCourse();
      const currentSum = course.assignments.reduce((sum, a) => sum + (a.weight || 0), 0);
      if (currentSum > 0) {
        course.assignments.forEach(a => {
          a.weight = parseFloat(((a.weight / currentSum) * 100).toFixed(1));
        });
        saveToLocalStorage();
        renderWeightedTable();
      }
    });

    // Syllabus Preset Selection
    document.getElementById('syllabus-preset-select')?.addEventListener('change', (e) => {
      const sel = e.target as HTMLSelectElement;
      const val = sel.value;
      const course = getActiveCourse();

      if (val === 'college-standard') {
        course.assignments = [
          { id: uid(), name: 'Homework & Assignments', score: null, maxPoints: 100, weight: 20, dropLowest: false },
          { id: uid(), name: 'Midterm Examination', score: null, maxPoints: 100, weight: 25, dropLowest: false },
          { id: uid(), name: 'Term Project', score: null, maxPoints: 100, weight: 25, dropLowest: false },
          { id: uid(), name: 'Final Examination', score: null, maxPoints: 100, weight: 30, dropLowest: false }
        ];
      } else if (val === 'stem-lab') {
        course.assignments = [
          { id: uid(), name: 'Weekly Lab Reports', score: null, maxPoints: 100, weight: 30, dropLowest: true },
          { id: uid(), name: 'Quizzes & Problem Sets', score: null, maxPoints: 100, weight: 15, dropLowest: false },
          { id: uid(), name: 'Midterm 1', score: null, maxPoints: 100, weight: 12.5, dropLowest: false },
          { id: uid(), name: 'Midterm 2', score: null, maxPoints: 100, weight: 12.5, dropLowest: false },
          { id: uid(), name: 'Comprehensive Final', score: null, maxPoints: 100, weight: 30, dropLowest: false }
        ];
      } else if (val === 'highschool') {
        course.assignments = [
          { id: uid(), name: 'Unit Chapter Tests', score: null, maxPoints: 100, weight: 40, dropLowest: false },
          { id: uid(), name: 'Pop Quizzes', score: null, maxPoints: 100, weight: 25, dropLowest: true },
          { id: uid(), name: 'Homework & Classwork', score: null, maxPoints: 100, weight: 20, dropLowest: false },
          { id: uid(), name: 'Engagement & Participation', score: null, maxPoints: 100, weight: 15, dropLowest: false }
        ];
      } else if (val === 'equal-four') {
        course.assignments = [
          { id: uid(), name: 'Quarter 1', score: null, maxPoints: 100, weight: 25, dropLowest: false },
          { id: uid(), name: 'Quarter 2', score: null, maxPoints: 100, weight: 25, dropLowest: false },
          { id: uid(), name: 'Quarter 3', score: null, maxPoints: 100, weight: 25, dropLowest: false },
          { id: uid(), name: 'Quarter 4', score: null, maxPoints: 100, weight: 25, dropLowest: false }
        ];
      }

      sel.value = '';
      saveToLocalStorage();
      renderWeightedTable();
    });

    // Delegate Table Inputs (Weighted)
    const wContainer = document.getElementById('weighted-rows-container');
    wContainer?.addEventListener('input', (e) => {
      const target = e.target as HTMLElement;
      const course = getActiveCourse();
      const id = target.getAttribute('data-id');
      if (!id) return;

      const assignment = course.assignments.find(a => a.id === id);
      if (!assignment) return;

      if (target.classList.contains('assign-name-input')) {
        assignment.name = (target as HTMLInputElement).value;
      } else if (target.classList.contains('assign-score-input')) {
        const v = (target as HTMLInputElement).value;
        assignment.score = v === '' ? null : parseFloat(v);
      } else if (target.classList.contains('assign-max-input')) {
        const v = (target as HTMLInputElement).value;
        assignment.maxPoints = v === '' ? 100 : parseFloat(v);
      } else if (target.classList.contains('assign-weight-input')) {
        assignment.weight = parseFloat((target as HTMLInputElement).value) || 0;
      }

      calculateWeightedGrade();
      saveToLocalStorage();
    });

    wContainer?.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      const course = getActiveCourse();
      const id = target.getAttribute('data-id');
      if (!id) return;

      const assignment = course.assignments.find(a => a.id === id);
      if (!assignment) return;

      if (target.classList.contains('assign-drop-input')) {
        assignment.dropLowest = (target as HTMLInputElement).checked;
        calculateWeightedGrade();
        saveToLocalStorage();
      }
    });

    wContainer?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.delete-assign-btn');
      if (!btn) return;
      const id = btn.getAttribute('data-id');
      if (!id) return;

      const course = getActiveCourse();
      course.assignments = course.assignments.filter(a => a.id !== id);
      saveToLocalStorage();
      renderWeightedTable();
    });

    // What-If Simulator Inputs
    document.getElementById('whatif-score-slider')?.addEventListener('input', () => {
      calculateWeightedGrade();
    });
    document.getElementById('whatif-weight')?.addEventListener('input', () => {
      calculateWeightedGrade();
    });
    document.getElementById('toggle-whatif-btn')?.addEventListener('click', () => {
      const controls = document.getElementById('whatif-controls');
      if (controls) {
        controls.style.display = controls.style.display === 'none' ? 'grid' : 'none';
      }
    });

    // Final Exam Inputs
    ['fe-current-grade', 'fe-target-grade', 'fe-weight'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', () => {
        calculateFinalExam();
      });
    });

    document.getElementById('fe-target-quickpick')?.addEventListener('change', (e) => {
      const sel = e.target as HTMLSelectElement;
      if (sel.value) {
        const targetInput = document.getElementById('fe-target-grade') as HTMLInputElement | null;
        if (targetInput) {
          targetInput.value = sel.value;
          calculateFinalExam();
        }
      }
    });

    // GPA Table Delegations
    const gpaContainer = document.getElementById('gpa-rows-container');
    gpaContainer?.addEventListener('input', (e) => {
      const target = e.target as HTMLElement;
      const course = getActiveCourse();
      const id = target.getAttribute('data-id');
      if (!id) return;

      const c = course.gpaCourses.find(x => x.id === id);
      if (!c) return;

      if (target.classList.contains('gpa-title-input')) {
        c.title = (target as HTMLInputElement).value;
      } else if (target.classList.contains('gpa-credits-input')) {
        c.credits = parseFloat((target as HTMLInputElement).value) || 0;
      }

      calculateGpa();
      saveToLocalStorage();
    });

    gpaContainer?.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      const course = getActiveCourse();
      const id = target.getAttribute('data-id');
      if (!id) return;

      const c = course.gpaCourses.find(x => x.id === id);
      if (!c) return;

      if (target.classList.contains('gpa-grade-select')) {
        c.grade = (target as HTMLSelectElement).value;
      } else if (target.classList.contains('gpa-type-select')) {
        c.type = (target as HTMLSelectElement).value as any;
      }

      calculateGpa();
      saveToLocalStorage();
    });

    gpaContainer?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.delete-gpa-btn');
      if (!btn) return;
      const id = btn.getAttribute('data-id');
      if (!id) return;

      const course = getActiveCourse();
      course.gpaCourses = course.gpaCourses.filter(x => x.id !== id);
      saveToLocalStorage();
      renderGpaTable();
    });

    // Add Course row (GPA)
    document.getElementById('add-course-row-btn')?.addEventListener('click', () => {
      const course = getActiveCourse();
      course.gpaCourses.push({
        id: uid(),
        title: '',
        grade: '',
        credits: 0,
        type: 'standard'
      });
      saveToLocalStorage();
      renderGpaTable();
    });

    // Clear All GPA courses
    document.getElementById('clear-courses-btn')?.addEventListener('click', () => {
      if (confirm('Clear all course entries?')) {
        getActiveCourse().gpaCourses = [];
        saveToLocalStorage();
        renderGpaTable();
      }
    });

    // Load Sample Semester
    document.getElementById('gpa-sample-btn')?.addEventListener('click', () => {
      const course = getActiveCourse();
      course.gpaCourses = [
        { id: uid(), title: 'Organic Chemistry', grade: 'A-', credits: 4, type: 'standard' },
        { id: uid(), title: 'Calculus III', grade: 'B+', credits: 4, type: 'honors' },
        { id: uid(), title: 'Academic Writing & Rhetoric', grade: 'A', credits: 3, type: 'standard' },
        { id: uid(), title: 'Cell Biology Lab', grade: 'A', credits: 2, type: 'standard' },
        { id: uid(), title: 'Microeconomics', grade: 'A', credits: 3, type: 'ap' }
      ];
      saveToLocalStorage();
      renderGpaTable();
    });

    // Toggle Prior GPA Drawer
    document.getElementById('toggle-prior-gpa-btn')?.addEventListener('click', () => {
      const drawer = document.getElementById('prior-gpa-drawer');
      if (drawer) {
        drawer.style.display = drawer.style.display === 'none' ? 'block' : 'none';
      }
    });

    // Toggle Target GPA Drawer
    document.getElementById('toggle-target-gpa-btn')?.addEventListener('click', () => {
      const drawer = document.getElementById('target-gpa-drawer');
      if (drawer) {
        drawer.style.display = drawer.style.display === 'none' ? 'block' : 'none';
      }
    });

    // Prior GPA Inputs
    ['prior-gpa-input', 'prior-credits-input'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', () => {
        calculateGpa();
      });
    });

    // Target Grad GPA Inputs
    ['target-grad-gpa', 'remaining-credits'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', () => {
        calculateGpa();
      });
    });

    // -----------------------------------------------------------------------
    // Scale Modal Event Handlers
    // -----------------------------------------------------------------------
    const modal = document.getElementById('grade-scale-modal');
    const openModalBtn = document.getElementById('open-scale-modal-btn');
    const closeModalBtn = document.getElementById('close-scale-modal');
    const cancelModalBtn = document.getElementById('cancel-scale-btn');
    const activeScaleTag = document.getElementById('active-scale-tag');

    function openScaleModal() {
      modal?.classList.add('open');
    }
    function closeScaleModal() {
      modal?.classList.remove('open');
    }

    openModalBtn?.addEventListener('click', openScaleModal);
    activeScaleTag?.addEventListener('click', openScaleModal);
    closeModalBtn?.addEventListener('click', closeScaleModal);
    cancelModalBtn?.addEventListener('click', closeScaleModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeScaleModal();
    });

    // Switch Preset Scale
    document.querySelectorAll('.preset-scale-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (preset && PRESET_SCALES[preset]) {
          currentPresetKey = preset;
          activeScale = JSON.parse(JSON.stringify(PRESET_SCALES[preset]));
          document.querySelectorAll('.preset-scale-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          saveToLocalStorage();
          renderScaleModalTable();
          calculateWeightedGrade();
          renderGpaTable();
        }
      });
    });

    // Reset Scale
    document.getElementById('reset-scale-btn')?.addEventListener('click', () => {
      currentPresetKey = 'standard';
      activeScale = JSON.parse(JSON.stringify(PRESET_SCALES.standard));
      saveToLocalStorage();
      renderScaleModalTable();
      calculateWeightedGrade();
      renderGpaTable();
    });

    // Custom Scale Cutoff Change
    document.getElementById('scale-table-body')?.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.classList.contains('scale-min-input')) {
        const idx = parseInt(target.getAttribute('data-idx') || '-1', 10);
        if (idx >= 0 && activeScale[idx]) {
          activeScale[idx].min = parseFloat(target.value) || 0;
          currentPresetKey = 'custom';
          saveToLocalStorage();
          calculateWeightedGrade();
          renderGpaTable();
        }
      }
    });

    // Share State Button
    document.getElementById('share-state-btn')?.addEventListener('click', () => {
      const current = getActiveCourse();
      const payload = {
        name: current.name,
        inputMode: current.inputMode,
        assignments: current.assignments,
        whatIfWeight: current.whatIfWeight,
        whatIfScore: current.whatIfScore,
        finalExam: current.finalExam
      };

      const serialized = btoa(unescape(encodeURIComponent(JSON.stringify(payload))));
      const shareUrl = `${window.location.origin}${window.location.pathname}#data=${serialized}`;

      navigator.clipboard.writeText(shareUrl).then(() => {
        const shareText = document.querySelector('.share-btn-text');
        if (shareText) {
          const orig = shareText.textContent;
          shareText.textContent = 'Copied!';
          setTimeout(() => {
            shareText.textContent = orig;
          }, 2000);
        }
      }).catch(() => {
        prompt('Copy this shareable link:', shareUrl);
      });
    });
  });
</script>

