---
// src/components/MainPage.astro
import Layout from '../layouts/Layout.astro';
import WeightedCalculator from './WeightedCalculator.astro';
import FinalExamCalculator from './FinalExamCalculator.astro';
import GpaCalculator from './GpaCalculator.astro';
import IndianCgpaCalculator from './IndianCgpaCalculator.astro';
import IndianSgpaCalculator from './IndianSgpaCalculator.astro';
import SemesterCgpaCalculator from './SemesterCgpaCalculator.astro';
import CgpaToPercentageCalculator from './CgpaToPercentageCalculator.astro';
import TargetCgpaCalculator from './TargetCgpaCalculator.astro';
import TargetGpaCalculator from './TargetGpaCalculator.astro';
import WhatIfCalculator from './WhatIfCalculator.astro';
import GradeConverter from './GradeConverter.astro';
import GradeScaleModal from './GradeScaleModal.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const homepageFaqs = [
  {
    question: "How does a what if grade calculator work?",
    answer: "A what if grade calculator allows you to test hypothetical scores on upcoming tests, homework assignments, or projects to see how they will impact your overall course percentage before receiving your final grades."
  },
  {
    question: "What grade was I in year calculator?",
    answer: "A what grade was I in year calculator determines what school grade level you were in during any specific academic calendar year by calculating backwards from your high school graduation year or forwards from kindergarten."
  },
  {
    question: "How does what is my grade calculator determine my score?",
    answer: "A what is my grade calculator computes your current cumulative grade percentage by multiplying every completed assignment score by its category weight and dividing by the total active weight percentage."
  },
  {
    question: "How to use whats my grade calculator?",
    answer: "Using our whats my grade calculator is simple: enter your assignment scores and syllabus category weights (e.g. homework 20%, midterms 30%, labs 20%) to view your current class standing and GPA."
  },
  {
    question: "How much will my grade drop calculator: What if I fail an exam?",
    answer: "Our how much will my grade drop calculator computes the exact decrease in your course mark based on the exam's syllabus weight: Drop = (Current Grade - New Score) * (Weight / 100)."
  },
  {
    question: "How does a what will my grade be calculator forecast final marks?",
    answer: "A what will my grade be calculator projects your final course grade by combining your completed assignment marks with projected scores on remaining exams and semester assignments."
  },
  {
    question: "How does a what grade do i need calculator find target scores?",
    answer: "A what grade do i need calculator determines the exact minimum score you must achieve on an upcoming test or assignment to reach or maintain your desired overall class percentage."
  },
  {
    question: "How to use the what grade do i need on my final calculator?",
    answer: "Our what grade do i need on my final calculator uses the formula: Required Score = (Target Grade - Current Grade * (1 - Final Weight)) / Final Weight to show the exact exam score required for every letter grade."
  },
  {
    question: "How does a what is my final grade calculator calculate the end mark?",
    answer: "A what is my final grade calculator calculates your finalized course mark after all coursework, midterms, and final exam results are entered, mapping your overall score to a letter grade."
  },
  {
    question: "Can a what would my grade be calculator simulate different scores?",
    answer: "Yes, our what would my grade be calculator lets you test multiple scenarios, such as scoring 85% versus 95% on a midterm, to see the resulting class letter grade in real time."
  },
  {
    question: "How much would my grade drop calculator: How do low quiz scores impact standing?",
    answer: "A how much would my grade drop calculator shows the reduction in your total class standing from low quiz scores, factoring in any drop-lowest policies active on your syllabus."
  },
  {
    question: "How much will my grade go up calculator: How do high scores raise your mark?",
    answer: "A how much will my grade go up calculator measures how high scores or extra credit improve your average: Increase = (New Score - Current Grade) * (Assignment Weight / Total Active Weight)."
  },
  {
    question: "How to use the grade what if calculator slider?",
    answer: "Use the grade what if calculator slider to adjust hypothetical score percentages and weights, instantly observing the simulated impact on your class grade."
  },
  {
    question: "How does a what grade will i get calculator predict my letter grade?",
    answer: "A what grade will i get calculator compares your earned points and remaining syllabus weight against your school's grading scale (Standard US 4.0, 10-Point Simple, or custom thresholds)."
  },
  {
    question: "How to use the what will my grade be after this test calculator?",
    answer: "Our what will my grade be after this test calculator combines your current standing with your expected test score and the test's weight to show your new class average immediately."
  },
  {
    question: "How much will my grade go down calculator: What happens with missed assignments?",
    answer: "A how much will my grade go down calculator calculates the exact percentage decrease caused by missing assignments, late penalties, or zero scores."
  },
  {
    question: "How does the what if final grade calculator work?",
    answer: "A what if final grade calculator tests multiple final exam score scenarios (such as 70%, 80%, 90%) and displays the resulting overall class grade in an interactive scenario matrix."
  }
];
---

<Layout
  title={t('site.title')}
  description={t('site.description')}
  lang={lang}
  breadcrumbs={[{ name: 'Home', item: '/' }]}
  faqSchema={homepageFaqs}
>
  <!-- Hero Section with Vercel Mesh Glow -->
  <section style="position: relative; padding: 3rem 0 2.5rem; text-align: center;">
    <div class="hero-glow-wrap">
      <div class="hero-mesh"></div>
    </div>

    <div class="container" style="position: relative; z-index: 1;">
      <div style="margin-bottom: 0.75rem;">
        <span class="mono-eyebrow">
          <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--color-blue);"></span>
          {t('hero.badge')} &bull; V2.0
        </span>
      </div>

      <h1 class="display-xl" style="max-width: 860px; margin: 0 auto 1rem; color: var(--color-ink);">
        {t('hero.title')}
      </h1>

      <p style="font-size: clamp(1rem, 2vw, 1.125rem); color: var(--color-body); max-width: 680px; margin: 0 auto 2rem; line-height: 1.6;">
        {t('hero.subtitle')}
      </p>

      <!-- Mode Switcher Tabs -->
      <div style="display: flex; justify-content: center; margin-bottom: 2rem;">
        <div class="tabs-header">
          <button type="button" class="tab-btn active" data-target="calculator-weighted" id="tab-weighted-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
            <span class="tab-label-full">{t('tab.weighted')}</span>
            <span class="tab-label-short">Weighted</span>
          </button>

          <button type="button" class="tab-btn" data-target="calculator-final" id="tab-final-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 14 14"></polyline>
            </svg>
            <span class="tab-label-full">{t('tab.finalExam')}</span>
            <span class="tab-label-short">Final Exam</span>
          </button>

          <button type="button" class="tab-btn" data-target="calculator-gpa" id="tab-gpa-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
            <span class="tab-label-full">{t('tab.gpa')}</span>
            <span class="tab-label-short">GPA</span>
          </button>
        </div>
      </div>

      <!-- Secondary Academic Calculators Suite -->
      <div class="subnav-calc-section">
        <div class="subnav-calc-columns">
          <!-- Category 1: Indian Grading & CBCS -->
          <div class="subnav-calc-group">
            <div class="subnav-calc-header">
              <span class="subnav-calc-title">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
                Indian Grading &amp; CBCS
              </span>
              <a href="/indian-cgpa-calculator" class="btn-ghost" style="font-size: 0.6875rem; color: var(--color-mute); text-decoration: none;" title="View Indian grading guide">Guide &rarr;</a>
            </div>
            <div class="subnav-calc-grid">
              <button type="button" class="subnav-calc-card" data-target="calculator-indian-cgpa" id="subnav-indian-cgpa-btn">
                <div class="subnav-card-icon">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                  </svg>
                </div>
                <div class="subnav-card-content">
                  <span class="subnav-card-label">Indian CGPA</span>
                  <span class="subnav-card-desc">UGC 10.0 Scale</span>
                </div>
              </button>

              <button type="button" class="subnav-calc-card" data-target="calculator-indian-sgpa" id="subnav-indian-sgpa-btn">
                <div class="subnav-card-icon">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                </div>
                <div class="subnav-card-content">
                  <span class="subnav-card-label">Indian SGPA</span>
                  <span class="subnav-card-desc">Semester Term</span>
                </div>
              </button>

              <button type="button" class="subnav-calc-card" data-target="calculator-semester-cgpa" id="subnav-semester-cgpa-btn">
                <div class="subnav-card-icon">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                  </svg>
                </div>
                <div class="subnav-card-content">
                  <span class="subnav-card-label">Semesters 1-8</span>
                  <span class="subnav-card-desc">Multi-Term CGPA</span>
                </div>
              </button>

              <button type="button" class="subnav-calc-card" data-target="calculator-cgpa-to-pct" id="subnav-cgpa-to-pct-btn">
                <div class="subnav-card-icon">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="17 1 21 5 17 9"></polyline>
                    <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                    <polyline points="7 23 3 19 7 15"></polyline>
                    <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
                  </svg>
                </div>
                <div class="subnav-card-content">
                  <span class="subnav-card-label">CGPA &harr; %</span>
                  <span class="subnav-card-desc">AICTE / VTU</span>
                </div>
              </button>
            </div>
          </div>

          <!-- Category 2: Planning & Tools -->
          <div class="subnav-calc-group">
            <div class="subnav-calc-header">
              <span class="subnav-calc-title">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 14 14"></polyline>
                </svg>
                Planning &amp; Tools
              </span>
              <a href="/target-cgpa-calculator" class="btn-ghost" style="font-size: 0.6875rem; color: var(--color-mute); text-decoration: none;" title="View goal planning tools">Planner &rarr;</a>
            </div>
            <div class="subnav-calc-grid">
              <button type="button" class="subnav-calc-card" data-target="calculator-target-cgpa" id="subnav-target-cgpa-btn">
                <div class="subnav-card-icon">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="22" y1="12" x2="18" y2="12"></line>
                    <line x1="6" y1="12" x2="2" y2="12"></line>
                    <line x1="12" y1="6" x2="12" y2="2"></line>
                    <line x1="12" y1="22" x2="12" y2="18"></line>
                  </svg>
                </div>
                <div class="subnav-card-content">
                  <span class="subnav-card-label">Target CGPA</span>
                  <span class="subnav-card-desc">Required Future SGPA</span>
                </div>
              </button>

              <button type="button" class="subnav-calc-card" data-target="calculator-target-gpa" id="subnav-target-gpa-btn">
                <div class="subnav-card-icon">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                    <polyline points="17 6 23 6 23 12"></polyline>
                  </svg>
                </div>
                <div class="subnav-card-content">
                  <span class="subnav-card-label">Target GPA</span>
                  <span class="subnav-card-desc">US 4.0 &amp; 5.0</span>
                </div>
              </button>

              <button type="button" class="subnav-calc-card" data-target="calculator-what-if" id="subnav-what-if-btn">
                <div class="subnav-card-icon">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="21" x2="4" y2="14"></line>
                    <line x1="4" y1="10" x2="4" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12" y2="3"></line>
                    <line x1="20" y1="21" x2="20" y2="16"></line>
                    <line x1="20" y1="12" x2="20" y2="3"></line>
                    <line x1="1" y1="14" x2="7" y2="14"></line>
                    <line x1="9" y1="8" x2="15" y2="8"></line>
                    <line x1="17" y1="16" x2="23" y2="16"></line>
                  </svg>
                </div>
                <div class="subnav-card-content">
                  <span class="subnav-card-label">What-If Sim</span>
                  <span class="subnav-card-desc">Forecast Grades</span>
                </div>
              </button>

              <button type="button" class="subnav-calc-card" data-target="calculator-converter" id="subnav-converter-btn">
                <div class="subnav-card-icon">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="3" y1="15" x2="21" y2="15"></line>
                    <line x1="9" y1="3" x2="9" y2="21"></line>
                    <line x1="15" y1="3" x2="15" y2="21"></line>
                  </svg>
                </div>
                <div class="subnav-card-content">
                  <span class="subnav-card-label">Scale Matrix</span>
                  <span class="subnav-card-desc">Cross-Equivalence</span>
                </div>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Calculator Panels Container -->
  <section id="main-calculator-section" class="container" style="max-width: 1040px; margin-bottom: 4rem;">
    <!-- Active Course Indicator Banner -->
    <div id="active-course-banner-wrap" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; font-size: 0.8125rem; color: var(--color-mute);">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span>Current Profile:</span>
        <strong id="active-profile-tag" style="color: var(--color-ink); font-weight: 600;">Math 101</strong>
        <span class="badge badge-blue" id="active-scale-tag" style="cursor: pointer;" title="Click to view/change grading scale">Standard US (4.0)</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span id="save-status-indicator" style="display: flex; align-items: center; gap: 0.35rem; color: var(--color-emerald); font-family: var(--font-mono); font-size: 0.75rem;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Autosaved
        </span>
      </div>
    </div>

    <!-- The 3 Core Calculators -->
    <WeightedCalculator />
    <FinalExamCalculator />
    <GpaCalculator />

    <!-- Indian & Planning Calculators -->
    <div id="calculator-indian-cgpa" class="calculator-panel" style="display: none;">
      <IndianCgpaCalculator idPrefix="home-cgpa" />
    </div>
    <div id="calculator-indian-sgpa" class="calculator-panel" style="display: none;">
      <IndianSgpaCalculator idPrefix="home-sgpa" />
    </div>
    <div id="calculator-semester-cgpa" class="calculator-panel" style="display: none;">
      <SemesterCgpaCalculator idPrefix="home-semcgpa" />
    </div>
    <div id="calculator-cgpa-to-pct" class="calculator-panel" style="display: none;">
      <CgpaToPercentageCalculator idPrefix="home-cgpa2pct" />
    </div>
    <div id="calculator-target-cgpa" class="calculator-panel" style="display: none;">
      <TargetCgpaCalculator idPrefix="home-targetcgpa" />
    </div>
    <div id="calculator-target-gpa" class="calculator-panel" style="display: none;">
      <TargetGpaCalculator idPrefix="home-targetgpa" />
    </div>
    <div id="calculator-what-if" class="calculator-panel" style="display: none;">
      <WhatIfCalculator idPrefix="home-whatif" />
    </div>
    <div id="calculator-converter" class="calculator-panel" style="display: none;">
      <GradeConverter idPrefix="home-converter" />
    </div>
  </section>

  <!-- Educational & Feature Cards Section -->
  <section class="container" style="max-width: 1040px; margin-bottom: 4rem;">
    <div style="text-align: center; margin-bottom: 2rem;">
      <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.25rem;">Academic Guide & Tips</span>
      <h2 class="heading-lg" style="margin-top: 0.25rem;">How Weighted Grading Works</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
      <div class="geist-card" style="padding: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
          <div style="width: 28px; height: 28px; border-radius: var(--radius-sm); background: var(--color-canvas-subtle); display: flex; align-items: center; justify-content: center; font-weight: 700; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-ink); border: 1px solid var(--color-hairline);">1</div>
          <h3 style="font-size: 1rem; font-weight: 600; color: var(--color-ink);">Multiply Score by Weight</h3>
        </div>
        <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.5;">
          Each category (homework, quizzes, exams) carries a fraction of your total grade. If midterms are 30% and you score 90%, you earn 27.0 weighted percentage points toward your total.
        </p>
      </div>

      <div class="geist-card" style="padding: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
          <div style="width: 28px; height: 28px; border-radius: var(--radius-sm); background: var(--color-canvas-subtle); display: flex; align-items: center; justify-content: center; font-weight: 700; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-ink); border: 1px solid var(--color-hairline);">2</div>
          <h3 style="font-size: 1rem; font-weight: 600; color: var(--color-ink);">Sum & Normalize</h3>
        </div>
        <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.5;">
          Sum all earned weighted points and divide by the total active weight. If the semester is still ongoing and only 70% of assignments are completed, our calculator auto-normalizes your grade to show your true current standing.
        </p>
      </div>

      <div class="geist-card" style="padding: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
          <div style="width: 28px; height: 28px; border-radius: var(--radius-sm); background: var(--color-canvas-subtle); display: flex; align-items: center; justify-content: center; font-weight: 700; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-ink); border: 1px solid var(--color-hairline);">3</div>
          <h3 style="font-size: 1rem; font-weight: 600; color: var(--color-ink);">Strategic Exam Preparation</h3>
        </div>
        <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.5;">
          Use the Final Exam Target Planner to calculate the exact minimum mark you need to retain or raise your letter grade. Stop guessing and focus your study energy where it moves the needle most.
        </p>
      </div>
    </div>
  </section>

  <!-- Authoritative SEO Content & Academic Guide Section -->
  <section class="container" style="max-width: 1040px; margin-bottom: 3rem;">
    <article class="geist-card seo-article-card" style="padding: 2.25rem 2rem; line-height: 1.7; color: var(--color-body);">
      
      <!-- Collapsible Article Body with 100% Crawlable DOM Content -->
      <div id="seo-content-collapse" class="seo-content-collapsed">
        <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 1.5rem;">
          <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.35rem;">Comprehensive Academic Guide</span>
          <h2 class="heading-lg" style="color: var(--color-ink); margin-top: 0.25rem; font-size: 1.75rem;">
            Grade Calculator Final: How to Calculate Your Overall, Weighted, and Final Exam Grades
          </h2>
          <p style="font-size: 0.9375rem; color: var(--color-mute); margin-top: 0.5rem;">
            Everything you need to know about calculating weighted coursework, predicting test scores, and reaching your target semester GPA with GradeCalculatorFinalX.
          </p>
        </header>

        <div style="display: flex; flex-direction: column; gap: 2rem;">
          <!-- Section 1: Intro -->
          <div>
            <h3 class="heading-md" style="color: var(--color-ink); margin-bottom: 0.75rem; font-size: 1.25rem;">
              What is a Grade Calculator Final and How Does It Work?
            </h3>
            <p style="margin-bottom: 1rem;">
              Staying on top of your academic performance requires knowing exactly where you stand before finals week arrives. A <strong>grade calculator final</strong> is an essential academic utility designed to remove the guesswork from your coursework. Whether you are enrolled in high school, college, or graduate school, understanding your current standings enables you to prioritize study hours, prevent unexpected score drops, and finish the term with confidence.
            </p>
            <p>
              At <strong>Grade Calculator FinalX</strong> (gradecalculatorfinalx.com), our platform combines an intuitive <strong>grade calculator</strong> with an accurate <strong>final grade calculator</strong>. Instead of juggling complex mathematical formulas on scrap paper or dealing with confusing spreadsheets, this <strong>easy grade calculator</strong> processes your syllabus weights, scores, and exam targets in real time.
