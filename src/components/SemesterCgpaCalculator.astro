---
// src/components/SemesterCgpaCalculator.astro
interface Props {
  idPrefix?: string;
}
const { idPrefix = 'semcgpa' } = Astro.props;
---

<div id={`${idPrefix}-calculator-panel`} class="calc-component-root">
  <!-- Live Cumulative Result Card -->
  <div class="geist-card geist-card-floating" style="padding: 1.5rem; margin-bottom: 1.5rem; background: linear-gradient(180deg, var(--color-canvas-elevated) 0%, var(--color-canvas-subtle) 100%);">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.25rem; align-items: center;">
      <div>
        <span class="mono-eyebrow" style="color: var(--color-violet); margin-bottom: 0.25rem;">Multi-Semester Cumulative CGPA</span>
        <div style="display: flex; align-items: baseline; gap: 0.75rem;">
          <span id={`${idPrefix}-result-cgpa`} class="display-xl" style="font-feature-settings: 'tnum';">--</span>
          <span id={`${idPrefix}-standing-badge`} class="badge badge-blue">Ready</span>
        </div>
        <p style="font-size: 0.875rem; color: var(--color-mute); margin-top: 0.25rem;">
          Approx. Percentage: <strong style="color: var(--color-ink);" id={`${idPrefix}-result-pct`}>--%</strong>
          <span style="font-size: 0.75rem;">(&times; 9.5 Standard)</span>
        </p>
      </div>

      <!-- Credits & Points Breakdown -->
      <div class="responsive-col-divider" style="border-left: 1px solid var(--color-hairline); padding-left: 1.25rem;">
        <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
          <span style="color: var(--color-mute);">Total Cumulative Credits:</span>
          <span id={`${idPrefix}-total-credits`} style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">0</span>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.5rem;">
          <span style="color: var(--color-mute);">Completed Semesters:</span>
          <span id={`${idPrefix}-sem-count`} style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">0</span>
        </div>
        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-mute); background: var(--color-canvas-subtle); padding: 0.35rem 0.5rem; border-radius: var(--radius-xs); border: 1px solid var(--color-hairline);">
          CGPA = &Sigma;(SGPA<sub>i</sub> &times; Credits<sub>i</sub>) &divide; &Sigma;Credits
        </div>
      </div>

      <!-- Actions -->
      <div style="display: flex; flex-direction: column; gap: 0.5rem; justify-content: center;">
        <button id={`${idPrefix}-sample-btn`} type="button" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem;">
          Load 6 Semesters Sample
        </button>
        <button id={`${idPrefix}-reset-btn`} type="button" class="btn btn-ghost" style="font-size: 0.8125rem; color: var(--color-mute);">
          Reset to Blank
        </button>
      </div>
    </div>
  </div>

  <!-- Semesters Table Card -->
  <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem;">
      <div>
        <h3 class="heading-md">Semester Breakdown (1 to 8)</h3>
        <p style="font-size: 0.875rem; color: var(--color-mute);">
          Enter the SGPA and registered credit hours for each completed semester.
        </p>
      </div>

      <button id={`${idPrefix}-add-sem-btn`} type="button" class="btn btn-secondary" style="font-weight: 600; font-size: 0.8125rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add Semester
      </button>
    </div>

    <div class="mobile-table-card-wrap" style="width: 100%; overflow-x: auto; margin-bottom: 1rem;">
      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="border-bottom: 1px solid var(--color-hairline); text-align: left; font-size: 0.8125rem; color: var(--color-mute);">
            <th style="padding: 0.5rem 0.75rem; font-weight: 500;">Semester</th>
            <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 180px;">SGPA (0.00 - 10.00)</th>
            <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 160px;">Semester Credits</th>
            <th style="padding: 0.5rem 0.75rem; font-weight: 500; width: 150px; text-align: right;">Weighted Points</th>
            <th style="padding: 0.5rem 0.75rem; width: 44px;"></th>
          </tr>
        </thead>
        <tbody id={`${idPrefix}-tbody`}>
          <!-- Populated dynamically -->
        </tbody>
      </table>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--color-hairline);">
      <button id={`${idPrefix}-add-sem-bottom-btn`} type="button" class="btn btn-secondary" style="font-weight: 600;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add Another Semester
      </button>

      <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.8125rem;">
        <span style="color: var(--color-mute);">Cumulative Credits: <strong id={`${idPrefix}-footer-credits`} style="color: var(--color-ink); font-family: var(--font-mono);">0</strong></span>
        <span style="color: var(--color-mute);">Cumulative Points: <strong id={`${idPrefix}-footer-points`} style="color: var(--color-ink); font-family: var(--font-mono);">0.0</strong></span>
      </div>
    </div>
  </div>

  <!-- Step by step breakdown -->
  <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem; background: var(--color-canvas-subtle);">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
      <span class="badge badge-violet">Calculation Breakdown</span>
      <h4 class="heading-md" style="font-size: 1rem;">Cumulative Credit-Weighted Progression</h4>
    </div>
    <div id={`${idPrefix}-breakdown-text`} style="font-size: 0.875rem; color: var(--color-body); line-height: 1.6;">
      Enter your semester SGPAs and credit counts to view the weighted progression.
    </div>
  </div>
</div>

<script define:vars={{ idPrefix }}>
  (function() {
    const uid = () => Math.random().toString(36).substring(2, 9);

    const defaultSemesters = [
      { id: uid(), name: 'Semester 1', sgpa: 8.40, credits: 22 },
      { id: uid(), name: 'Semester 2', sgpa: 8.65, credits: 24 },
      { id: uid(), name: 'Semester 3', sgpa: 8.20, credits: 23 },
      { id: uid(), name: 'Semester 4', sgpa: 8.90, credits: 24 },
      { id: uid(), name: 'Semester 5', sgpa: 9.10, credits: 22 },
      { id: uid(), name: 'Semester 6', sgpa: 8.75, credits: 23 },
      { id: uid(), name: 'Semester 7', sgpa: null, credits: null },
      { id: uid(), name: 'Semester 8', sgpa: null, credits: null },
    ];

    let semesters = JSON.parse(JSON.stringify(defaultSemesters));

    const tbody = document.getElementById(`${idPrefix}-tbody`);
    const cgpaEl = document.getElementById(`${idPrefix}-result-cgpa`);
    const pctEl = document.getElementById(`${idPrefix}-result-pct`);
    const standingBadge = document.getElementById(`${idPrefix}-standing-badge`);
    const totalCreditsEl = document.getElementById(`${idPrefix}-total-credits`);
    const semCountEl = document.getElementById(`${idPrefix}-sem-count`);
    const footerCreditsEl = document.getElementById(`${idPrefix}-footer-credits`);
    const footerPointsEl = document.getElementById(`${idPrefix}-footer-points`);
    const breakdownEl = document.getElementById(`${idPrefix}-breakdown-text`);

    function getStanding(cgpa) {
      if (cgpa >= 8.5) return { text: 'First Class with Distinction', class: 'badge-green' };
      if (cgpa >= 6.75) return { text: 'First Class', class: 'badge-blue' };
      if (cgpa >= 5.75) return { text: 'Higher Second Class', class: 'badge-amber' };
      if (cgpa >= 5.0) return { text: 'Second Class', class: 'badge-amber' };
      if (cgpa >= 4.0) return { text: 'Pass Class', class: 'badge-blue' };
      return { text: 'Remedial / Fail', class: 'badge-red' };
    }

    function renderRows() {
      if (!tbody) return;
      tbody.innerHTML = '';

      semesters.forEach((sem, idx) => {
        const tr = document.createElement('tr');
        tr.className = 'mobile-card-row';
        tr.style.borderBottom = '1px solid var(--color-hairline)';

        const pts = (sem.sgpa !== null && sem.credits !== null) ? ((sem.sgpa * sem.credits).toFixed(1)) : '--';

        tr.innerHTML = `
          <td class="td-cgpa-name" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Semester #${idx + 1}</span>
            <input type="text" class="form-input sem-name-input" data-id="${sem.id}" value="${sem.name || `Semester ${idx + 1}`}" placeholder="e.g. Semester 1" />
          </td>
          <td class="td-cgpa-point" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">SGPA</span>
            <input type="number" step="0.01" min="0" max="10" class="form-input form-input-mono sem-sgpa-input" data-id="${sem.id}" value="${sem.sgpa !== null ? sem.sgpa : ''}" placeholder="e.g. 8.50" />
          </td>
          <td class="td-cgpa-credits" style="padding: 0.5rem 0.75rem;">
            <span class="mobile-input-label">Credits</span>
            <input type="number" step="0.5" min="0" max="40" class="form-input form-input-mono sem-credits-input" data-id="${sem.id}" value="${sem.credits !== null ? sem.credits : ''}" placeholder="Credits" />
          </td>
          <td class="td-cgpa-pts-earned" style="padding: 0.5rem 0.75rem; text-align: right; font-family: var(--font-mono); font-weight: 600; color: var(--color-ink);">
            <span class="mobile-input-label">Weighted Points</span>
            <span>${pts}</span>
          </td>
          <td class="td-cgpa-del" style="padding: 0.5rem 0.75rem; text-align: right;">
            <button type="button" class="btn btn-ghost btn-icon delete-sem-btn" data-id="${sem.id}" title="Remove semester" aria-label="Remove semester">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </td>
        `;

        tbody.appendChild(tr);
      });

      calculate();
    }

    function calculate() {
      let totalCredits = 0;
      let totalPoints = 0;
      let completedCount = 0;
      const breakdownRows = [];

      semesters.forEach((s) => {
        const sgpa = s.sgpa !== null && !isNaN(s.sgpa) ? Number(s.sgpa) : null;
        const credits = s.credits !== null && !isNaN(s.credits) ? Number(s.credits) : null;

        if (sgpa !== null && credits !== null && credits > 0) {
          totalCredits += credits;
          const weighted = sgpa * credits;
          totalPoints += weighted;
          completedCount++;
          breakdownRows.push({
            name: s.name,
            sgpa: sgpa,
            credits: credits,
            weighted: weighted
          });
        }
      });

      if (totalCredits > 0) {
        const cgpa = totalPoints / totalCredits;
        const approxPct = (cgpa * 9.5);
        const standing = getStanding(cgpa);

        if (cgpaEl) cgpaEl.textContent = cgpa.toFixed(2);
        if (pctEl) pctEl.textContent = `${approxPct.toFixed(2)}%`;
        if (standingBadge) {
          standingBadge.textContent = standing.text;
          standingBadge.className = `badge ${standing.class}`;
        }
        if (totalCreditsEl) totalCreditsEl.textContent = totalCredits.toFixed(1);
        if (semCountEl) semCountEl.textContent = completedCount.toString();
        if (footerCreditsEl) footerCreditsEl.textContent = totalCredits.toFixed(1);
        if (footerPointsEl) footerPointsEl.textContent = totalPoints.toFixed(1);

        if (breakdownEl) {
          breakdownEl.innerHTML = `
            <p style="margin-bottom: 0.5rem;">
              <strong>Overall CGPA across ${completedCount} semesters</strong> = Total Points (${totalPoints.toFixed(1)}) &divide; Total Credits (${totalCredits.toFixed(1)}) = <strong>${cgpa.toFixed(2)}</strong> / 10.0
            </p>
            <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-mute);">
              Formula: Cumulative CGPA = &Sigma;(SGPA &times; Semester Credits) &divide; &Sigma;(Total Credits)
            </div>
          `;
        }
      } else {
        if (cgpaEl) cgpaEl.textContent = '--';
        if (pctEl) pctEl.textContent = '--%';
        if (standingBadge) {
          standingBadge.textContent = 'Awaiting Input';
          standingBadge.className = 'badge badge-blue';
        }
        if (totalCreditsEl) totalCreditsEl.textContent = '0';
        if (semCountEl) semCountEl.textContent = '0';
        if (footerCreditsEl) footerCreditsEl.textContent = '0';
        if (footerPointsEl) footerPointsEl.textContent = '0.0';
        if (breakdownEl) {
          breakdownEl.textContent = 'Enter your semester SGPAs and credit counts to view the weighted progression.';
        }
      }
    }

    tbody?.addEventListener('input', (e) => {
      const target = e.target;
      const id = target.getAttribute('data-id');
      if (!id) return;
      const s = semesters.find(x => x.id === id);
      if (!s) return;

      if (target.classList.contains('sem-name-input')) {
        s.name = target.value;
      } else if (target.classList.contains('sem-sgpa-input')) {
        s.sgpa = target.value === '' ? null : Math.min(10, Math.max(0, parseFloat(target.value) || 0));
      } else if (target.classList.contains('sem-credits-input')) {
        s.credits = target.value === '' ? null : parseFloat(target.value) || 0;
      }

      const ptsCell = target.closest('tr')?.querySelector('.td-cgpa-pts-earned span:not(.mobile-input-label)');
      if (ptsCell) {
        ptsCell.textContent = (s.sgpa !== null && s.credits !== null) ? ((s.sgpa * s.credits).toFixed(1)) : '--';
      }

      calculate();
    });

    tbody?.addEventListener('click', (e) => {
      const btn = e.target.closest('.delete-sem-btn');
      if (!btn) return;
      const id = btn.getAttribute('data-id');
      if (!id) return;
      semesters = semesters.filter(x => x.id !== id);
      renderRows();
    });

    const addFn = () => {
      semesters.push({
        id: uid(),
        name: `Semester ${semesters.length + 1}`,
        sgpa: null,
        credits: null
      });
      renderRows();
    };
    document.getElementById(`${idPrefix}-add-sem-btn`)?.addEventListener('click', addFn);
    document.getElementById(`${idPrefix}-add-sem-bottom-btn`)?.addEventListener('click', addFn);

    document.getElementById(`${idPrefix}-sample-btn`)?.addEventListener('click', () => {
      semesters = JSON.parse(JSON.stringify(defaultSemesters));
      renderRows();
    });

    document.getElementById(`${idPrefix}-reset-btn`)?.addEventListener('click', () => {
      semesters = Array.from({ length: 8 }, (_, i) => ({
        id: uid(),
        name: `Semester ${i + 1}`,
        sgpa: null,
        credits: null
      }));
      renderRows();
    });

    renderRows();
  })();
</script>
