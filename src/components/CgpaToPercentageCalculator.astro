---
// src/components/CgpaToPercentageCalculator.astro
interface Props {
  idPrefix?: string;
}
const { idPrefix = 'cgpa2pct' } = Astro.props;
---

<div id={`${idPrefix}-calculator-panel`} class="calculator-panel">
  <!-- Live Result Card -->
  <div class="geist-card geist-card-floating" style="padding: 1.75rem; margin-bottom: 1.5rem; background: linear-gradient(180deg, var(--color-canvas-elevated) 0%, var(--color-canvas-subtle) 100%);">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; align-items: center;">
      <div>
        <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.25rem;">Converted Academic Standing</span>
        <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-top: 0.25rem;">
          <span id={`${idPrefix}-result-val`} class="display-xl" style="font-feature-settings: 'tnum';">--%</span>
          <span id={`${idPrefix}-standing-badge`} class="badge badge-green">First Class</span>
        </div>
        <p id={`${idPrefix}-formula-caption`} style="font-size: 0.875rem; color: var(--color-mute); margin-top: 0.5rem; line-height: 1.4;">
          Calculation based on selected university formula.
        </p>
      </div>

      <!-- Quick Comparison Box -->
      <div style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 1.25rem; background: var(--color-canvas-elevated);">
        <h4 style="font-size: 0.875rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.5rem;">Multi-Formula Quick Benchmark</h4>
        <div style="display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.8125rem;">
          <div style="display: flex; justify-content: space-between; color: var(--color-mute);">
            <span>AICTE / CBSE (&times; 9.5):</span>
            <strong id={`${idPrefix}-bench-aicte`} style="color: var(--color-ink); font-family: var(--font-mono);">--%</strong>
          </div>
          <div style="display: flex; justify-content: space-between; color: var(--color-mute);">
            <span>Standard Direct (&times; 10):</span>
            <strong id={`${idPrefix}-bench-direct`} style="color: var(--color-ink); font-family: var(--font-mono);">--%</strong>
          </div>
          <div style="display: flex; justify-content: space-between; color: var(--color-mute);">
            <span>VTU / Mumbai ((CGPA - 0.75) &times; 10):</span>
            <strong id={`${idPrefix}-bench-vtu`} style="color: var(--color-ink); font-family: var(--font-mono);">--%</strong>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Input Parameters Card -->
  <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
    <h3 class="heading-md" style="margin-bottom: 1.25rem;">Conversion Parameters</h3>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; align-items: flex-start;">
      <!-- CGPA Input -->
      <div>
        <label for={`${idPrefix}-cgpa-input`} style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          Cumulative Grade Point Average (CGPA):
        </label>
        <input id={`${idPrefix}-cgpa-input`} type="number" step="0.01" min="0" max="10" class="form-input form-input-mono" value="8.50" placeholder="e.g. 8.50" />
        <span style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.25rem; display: block;">Enter your CGPA on a 10.0 scale (0.00 to 10.00).</span>
      </div>

      <!-- University / Method Preset -->
      <div>
        <label for={`${idPrefix}-method-select`} style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          University Conversion Rule:
        </label>
        <select id={`${idPrefix}-method-select`} class="form-select">
          <option value="aicte" selected>AICTE &amp; CBSE Standard (CGPA &times; 9.5)</option>
          <option value="direct10">Direct 10&times; (e.g. Anna Univ / IITs / NITs) (CGPA &times; 10)</option>
          <option value="vtu">VTU / Mumbai University ((CGPA - 0.75) &times; 10)</option>
          <option value="custom">Custom Formula / Multiplier</option>
        </select>
        <span style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.25rem; display: block;">Select the rule mandated by your university transcript.</span>
      </div>

      <!-- Custom Multiplier (Hidden unless custom selected) -->
      <div id={`${idPrefix}-custom-wrap`} style="display: none;">
        <label for={`${idPrefix}-custom-mult`} style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          Custom Multiplier:
        </label>
        <input id={`${idPrefix}-custom-mult`} type="number" step="0.01" min="1" max="20" class="form-input form-input-mono" value="9.5" placeholder="e.g. 9.5" />
        <span style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.25rem; display: block;">Percentage = CGPA &times; Multiplier.</span>
      </div>
    </div>
  </div>

  <!-- University Disclaimer Notice Callout -->
  <div class="geist-card" style="padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; border-left: 3px solid var(--color-amber); background: var(--color-canvas-subtle);">
    <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="2" style="flex-shrink: 0; margin-top: 0.15rem;">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <div style="font-size: 0.8125rem; line-height: 1.6; color: var(--color-body);">
        <strong style="color: var(--color-ink);">Important Institutional Notice:</strong>
        There is no single universal conversion formula applicable across all Indian institutes and boards. While <strong>AICTE / CBSE (9.5&times;)</strong> is the standard benchmark for government recruitment and corporate applications, colleges like Mumbai University, VTU, Anna University, and certain IITs prescribe their own specific formulas printed on official grade sheets. Always check the reverse side of your official university transcript.
      </div>
    </div>
  </div>

  <!-- Reference Benchmark Table -->
  <div class="geist-card" style="padding: 1.5rem;">
    <h3 class="heading-md" style="margin-bottom: 0.5rem;">Standard CGPA to Percentage Reference Chart</h3>
    <p style="font-size: 0.875rem; color: var(--color-mute); margin-bottom: 1rem;">
      Quick reference across typical Indian 10-point CGPA scores using the AICTE benchmark (&times; 9.5).
    </p>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
        <thead>
          <tr style="background: var(--color-canvas-subtle); border-bottom: 1px solid var(--color-hairline); text-align: left;">
            <th style="padding: 0.5rem 0.75rem;">CGPA</th>
            <th style="padding: 0.5rem 0.75rem;">AICTE / CBSE (9.5&times;)</th>
            <th style="padding: 0.5rem 0.75rem;">Direct (10&times;)</th>
            <th style="padding: 0.5rem 0.75rem;">Mumbai / VTU Formula</th>
            <th style="padding: 0.5rem 0.75rem;">Division / Academic Class</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft); font-family: var(--font-mono);">
            <td style="padding: 0.5rem 0.75rem; font-weight: 600; color: var(--color-ink);">10.0</td>
            <td style="padding: 0.5rem 0.75rem;">95.0%</td>
            <td style="padding: 0.5rem 0.75rem;">100.0%</td>
            <td style="padding: 0.5rem 0.75rem;">92.5%</td>
            <td style="padding: 0.5rem 0.75rem; font-family: var(--font-sans); color: var(--color-emerald); font-weight: 500;">First Class with Distinction</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft); font-family: var(--font-mono);">
            <td style="padding: 0.5rem 0.75rem; font-weight: 600; color: var(--color-ink);">9.5</td>
            <td style="padding: 0.5rem 0.75rem;">90.25%</td>
            <td style="padding: 0.5rem 0.75rem;">95.0%</td>
            <td style="padding: 0.5rem 0.75rem;">87.5%</td>
            <td style="padding: 0.5rem 0.75rem; font-family: var(--font-sans); color: var(--color-emerald); font-weight: 500;">First Class with Distinction</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft); font-family: var(--font-mono);">
            <td style="padding: 0.5rem 0.75rem; font-weight: 600; color: var(--color-ink);">9.0</td>
            <td style="padding: 0.5rem 0.75rem;">85.5%</td>
            <td style="padding: 0.5rem 0.75rem;">90.0%</td>
            <td style="padding: 0.5rem 0.75rem;">82.5%</td>
            <td style="padding: 0.5rem 0.75rem; font-family: var(--font-sans); color: var(--color-emerald); font-weight: 500;">First Class with Distinction</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft); font-family: var(--font-mono);">
            <td style="padding: 0.5rem 0.75rem; font-weight: 600; color: var(--color-ink);">8.5</td>
            <td style="padding: 0.5rem 0.75rem;">80.75%</td>
            <td style="padding: 0.5rem 0.75rem;">85.0%</td>
            <td style="padding: 0.5rem 0.75rem;">77.5%</td>
            <td style="padding: 0.5rem 0.75rem; font-family: var(--font-sans); color: var(--color-emerald); font-weight: 500;">First Class with Distinction</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft); font-family: var(--font-mono);">
            <td style="padding: 0.5rem 0.75rem; font-weight: 600; color: var(--color-ink);">8.0</td>
            <td style="padding: 0.5rem 0.75rem;">76.0%</td>
            <td style="padding: 0.5rem 0.75rem;">80.0%</td>
            <td style="padding: 0.5rem 0.75rem;">72.5%</td>
            <td style="padding: 0.5rem 0.75rem; font-family: var(--font-sans); color: var(--color-blue); font-weight: 500;">First Class</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft); font-family: var(--font-mono);">
            <td style="padding: 0.5rem 0.75rem; font-weight: 600; color: var(--color-ink);">7.5</td>
            <td style="padding: 0.5rem 0.75rem;">71.25%</td>
            <td style="padding: 0.5rem 0.75rem;">75.0%</td>
            <td style="padding: 0.5rem 0.75rem;">67.5%</td>
            <td style="padding: 0.5rem 0.75rem; font-family: var(--font-sans); color: var(--color-blue); font-weight: 500;">First Class</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft); font-family: var(--font-mono);">
            <td style="padding: 0.5rem 0.75rem; font-weight: 600; color: var(--color-ink);">7.0</td>
            <td style="padding: 0.5rem 0.75rem;">66.5%</td>
            <td style="padding: 0.5rem 0.75rem;">70.0%</td>
            <td style="padding: 0.5rem 0.75rem;">62.5%</td>
            <td style="padding: 0.5rem 0.75rem; font-family: var(--font-sans); color: var(--color-blue); font-weight: 500;">First Class</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft); font-family: var(--font-mono);">
            <td style="padding: 0.5rem 0.75rem; font-weight: 600; color: var(--color-ink);">6.5</td>
            <td style="padding: 0.5rem 0.75rem;">61.75%</td>
            <td style="padding: 0.5rem 0.75rem;">65.0%</td>
            <td style="padding: 0.5rem 0.75rem;">57.5%</td>
            <td style="padding: 0.5rem 0.75rem; font-family: var(--font-sans); color: var(--color-amber); font-weight: 500;">Higher Second Class</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft); font-family: var(--font-mono);">
            <td style="padding: 0.5rem 0.75rem; font-weight: 600; color: var(--color-ink);">6.0</td>
            <td style="padding: 0.5rem 0.75rem;">57.0%</td>
            <td style="padding: 0.5rem 0.75rem;">60.0%</td>
            <td style="padding: 0.5rem 0.75rem;">52.5%</td>
            <td style="padding: 0.5rem 0.75rem; font-family: var(--font-sans); color: var(--color-amber); font-weight: 500;">Second Class</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script define:vars={{ idPrefix }}>
  (function() {
    const cgpaInput = document.getElementById(`${idPrefix}-cgpa-input`);
    const methodSelect = document.getElementById(`${idPrefix}-method-select`);
    const customWrap = document.getElementById(`${idPrefix}-custom-wrap`);
    const customMult = document.getElementById(`${idPrefix}-custom-mult`);
    const resultVal = document.getElementById(`${idPrefix}-result-val`);
    const standingBadge = document.getElementById(`${idPrefix}-standing-badge`);
    const captionEl = document.getElementById(`${idPrefix}-formula-caption`);

    const benchAicte = document.getElementById(`${idPrefix}-bench-aicte`);
    const benchDirect = document.getElementById(`${idPrefix}-bench-direct`);
    const benchVtu = document.getElementById(`${idPrefix}-bench-vtu`);

    function calculate() {
      const cgpa = parseFloat(cgpaInput?.value || '0');
      const method = methodSelect?.value || 'aicte';
      const customFactor = parseFloat(customMult?.value || '9.5');

      if (customWrap) {
        customWrap.style.display = method === 'custom' ? 'block' : 'none';
      }

      if (isNaN(cgpa) || cgpa < 0) {
        if (resultVal) resultVal.textContent = '--%';
        return;
      }

      // Benchmarks
      const aictePct = Math.min(100, Math.max(0, cgpa * 9.5));
      const directPct = Math.min(100, Math.max(0, cgpa * 10));
      const vtuPct = Math.min(100, Math.max(0, (cgpa - 0.75) * 10));

      if (benchAicte) benchAicte.textContent = `${aictePct.toFixed(2)}%`;
      if (benchDirect) benchDirect.textContent = `${directPct.toFixed(2)}%`;
      if (benchVtu) benchVtu.textContent = `${Math.max(0, vtuPct).toFixed(2)}%`;

      let selectedPct = aictePct;
      let formulaText = `Percentage = ${cgpa.toFixed(2)} &times; 9.5 (AICTE/CBSE standard benchmark)`;

      if (method === 'direct10') {
        selectedPct = directPct;
        formulaText = `Percentage = ${cgpa.toFixed(2)} &times; 10 (Direct 10-point scale formula)`;
      } else if (method === 'vtu') {
        selectedPct = Math.max(0, vtuPct);
        formulaText = `Percentage = (${cgpa.toFixed(2)} - 0.75) &times; 10 (VTU / Mumbai University rule)`;
      } else if (method === 'custom') {
        selectedPct = Math.min(100, Math.max(0, cgpa * customFactor));
        formulaText = `Percentage = ${cgpa.toFixed(2)} &times; ${customFactor} (Custom multiplier)`;
      }

      if (resultVal) resultVal.textContent = `${selectedPct.toFixed(2)}%`;
      if (captionEl) captionEl.innerHTML = formulaText;

      if (standingBadge) {
        if (selectedPct >= 75) {
          standingBadge.textContent = 'Distinction';
          standingBadge.className = 'badge badge-green';
        } else if (selectedPct >= 60) {
          standingBadge.textContent = 'First Division';
          standingBadge.className = 'badge badge-blue';
        } else if (selectedPct >= 50) {
          standingBadge.textContent = 'Second Division';
          standingBadge.className = 'badge badge-amber';
        } else if (selectedPct >= 40) {
          standingBadge.textContent = 'Pass Class';
          standingBadge.className = 'badge badge-blue';
        } else {
          standingBadge.textContent = 'Remedial / Fail';
          standingBadge.className = 'badge badge-red';
        }
      }
    }

    cgpaInput?.addEventListener('input', calculate);
    methodSelect?.addEventListener('change', calculate);
    customMult?.addEventListener('input', calculate);

    calculate();
  })();
</script>
