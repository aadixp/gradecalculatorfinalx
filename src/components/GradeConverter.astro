---
// src/components/GradeConverter.astro
interface Props {
  idPrefix?: string;
}
const { idPrefix = 'converter' } = Astro.props;
---

<div id={`${idPrefix}-calculator-panel`} class="calc-component-root">
  <!-- Interactive Converter Tool Card -->
  <div class="geist-card geist-card-floating" style="padding: 1.75rem; margin-bottom: 1.5rem; background: linear-gradient(180deg, var(--color-canvas-elevated) 0%, var(--color-canvas-subtle) 100%);">
    <div style="margin-bottom: 1.25rem;">
      <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.25rem;">Global Grade Equivalence</span>
      <h3 class="heading-lg" style="font-size: 1.5rem;">Multi-System Academic Converter</h3>
      <p style="font-size: 0.875rem; color: var(--color-mute); margin-top: 0.25rem;">
        Select an input scale and enter your score to view mathematical equivalents across US 4.0, US 5.0, and Indian UGC 10.0 scales.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.25rem; align-items: flex-end; margin-bottom: 1.5rem;">
      <!-- Source System -->
      <div>
        <label for={`${idPrefix}-src-scale`} style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          Source Grading System:
        </label>
        <select id={`${idPrefix}-src-scale`} class="form-select">
          <option value="indian10" selected>Indian 10.0 CGPA / UGC</option>
          <option value="us4">US 4.0 GPA (Standard)</option>
          <option value="us5">US 5.0 GPA (Honors / AP)</option>
          <option value="percentage">Percentage Marks (0 - 100%)</option>
        </select>
      </div>

      <!-- Source Value -->
      <div>
        <label for={`${idPrefix}-src-val`} style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          Enter Score / Grade:
        </label>
        <input id={`${idPrefix}-src-val`} type="number" step="0.01" min="0" max="100" class="form-input form-input-mono" value="8.50" placeholder="e.g. 8.50" />
      </div>

      <!-- Quick Preset -->
      <div>
        <label for={`${idPrefix}-quick-pick`} style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">
          Grade Quick-Pick:
        </label>
        <select id={`${idPrefix}-quick-pick`} class="form-select">
          <option value="">Select preset...</option>
          <option value="10">O Grade (10.0)</option>
          <option value="9">A+ Grade (9.0)</option>
          <option value="8">A Grade (8.0)</option>
          <option value="7">B+ Grade (7.0)</option>
          <option value="6">B Grade (6.0)</option>
          <option value="5">C Grade (5.0)</option>
          <option value="4">P Pass (4.0)</option>
        </select>
      </div>
    </div>

    <!-- Live Converted Results Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
      <!-- US 4.0 Card -->
      <div style="background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 1.125rem;">
        <span class="mono-eyebrow" style="color: var(--color-blue); font-size: 0.6875rem;">US 4.0 Scale</span>
        <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.25rem;">
          <span id={`${idPrefix}-conv-us4`} class="heading-lg" style="font-size: 1.75rem; font-family: var(--font-mono);">--</span>
          <span id={`${idPrefix}-conv-us4-letter`} class="badge badge-blue">--</span>
        </div>
        <span style="font-size: 0.75rem; color: var(--color-mute); display: block; margin-top: 0.25rem;">Standard unweighted GPA</span>
      </div>

      <!-- US 5.0 Card -->
      <div style="background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 1.125rem;">
        <span class="mono-eyebrow" style="color: var(--color-violet); font-size: 0.6875rem;">US 5.0 Scale</span>
        <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.25rem;">
          <span id={`${idPrefix}-conv-us5`} class="heading-lg" style="font-size: 1.75rem; font-family: var(--font-mono);">--</span>
          <span id={`${idPrefix}-conv-us5-letter`} class="badge badge-green">--</span>
        </div>
        <span style="font-size: 0.75rem; color: var(--color-mute); display: block; margin-top: 0.25rem;">Honors / AP weighted GPA</span>
      </div>

      <!-- Indian 10.0 Card -->
      <div style="background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 1.125rem;">
        <span class="mono-eyebrow" style="color: var(--color-emerald); font-size: 0.6875rem;">Indian 10.0 Scale</span>
        <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.25rem;">
          <span id={`${idPrefix}-conv-in10`} class="heading-lg" style="font-size: 1.75rem; font-family: var(--font-mono);">--</span>
          <span id={`${idPrefix}-conv-in10-grade`} class="badge badge-blue">--</span>
        </div>
        <span style="font-size: 0.75rem; color: var(--color-mute); display: block; margin-top: 0.25rem;">UGC / AICTE CGPA</span>
      </div>

      <!-- Percentage Card -->
      <div style="background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 1.125rem;">
        <span class="mono-eyebrow" style="color: var(--color-cyan); font-size: 0.6875rem;">Percentage &amp; Class</span>
        <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.25rem;">
          <span id={`${idPrefix}-conv-pct`} class="heading-lg" style="font-size: 1.75rem; font-family: var(--font-mono);">--%</span>
        </div>
        <span id={`${idPrefix}-conv-division`} style="font-size: 0.75rem; color: var(--color-body); font-weight: 500; display: block; margin-top: 0.25rem;">--</span>
      </div>
    </div>
  </div>

  <!-- Master Equivalence Table -->
  <div class="geist-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
      <div>
        <h3 class="heading-md">Comprehensive Global Grade Conversion Matrix</h3>
        <p style="font-size: 0.875rem; color: var(--color-mute);">
          Standard academic equivalence chart comparing UGC 10-point scale, US 4.0, US 5.0, and marks percentage bands.
        </p>
      </div>
    </div>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
        <thead>
          <tr style="background: var(--color-canvas-subtle); border-bottom: 1px solid var(--color-hairline); text-align: left;">
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);">Indian Letter Grade</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);">Indian Grade Point</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);">Marks Range (%)</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);">US Letter Grade</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);">US 4.0 GPA</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);">US 5.0 (AP/Honors)</th>
            <th style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-ink);">Academic Performance</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
            <td style="padding: 0.625rem 0.875rem; font-weight: 700; color: var(--color-ink);">O</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono); font-weight: 600;">10.0</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">90% &ndash; 100%</td>
            <td style="padding: 0.625rem 0.875rem; font-weight: 600;">A+</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">4.0</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">5.0</td>
            <td style="padding: 0.625rem 0.875rem; color: var(--color-emerald); font-weight: 500;">Outstanding</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
            <td style="padding: 0.625rem 0.875rem; font-weight: 700; color: var(--color-ink);">A+</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono); font-weight: 600;">9.0</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">80% &ndash; 89%</td>
            <td style="padding: 0.625rem 0.875rem; font-weight: 600;">A</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">3.7 &ndash; 4.0</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">4.5 &ndash; 4.8</td>
            <td style="padding: 0.625rem 0.875rem; color: var(--color-emerald); font-weight: 500;">Excellent</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
            <td style="padding: 0.625rem 0.875rem; font-weight: 700; color: var(--color-ink);">A</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono); font-weight: 600;">8.0</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">70% &ndash; 79%</td>
            <td style="padding: 0.625rem 0.875rem; font-weight: 600;">A- / B+</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">3.3 &ndash; 3.7</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">4.0 &ndash; 4.3</td>
            <td style="padding: 0.625rem 0.875rem; color: var(--color-blue); font-weight: 500;">Very Good</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
            <td style="padding: 0.625rem 0.875rem; font-weight: 700; color: var(--color-ink);">B+</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono); font-weight: 600;">7.0</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">60% &ndash; 69%</td>
            <td style="padding: 0.625rem 0.875rem; font-weight: 600;">B</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">3.0 &ndash; 3.3</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">3.5 &ndash; 3.8</td>
            <td style="padding: 0.625rem 0.875rem; color: var(--color-blue); font-weight: 500;">Good</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
            <td style="padding: 0.625rem 0.875rem; font-weight: 700; color: var(--color-ink);">B</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono); font-weight: 600;">6.0</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">55% &ndash; 59%</td>
            <td style="padding: 0.625rem 0.875rem; font-weight: 600;">B- / C+</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">2.7 &ndash; 2.9</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">3.0 &ndash; 3.3</td>
            <td style="padding: 0.625rem 0.875rem; color: var(--color-amber); font-weight: 500;">Above Average</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
            <td style="padding: 0.625rem 0.875rem; font-weight: 700; color: var(--color-ink);">C</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono); font-weight: 600;">5.0</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">50% &ndash; 54%</td>
            <td style="padding: 0.625rem 0.875rem; font-weight: 600;">C</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">2.0 &ndash; 2.5</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">2.5 &ndash; 2.8</td>
            <td style="padding: 0.625rem 0.875rem; color: var(--color-amber); font-weight: 500;">Average</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
            <td style="padding: 0.625rem 0.875rem; font-weight: 700; color: var(--color-ink);">P</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono); font-weight: 600;">4.0</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">40% &ndash; 49%</td>
            <td style="padding: 0.625rem 0.875rem; font-weight: 600;">D</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">1.0 &ndash; 1.5</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">1.0 &ndash; 1.8</td>
            <td style="padding: 0.625rem 0.875rem; color: var(--color-mute); font-weight: 500;">Pass</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
            <td style="padding: 0.625rem 0.875rem; font-weight: 700; color: var(--color-red);">F</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono); font-weight: 600;">0.0</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">&lt; 40%</td>
            <td style="padding: 0.625rem 0.875rem; font-weight: 600; color: var(--color-red);">F</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">0.0</td>
            <td style="padding: 0.625rem 0.875rem; font-family: var(--font-mono);">0.0</td>
            <td style="padding: 0.625rem 0.875rem; color: var(--color-red); font-weight: 500;">Fail / Remedial</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script define:vars={{ idPrefix }}>
  (function() {
    const srcScale = document.getElementById(`${idPrefix}-src-scale`);
    const srcVal = document.getElementById(`${idPrefix}-src-val`);
    const quickPick = document.getElementById(`${idPrefix}-quick-pick`);

    const convUs4 = document.getElementById(`${idPrefix}-conv-us4`);
    const convUs4Letter = document.getElementById(`${idPrefix}-conv-us4-letter`);
    const convUs5 = document.getElementById(`${idPrefix}-conv-us5`);
    const convUs5Letter = document.getElementById(`${idPrefix}-conv-us5-letter`);
    const convIn10 = document.getElementById(`${idPrefix}-conv-in10`);
    const convIn10Grade = document.getElementById(`${idPrefix}-conv-in10-grade`);
    const convPct = document.getElementById(`${idPrefix}-conv-pct`);
    const convDivision = document.getElementById(`${idPrefix}-conv-division`);

    function calculate() {
      const mode = srcScale?.value || 'indian10';
      const val = parseFloat(srcVal?.value || '0');

      if (isNaN(val) || val < 0) return;

      let pct = 0;

      if (mode === 'indian10') {
        // CGPA to Pct via AICTE 9.5x
        pct = Math.min(100, Math.max(0, val * 9.5));
      } else if (mode === 'us4') {
        // US 4.0 to Pct (approx: 4.0 = 95%, 3.7 = 90%, 3.0 = 80%, etc.)
        pct = Math.min(100, Math.max(0, (val / 4.0) * 95));
      } else if (mode === 'us5') {
        pct = Math.min(100, Math.max(0, (val / 5.0) * 95));
      } else if (mode === 'percentage') {
        pct = Math.min(100, Math.max(0, val));
      }

      // Convert from pct to each system
      const in10 = Math.min(10, Math.max(0, pct / 9.5));
      const us4 = Math.min(4.0, Math.max(0, (pct / 95) * 4.0));
      const us5 = Math.min(5.0, Math.max(0, (pct / 95) * 5.0));

      if (convPct) convPct.textContent = `${pct.toFixed(1)}%`;
      if (convIn10) convIn10.textContent = in10.toFixed(2);
      if (convUs4) convUs4.textContent = us4.toFixed(2);
      if (convUs5) convUs5.textContent = us5.toFixed(2);

      // Indian letter
      if (convIn10Grade) {
        if (in10 >= 9.5) { convIn10Grade.textContent = 'O'; convIn10Grade.className = 'badge badge-green'; }
        else if (in10 >= 8.5) { convIn10Grade.textContent = 'A+'; convIn10Grade.className = 'badge badge-green'; }
        else if (in10 >= 7.5) { convIn10Grade.textContent = 'A'; convIn10Grade.className = 'badge badge-blue'; }
        else if (in10 >= 6.5) { convIn10Grade.textContent = 'B+'; convIn10Grade.className = 'badge badge-blue'; }
        else if (in10 >= 5.5) { convIn10Grade.textContent = 'B'; convIn10Grade.className = 'badge badge-amber'; }
        else if (in10 >= 4.5) { convIn10Grade.textContent = 'C'; convIn10Grade.className = 'badge badge-amber'; }
        else if (in10 >= 4.0) { convIn10Grade.textContent = 'P'; convIn10Grade.className = 'badge badge-blue'; }
        else { convIn10Grade.textContent = 'F'; convIn10Grade.className = 'badge badge-red'; }
      }

      // US 4.0 letter
      if (convUs4Letter) {
        if (us4 >= 3.85) convUs4Letter.textContent = 'A';
        else if (us4 >= 3.5) convUs4Letter.textContent = 'A-';
        else if (us4 >= 3.15) convUs4Letter.textContent = 'B+';
        else if (us4 >= 2.85) convUs4Letter.textContent = 'B';
        else if (us4 >= 2.5) convUs4Letter.textContent = 'B-';
        else if (us4 >= 2.0) convUs4Letter.textContent = 'C';
        else if (us4 >= 1.0) convUs4Letter.textContent = 'D';
        else convUs4Letter.textContent = 'F';
      }

      // US 5.0 letter
      if (convUs5Letter) {
        if (us5 >= 4.75) convUs5Letter.textContent = 'AP A';
        else if (us5 >= 4.25) convUs5Letter.textContent = 'Honors A';
        else if (us5 >= 3.75) convUs5Letter.textContent = 'AP B';
        else if (us5 >= 3.25) convUs5Letter.textContent = 'Honors B';
        else if (us5 >= 2.5) convUs5Letter.textContent = 'C';
        else convUs5Letter.textContent = 'F';
      }

      // Division
      if (convDivision) {
        if (pct >= 75) convDivision.textContent = 'First Class with Distinction';
        else if (pct >= 60) convDivision.textContent = 'First Division';
        else if (pct >= 50) convDivision.textContent = 'Second Division';
        else if (pct >= 40) convDivision.textContent = 'Pass Division';
        else convDivision.textContent = 'Remedial';
      }
    }

    srcScale?.addEventListener('change', () => {
      const mode = srcScale.value;
      if (mode === 'indian10') { srcVal.max = '10'; srcVal.value = '8.50'; }
      else if (mode === 'us4') { srcVal.max = '4.0'; srcVal.value = '3.50'; }
      else if (mode === 'us5') { srcVal.max = '5.0'; srcVal.value = '4.25'; }
      else if (mode === 'percentage') { srcVal.max = '100'; srcVal.value = '80.0'; }
      calculate();
    });

    srcVal?.addEventListener('input', calculate);

    quickPick?.addEventListener('change', (e) => {
      if (e.target.value && srcVal) {
        srcVal.value = e.target.value;
        calculate();
      }
    });

    calculate();
  })();
</script>
