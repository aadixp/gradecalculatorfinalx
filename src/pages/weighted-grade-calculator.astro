---
// src/pages/weighted-grade-calculator.astro
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Weighted Grade Calculator', item: '/weighted-grade-calculator' }
];

const faqSchema = [
  {
    question: "What is a weighted grade and how is it calculated?",
    answer: "A weighted grade calculates your overall course mark by multiplying each assignment score by its assigned syllabus weight percentage, summing the weighted totals, and dividing by the total active weight percentage."
  },
  {
    question: "What should I do if some weights sum to more than 100%?",
    answer: "If extra credit assignments raise your total weight above 100%, the formula still divides by total weight or keeps extra credit as bonus points. Use the 'Normalize Weights to 100%' button if your syllabus weights accidentally exceed 100%."
  },
  {
    question: "How does the calculator handle incomplete semester weights (less than 100%)?",
    answer: "During mid-semester, completed assignments rarely total 100%. Our calculator automatically normalizes your grade by dividing accumulated points by the active completed weight so your standing is accurate rather than falsely depressed."
  },
  {
    question: "Can I enter letter grades instead of numeric percentages?",
    answer: "Yes! For course-level college GPA calculations where whole courses are assigned letter grades (A, B, C), use our College GPA Calculator."
  }
];
---

<Layout
  title="Weighted Grade Calculator | Calculate Weighted Average & Coursework"
  description="Calculate your weighted course grade percentage easily. Enter assignment categories, scores, and syllabus weight percentages with automatic normalization."
  breadcrumbs={breadcrumbs}
  faqSchema={faqSchema}
  softwareSchema={{
    name: "Weighted Grade Calculator",
    description: "Online weighted course grade calculator supporting syllabus percentage weights, point totals, and weight normalization.",
    applicationCategory: "EducationalApplication"
  }}
>
  <div class="container" style="max-width: 960px; padding-top: 2.5rem; padding-bottom: 5rem;">
    <!-- Breadcrumbs -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.8125rem; color: var(--color-mute);">
        <a href="/" style="color: var(--color-mute); text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: var(--color-hairline);">&gt;</span>
        <span style="color: var(--color-ink); font-weight: 500;">Weighted Grade Calculator</span>
      </nav>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/final-exam-calculator" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          Final Exam Calculator &rarr;
        </a>
        <a href="/gpa-calculator" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          GPA Calculator &rarr;
        </a>
      </div>
    </div>

    <!-- Header Section -->
    <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 1.5rem;">
      <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.35rem;">Syllabus Category Averaging</span>
      <h1 class="heading-lg" style="color: var(--color-ink); font-size: clamp(1.85rem, 4vw, 2.5rem); letter-spacing: -0.02em; margin-top: 0.25rem;">
        Weighted Grade Calculator
      </h1>
      <p style="font-size: 1.05rem; color: var(--color-body); margin-top: 0.75rem; line-height: 1.6; max-width: 780px;">
        Accurately calculate your weighted class average. Add homework, quizzes, tests, labs, and attendance with individual category percentage weights. Supports automatic normalization if incomplete weights sum to less than 100%.
      </p>
    </header>

    <!-- Calculator Live Results Showcase Card -->
    <div class="geist-card geist-card-floating" style="padding: 1.5rem; margin-bottom: 1.5rem; background: linear-gradient(180deg, var(--color-canvas-elevated) 0%, var(--color-canvas-subtle) 100%);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; align-items: center;">
        <div>
          <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.25rem;">Live Weighted Standing</span>
          <div style="display: flex; align-items: baseline; gap: 0.75rem;">
            <span id="wgc-grade-pct" class="display-xl" style="font-feature-settings: 'tnum'; color: var(--color-ink);">--%</span>
            <span id="wgc-grade-letter" class="badge badge-blue" style="font-size: 1rem; padding: 0.25rem 0.75rem;">--</span>
          </div>
          <p style="font-size: 0.875rem; color: var(--color-mute); margin-top: 0.25rem;">
            US 4.0 GPA Equivalent: <strong style="color: var(--color-ink);" id="wgc-gpa-equiv">--</strong>
          </p>
        </div>

        <div class="responsive-col-divider" style="border-left: 1px solid var(--color-hairline); padding-left: 1.25rem;">
          <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
            <span style="color: var(--color-mute);">Weight Accounted For:</span>
            <span id="wgc-weight-label" style="font-weight: 600; color: var(--color-ink); font-family: var(--font-mono);">0%</span>
          </div>
          <div style="width: 100%; height: 8px; background: var(--color-canvas-hover); border-radius: var(--radius-pill); overflow: hidden; margin-bottom: 0.5rem; position: relative;">
            <div id="wgc-progress-bar" style="width: 0%; height: 100%; background: var(--color-blue); border-radius: var(--radius-pill); transition: width 0.3s ease;"></div>
          </div>
          <div id="wgc-weight-msg" style="font-size: 0.75rem; color: var(--color-mute);">
            Weights should sum to 100%
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.5rem; justify-content: center;">
          <button id="wgc-normalize-btn" type="button" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem;">
            Normalize Weights to 100%
          </button>
          <a href="/final-exam-calculator" class="btn btn-ghost" style="font-size: 0.8125rem; text-decoration: none; text-align: center;">
            Plan Final Exam Score &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Main Interactive Table Card -->
    <div class="geist-card" style="padding: 1.5rem; margin-bottom: 2.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem;">
        <div>
          <h3 class="heading-md" style="font-size: 1.15rem; color: var(--color-ink);">Assignments, Quizzes &amp; Exams</h3>
          <p style="font-size: 0.875rem; color: var(--color-mute);">Enter your score, maximum possible points, and category weight.</p>
        </div>
        <button id="wgc-reset-btn" type="button" class="btn btn-ghost" style="font-size: 0.8125rem; color: var(--color-mute);">
          Reset to Sample Data
        </button>
      </div>

      <div class="mobile-table-card-wrap" style="overflow-x: auto;">
        <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
          <thead>
            <tr style="border-bottom: 1px solid var(--color-hairline); text-align: left;">
              <th style="padding: 0.6rem 0.5rem;">Assignment / Category</th>
              <th style="padding: 0.6rem 0.5rem; width: 110px;">Score Earned</th>
              <th style="padding: 0.6rem 0.5rem; width: 110px;">Points Max</th>
              <th style="padding: 0.6rem 0.5rem; width: 100px;">Weight (%)</th>
              <th style="padding: 0.6rem 0.5rem; width: 90px; text-align: right;">Calculated</th>
              <th style="padding: 0.6rem 0.5rem; width: 40px;"></th>
            </tr>
          </thead>
          <tbody id="wgc-tbody">
            <!-- Dynamic rows generated by script -->
          </tbody>
        </table>
      </div>

      <div style="margin-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
        <button id="wgc-add-row-btn" type="button" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; display: inline-flex; align-items: center; gap: 0.4rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          Add Assignment Row
        </button>
      </div>
    </div>

    <!-- Guide & Formula Section -->
    <article class="geist-card" style="padding: 2.25rem 2rem; line-height: 1.75; color: var(--color-body); margin-bottom: 2rem;">
      <h2 class="heading-md" style="color: var(--color-ink); font-size: 1.35rem; margin-bottom: 1rem;">
        How to Calculate a Weighted Grade
      </h2>
      <p style="margin-bottom: 1rem;">
        When assignments carry different degrees of importance (for example, exams count more than daily homework), your grade cannot be computed by simply averaging your raw scores. Instead, you calculate a <strong>weighted arithmetic mean</strong>:
      </p>
      <div style="background: var(--color-canvas-subtle); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: 1.25rem; color: var(--color-blue);">
        Weighted Grade (%) = &Sigma;[(Score &divide; Max) &times; Weight] &divide; &Sigma;Weight
      </div>

      <h3 class="heading-md" style="font-size: 1.15rem; color: var(--color-ink); margin-bottom: 0.75rem;">
        Automatic Mid-Semester Normalization
      </h3>
      <p style="margin-bottom: 1rem;">
        During the middle of a school term, the assignments completed so far rarely add up to 100% of the course syllabus (e.g., only 65% of coursework has been graded). Our calculator automatically handles this by dividing your accumulated weighted points by the active completed weight, giving you an accurate reflection of your true current standing rather than an artificially depressed score.
      </p>
    </article>

    <!-- FAQs -->
    <section class="faq-card" style="margin-bottom: 3rem;">
      <h2 class="heading-md" style="margin-bottom: 1.25rem; color: var(--color-ink);">
        Frequently Asked Questions
      </h2>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div class="faq-item">
          <div class="faq-question">What is a weighted grade and how is it calculated?</div>
          <div class="faq-answer">
            A weighted grade calculates your overall course mark by multiplying each assignment score by its assigned syllabus weight percentage, summing the weighted totals, and dividing by the total active weight percentage.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">What should I do if some weights sum to more than 100%?</div>
          <div class="faq-answer">
            If extra credit assignments raise your total weight above 100%, the formula still divides by total weight or keeps extra credit as bonus points. Use the "Normalize Weights to 100%" button if your syllabus weights accidentally exceed 100%.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">How does the calculator handle incomplete semester weights (less than 100%)?</div>
          <div class="faq-answer">
            During mid-semester, completed assignments rarely total 100%. Our calculator automatically normalizes your grade by dividing accumulated points by the active completed weight so your standing is accurate rather than falsely depressed.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">Can I enter letter grades instead of numeric percentages?</div>
          <div class="faq-answer">
            Yes! For course-level college GPA calculations where whole courses are assigned letter grades (A, B, C), use our <a href="/gpa-calculator" style="color: var(--color-blue); text-decoration: underline;">College GPA Calculator</a>.
          </div>
        </div>
      </div>
    </section>

    <!-- Related Links -->
    <section>
      <h3 class="heading-md" style="margin-bottom: 1rem; color: var(--color-ink);">Related Calculators</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <a href="/final-exam-calculator" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Final Exam Target</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Calculate required score on final exam.</p>
        </a>
        <a href="/gpa-calculator" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Cumulative GPA Calculator</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Calculate overall college GPA.</p>
        </a>
        <a href="/target-gpa-calculator" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Target GPA Planner</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Goal planner for graduation honors.</p>
        </a>
      </div>
    </section>
  </div>
</Layout>

<script>
  interface RowData {
    name: string;
    score: number;
    max: number;
    weight: number;
  }

  const defaultRows: RowData[] = [
    { name: 'Homework Assignments', score: 92, max: 100, weight: 20 },
    { name: 'Midterm Exam 1', score: 85, max: 100, weight: 25 },
    { name: 'Midterm Exam 2', score: 78, max: 100, weight: 25 },
    { name: 'Weekly Quizzes', score: 95, max: 100, weight: 15 },
    { name: 'Class Participation', score: 100, max: 100, weight: 15 }
  ];

  let rows: RowData[] = JSON.parse(JSON.stringify(defaultRows));

  function getLetterAndGpa(pct: number): { letter: string; gpa: string } {
    if (pct >= 93) return { letter: 'A', gpa: '4.00' };
    if (pct >= 90) return { letter: 'A-', gpa: '3.70' };
    if (pct >= 87) return { letter: 'B+', gpa: '3.30' };
    if (pct >= 83) return { letter: 'B', gpa: '3.00' };
    if (pct >= 80) return { letter: 'B-', gpa: '2.70' };
    if (pct >= 77) return { letter: 'C+', gpa: '2.30' };
    if (pct >= 73) return { letter: 'C', gpa: '2.00' };
    if (pct >= 70) return { letter: 'C-', gpa: '1.70' };
    if (pct >= 67) return { letter: 'D+', gpa: '1.30' };
    if (pct >= 60) return { letter: 'D', gpa: '1.00' };
    return { letter: 'F', gpa: '0.00' };
  }

  function renderTable() {
    const tbody = document.getElementById('wgc-tbody');
    if (!tbody) return;
    tbody.innerHTML = '';

    rows.forEach((r, idx) => {
      const tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid var(--color-hairline-soft)';
      const pctEarned = r.max > 0 ? (r.score / r.max) * 100 : 0;

      tr.innerHTML = `
        <td style="padding: 0.5rem;">
          <input type="text" class="form-input row-name" data-idx="${idx}" value="${r.name}" style="width: 100%; padding: 0.35rem 0.5rem; font-size: 0.8125rem;" />
        </td>
        <td style="padding: 0.5rem;">
          <input type="number" class="form-input form-input-mono row-score" data-idx="${idx}" value="${r.score}" min="0" step="0.5" style="width: 100%; padding: 0.35rem 0.5rem; font-size: 0.8125rem;" />
        </td>
        <td style="padding: 0.5rem;">
          <input type="number" class="form-input form-input-mono row-max" data-idx="${idx}" value="${r.max}" min="1" step="0.5" style="width: 100%; padding: 0.35rem 0.5rem; font-size: 0.8125rem;" />
        </td>
        <td style="padding: 0.5rem;">
          <input type="number" class="form-input form-input-mono row-weight" data-idx="${idx}" value="${r.weight}" min="0" step="0.5" style="width: 100%; padding: 0.35rem 0.5rem; font-size: 0.8125rem;" />
        </td>
        <td style="padding: 0.5rem; text-align: right; font-family: var(--font-mono); font-weight: 600; color: var(--color-ink);">
          ${pctEarned.toFixed(1)}%
        </td>
        <td style="padding: 0.5rem; text-align: center;">
          <button type="button" class="btn-remove-row" data-idx="${idx}" style="background: none; border: none; cursor: pointer; color: var(--color-mute); font-size: 1.1rem; line-height: 1;" title="Remove row">&times;</button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    attachRowEvents();
    recalc();
  }

  function attachRowEvents() {
    document.querySelectorAll('.row-name').forEach(inp => {
      inp.addEventListener('input', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        rows[idx].name = (e.target as HTMLInputElement).value;
      });
    });
    document.querySelectorAll('.row-score').forEach(inp => {
      inp.addEventListener('input', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        rows[idx].score = parseFloat((e.target as HTMLInputElement).value) || 0;
        recalc();
      });
    });
    document.querySelectorAll('.row-max').forEach(inp => {
      inp.addEventListener('input', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        rows[idx].max = parseFloat((e.target as HTMLInputElement).value) || 100;
        recalc();
      });
    });
    document.querySelectorAll('.row-weight').forEach(inp => {
      inp.addEventListener('input', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        rows[idx].weight = parseFloat((e.target as HTMLInputElement).value) || 0;
        recalc();
      });
    });
    document.querySelectorAll('.btn-remove-row').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        if (rows.length > 1) {
          rows.splice(idx, 1);
          renderTable();
        }
      });
    });
  }

  function recalc() {
    let totalWeight = 0;
    let weightedSum = 0;

    rows.forEach(r => {
      if (r.max > 0 && r.weight > 0) {
        totalWeight += r.weight;
        weightedSum += (r.score / r.max) * 100 * r.weight;
      }
    });

    const finalPct = totalWeight > 0 ? weightedSum / totalWeight : 0;
    const { letter, gpa } = getLetterAndGpa(finalPct);

    const gradePct = document.getElementById('wgc-grade-pct');
    const gradeLetter = document.getElementById('wgc-grade-letter');
    const gpaVal = document.getElementById('wgc-gpa-equiv');
    const weightLabel = document.getElementById('wgc-weight-label');
    const progressBar = document.getElementById('wgc-progress-bar');
    const weightMsg = document.getElementById('wgc-weight-msg');

    if (gradePct) gradePct.textContent = `${finalPct.toFixed(2)}%`;
    if (gradeLetter) gradeLetter.textContent = letter;
    if (gpaVal) gpaVal.textContent = gpa;
    if (weightLabel) weightLabel.textContent = `${totalWeight.toFixed(1)}%`;
    if (progressBar) {
      const p = Math.min(totalWeight, 100);
      progressBar.style.width = `${p}%`;
      progressBar.style.backgroundColor = totalWeight === 100 ? 'var(--color-emerald)' : totalWeight > 100 ? 'var(--color-amber)' : 'var(--color-blue)';
    }
    if (weightMsg) {
      if (totalWeight === 100) {
        weightMsg.textContent = 'Weights perfectly sum to 100%';
        weightMsg.style.color = 'var(--color-emerald)';
      } else if (totalWeight > 100) {
        weightMsg.textContent = `Weights exceed 100% (currently ${totalWeight.toFixed(1)}%)`;
        weightMsg.style.color = 'var(--color-amber)';
      } else {
        weightMsg.textContent = `Auto-normalized: ${totalWeight.toFixed(1)}% accounted for`;
        weightMsg.style.color = 'var(--color-mute)';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderTable();

    document.getElementById('wgc-add-row-btn')?.addEventListener('click', () => {
      rows.push({
        name: `Assignment ${rows.length + 1}`,
        score: 85,
        max: 100,
        weight: 10
      });
      renderTable();
    });

    document.getElementById('wgc-reset-btn')?.addEventListener('click', () => {
      rows = JSON.parse(JSON.stringify(defaultRows));
      renderTable();
    });

    document.getElementById('wgc-normalize-btn')?.addEventListener('click', () => {
      let currentTotal = rows.reduce((acc, r) => acc + r.weight, 0);
      if (currentTotal > 0) {
        rows.forEach(r => {
          r.weight = Math.round((r.weight / currentTotal) * 1000) / 10;
        });
        renderTable();
      }
    });
  });
</script>
