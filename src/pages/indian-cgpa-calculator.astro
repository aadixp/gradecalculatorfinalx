---
// src/pages/indian-cgpa-calculator.astro
import Layout from '../layouts/Layout.astro';
import IndianCgpaCalculator from '../components/IndianCgpaCalculator.astro';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Indian CGPA Calculator', item: '/indian-cgpa-calculator' }
];

const faqSchema = [
  {
    question: "What is the difference between SGPA and CGPA in Indian universities?",
    answer: "SGPA (Semester Grade Point Average) reflects your academic performance within a single semester, whereas CGPA (Cumulative Grade Point Average) represents your cumulative credit-weighted performance across all completed semesters up to that point."
  },
  {
    question: "How do I convert my Indian 10-point CGPA into marks percentage?",
    answer: "Under the standard AICTE and CBSE benchmark, percentage is calculated as CGPA * 9.5. However, specific universities like Mumbai University, VTU, or Anna University mandate custom institutional formulas on their marksheets. Use our CGPA to Percentage Calculator to evaluate specific university rules."
  },
  {
    question: "Is an 8.0 CGPA considered good in Indian universities?",
    answer: "Yes. In virtually all Indian universities and engineering institutes, an 8.0 CGPA places a student in First Class or First Class with Distinction, comfortably meeting eligibility cutoffs for campus placements, GATE, CAT, UPSC, and overseas graduate admissions."
  },
  {
    question: "How is CGPA calculated for engineering students (BTech, BE)?",
    answer: "For BTech and BE engineering students under CBCS, CGPA is calculated by multiplying each course's credit hours by the grade point earned (10 for O down to 0 for F), summing the total quality points, and dividing by total registered credits across all semesters."
  },
  {
    question: "Can an Indian 10-point CGPA be directly converted to a US 4.0 GPA scale?",
    answer: "A direct linear division (CGPA / 2.5) is inaccurate because Indian grading criteria and grade distributions differ significantly from the US 4.0 system. Credential evaluators like WES or university admissions evaluate each course mark individually. Check our Grade Converter for standard equivalence ranges."
  }
];
---

<Layout
  title="Indian CGPA Calculator (10-Point Scale) | UGC & AICTE CBCS Compliant"
  description="Free Indian CGPA calculator for university and engineering students (BTech, BE, BCA, MCA). Calculate credit-weighted 10-point CGPA based on the UGC & AICTE CBCS letter grading system."
  breadcrumbs={breadcrumbs}
  faqSchema={faqSchema}
  softwareSchema={{
    name: "Indian CGPA Calculator (10-Point Scale)",
    description: "Credit-weighted 10-point CGPA calculator compliant with UGC, AICTE, and Indian university CBCS guidelines.",
    applicationCategory: "EducationalApplication"
  }}
>
  <div class="container" style="max-width: 960px; padding-top: 2.5rem; padding-bottom: 5rem;">
    <!-- Breadcrumbs -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.8125rem; color: var(--color-mute);">
        <a href="/" style="color: var(--color-mute); text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: var(--color-hairline);">&gt;</span>
        <span style="color: var(--color-ink); font-weight: 500;">Indian CGPA Calculator</span>
      </nav>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/indian-sgpa-calculator" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          SGPA Calculator &rarr;
        </a>
        <a href="/cgpa-to-percentage" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          CGPA to % &rarr;
        </a>
      </div>
    </div>

    <!-- Header Section -->
    <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 1.5rem;">
      <span class="mono-eyebrow" style="color: var(--color-emerald); margin-bottom: 0.35rem;">UGC &amp; AICTE 10-Point Grading System</span>
      <h1 class="heading-lg" style="color: var(--color-ink); font-size: clamp(1.85rem, 4vw, 2.5rem); letter-spacing: -0.02em; margin-top: 0.25rem;">
        Indian CGPA Calculator
      </h1>
      <p style="font-size: 1.05rem; color: var(--color-body); margin-top: 0.75rem; line-height: 1.6; max-width: 780px;">
        Calculate your Cumulative Grade Point Average (CGPA) on the standard Indian 10-point scale. Tailored for Anna University, VTU, Mumbai University, AKTU, SPPU, Delhi University, and all UGC/AICTE-affiliated institutions.
      </p>
    </header>

    <!-- Interactive Calculator -->
    <section style="margin-bottom: 3rem;">
      <IndianCgpaCalculator idPrefix="page-cgpa" />
    </section>

    <!-- Detailed Guide & Formula Section -->
    <article class="geist-card" style="padding: 2.25rem 2rem; line-height: 1.75; color: var(--color-body); margin-bottom: 2rem;">
      <h2 class="heading-md" style="color: var(--color-ink); font-size: 1.35rem; margin-bottom: 1rem;">
        How Indian 10-Point CGPA is Calculated
      </h2>
      <p style="margin-bottom: 1rem;">
        In the Indian higher education system regulated by the <strong>University Grants Commission (UGC)</strong> and the <strong>All India Council for Technical Education (AICTE)</strong>, academic performance is evaluated through the Choice Based Credit System (CBCS).
      </p>
      <p style="margin-bottom: 1.25rem;">
        Each course has a prescribed number of credit hours based on lecture, tutorial, and practical hours per week. When a student completes a course, they receive a letter grade with an associated grade point value:
      </p>

      <!-- UGC Grade Point Table -->
      <div style="overflow-x: auto; margin-bottom: 1.5rem;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
          <thead>
            <tr style="background: var(--color-canvas-subtle); border-bottom: 1px solid var(--color-hairline); text-align: left;">
              <th style="padding: 0.5rem 0.75rem;">Letter Grade</th>
              <th style="padding: 0.5rem 0.75rem;">Grade Point</th>
              <th style="padding: 0.5rem 0.75rem;">Academic Description</th>
              <th style="padding: 0.5rem 0.75rem;">Marks Benchmark</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: 0.5rem 0.75rem; font-weight: 700; color: var(--color-ink);">O</td>
              <td style="padding: 0.5rem 0.75rem; font-family: var(--font-mono); font-weight: 600;">10</td>
              <td style="padding: 0.5rem 0.75rem; color: var(--color-emerald);">Outstanding</td>
              <td style="padding: 0.5rem 0.75rem;">90% to 100%</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: 0.5rem 0.75rem; font-weight: 700; color: var(--color-ink);">A+</td>
              <td style="padding: 0.5rem 0.75rem; font-family: var(--font-mono); font-weight: 600;">9</td>
              <td style="padding: 0.5rem 0.75rem; color: var(--color-emerald);">Excellent</td>
              <td style="padding: 0.5rem 0.75rem;">80% to 89%</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: 0.5rem 0.75rem; font-weight: 700; color: var(--color-ink);">A</td>
              <td style="padding: 0.5rem 0.75rem; font-family: var(--font-mono); font-weight: 600;">8</td>
              <td style="padding: 0.5rem 0.75rem; color: var(--color-blue);">Very Good</td>
              <td style="padding: 0.5rem 0.75rem;">70% to 79%</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: 0.5rem 0.75rem; font-weight: 700; color: var(--color-ink);">B+</td>
              <td style="padding: 0.5rem 0.75rem; font-family: var(--font-mono); font-weight: 600;">7</td>
              <td style="padding: 0.5rem 0.75rem; color: var(--color-blue);">Good</td>
              <td style="padding: 0.5rem 0.75rem;">60% to 69%</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: 0.5rem 0.75rem; font-weight: 700; color: var(--color-ink);">B</td>
              <td style="padding: 0.5rem 0.75rem; font-family: var(--font-mono); font-weight: 600;">6</td>
              <td style="padding: 0.5rem 0.75rem; color: var(--color-amber);">Above Average</td>
              <td style="padding: 0.5rem 0.75rem;">55% to 59%</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: 0.5rem 0.75rem; font-weight: 700; color: var(--color-ink);">C</td>
              <td style="padding: 0.5rem 0.75rem; font-family: var(--font-mono); font-weight: 600;">5</td>
              <td style="padding: 0.5rem 0.75rem; color: var(--color-amber);">Average</td>
              <td style="padding: 0.5rem 0.75rem;">50% to 54%</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: 0.5rem 0.75rem; font-weight: 700; color: var(--color-ink);">P</td>
              <td style="padding: 0.5rem 0.75rem; font-family: var(--font-mono); font-weight: 600;">4</td>
              <td style="padding: 0.5rem 0.75rem; color: var(--color-mute);">Pass</td>
              <td style="padding: 0.5rem 0.75rem;">40% to 49%</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: 0.5rem 0.75rem; font-weight: 700; color: var(--color-red);">F</td>
              <td style="padding: 0.5rem 0.75rem; font-family: var(--font-mono); font-weight: 600;">0</td>
              <td style="padding: 0.5rem 0.75rem; color: var(--color-red);">Fail / Reappear</td>
              <td style="padding: 0.5rem 0.75rem;">Below 40%</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="heading-md" style="font-size: 1.15rem; color: var(--color-ink); margin-bottom: 0.75rem;">
        Mathematical Formula
      </h3>
      <div style="background: var(--color-canvas-subtle); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: 1.25rem;">
        CGPA = &Sigma;(C<sub>i</sub> &times; G<sub>i</sub>) &divide; &Sigma;C<sub>i</sub>
      </div>
      <p style="margin-bottom: 1rem;">
        Where <strong>C<sub>i</sub></strong> is the number of credits assigned to course <em>i</em>, and <strong>G<sub>i</sub></strong> is the grade point earned in course <em>i</em>.
      </p>

      <h3 class="heading-md" style="font-size: 1.15rem; color: var(--color-ink); margin-bottom: 0.75rem;">
        Step-by-Step Practical Calculation Example
      </h3>
      <p style="margin-bottom: 0.75rem;">
        Suppose an engineering student enrolls in 5 subjects during a semester:
      </p>
      <ul style="padding-left: 1.25rem; margin-bottom: 1rem;">
        <li>Data Structures &amp; Algorithms: 4 Credits &times; Grade O (10) = 40.0 Points</li>
        <li>Engineering Mathematics: 4 Credits &times; Grade A+ (9) = 36.0 Points</li>
        <li>Operating Systems: 3 Credits &times; Grade A (8) = 24.0 Points</li>
        <li>Database Management: 3 Credits &times; Grade B+ (7) = 21.0 Points</li>
        <li>Software Lab: 2 Credits &times; Grade O (10) = 20.0 Points</li>
      </ul>
      <p style="margin-bottom: 1rem;">
        <strong>Total Credits:</strong> 4 + 4 + 3 + 3 + 2 = <strong>16 Credits</strong><br/>
        <strong>Total Quality Points:</strong> 40 + 36 + 24 + 21 + 20 = <strong>141.0 Points</strong><br/>
        <strong>Resulting CGPA:</strong> 141.0 &divide; 16 = <strong>8.81 / 10.00</strong> (First Class with Distinction).
      </p>
    </article>

    <!-- Frequently Asked Questions -->
    <section class="faq-card" style="margin-bottom: 3rem;">
      <h2 class="heading-md" style="margin-bottom: 1.25rem; color: var(--color-ink);">
        Frequently Asked Questions (FAQs)
      </h2>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div class="faq-item">
          <div class="faq-question">What is the difference between SGPA and CGPA in Indian universities?</div>
          <div class="faq-answer">
            <strong>SGPA (Semester Grade Point Average)</strong> reflects your performance within a single academic semester, whereas <strong>CGPA (Cumulative Grade Point Average)</strong> represents your cumulative weighted performance across all completed semesters up to that point.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">How do I convert my Indian CGPA into marks percentage?</div>
          <div class="faq-answer">
            Under the AICTE and CBSE benchmark, percentage is calculated as <code>CGPA &times; 9.5</code>. However, specific universities like Mumbai University, VTU, or Anna University mandate custom formulas on their marksheets. Use our <a href="/cgpa-to-percentage" style="color: var(--color-blue); text-decoration: underline;">CGPA to Percentage Calculator</a> to evaluate your score across specific institutional rules.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">Is an 8.0 CGPA good in India?</div>
          <div class="faq-answer">
            Yes. In virtually all Indian universities, an 8.0 CGPA places a student safely in <strong>First Class</strong> or <strong>First Class with Distinction</strong>, comfortably meeting the eligibility cutoffs for campus placements, GATE, CAT, UPSC, and overseas graduate admissions.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">How is CGPA calculated for engineering students (BTech, BE)?</div>
          <div class="faq-answer">
            For BTech and BE engineering students under CBCS, CGPA is calculated by multiplying each course's credit hours by the grade point earned (10 for O down to 0 for F), summing the total quality points, and dividing by total registered credits across all semesters.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">Can an Indian 10-point CGPA be directly converted to a US 4.0 GPA scale?</div>
          <div class="faq-answer">
            A direct linear division (CGPA &divide; 2.5) is inaccurate because Indian grading criteria and grade distributions differ significantly from the US 4.0 system. Credential evaluators like WES or university admissions evaluate each course mark individually. Check our <a href="/grade-converter" style="color: var(--color-blue); text-decoration: underline;">Grade Converter</a> for standard equivalence ranges.
          </div>
        </div>
      </div>
    </section>

    <!-- Related Calculators Navigation Grid -->
    <section>
      <h3 class="heading-md" style="margin-bottom: 1rem; color: var(--color-ink);">Explore Related Calculators</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <a href="/indian-sgpa-calculator" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Indian SGPA Calculator</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Calculate term GPA for individual semesters.</p>
        </a>
        <a href="/cgpa-to-percentage" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">CGPA to Percentage</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Convert 10.0 CGPA to marks % with AICTE/VTU rules.</p>
        </a>
        <a href="/target-cgpa-calculator" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Target CGPA Planner</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Calculate required future SGPA to reach target CGPA.</p>
        </a>
        <a href="/grade-converter" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Grade Converter</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Equivalence matrix across US 4.0, 5.0, &amp; UGC 10.0.</p>
        </a>
      </div>
    </section>
  </div>
</Layout>
