---
// src/pages/semester-cgpa-calculator.astro
import Layout from '../layouts/Layout.astro';
import SemesterCgpaCalculator from '../components/SemesterCgpaCalculator.astro';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Semester-wise CGPA Calculator', item: '/semester-cgpa-calculator' }
];

const faqSchema = [
  {
    question: "Can I calculate CGPA for 4 or 6 semesters instead of 8?",
    answer: "Yes. Simply leave uncompleted semesters blank or remove them. The calculator automatically computes your cumulative CGPA strictly based on the completed terms you provide."
  },
  {
    question: "What if one of my semesters has backlog or re-evaluation updates?",
    answer: "Enter the updated, cleared SGPA for that semester. Once your university issues the revised marksheet, your official degree CGPA will reflect the updated quality points."
  },
  {
    question: "How is 8-semester CGPA calculated for BTech and BE engineering degrees?",
    answer: "For 4-year engineering degrees (8 semesters), each semester's SGPA is multiplied by that semester's total credit hours. The sum of all quality points across all 8 terms is then divided by the total graduation credits (typically 160 to 180 credits)."
  },
  {
    question: "What is the minimum CGPA required for First Class with Distinction?",
    answer: "In most Indian universities (such as Anna University, VTU, Mumbai University, and AKTU), a cumulative CGPA of 8.50 or higher without backlogs qualifies for First Class with Distinction, while 6.50 to 8.49 qualifies for First Class."
  }
];
---

<Layout
  title="Semester-Wise CGPA Calculator (Semesters 1-8) | Multi-Term Cumulative"
  description="Calculate your cumulative degree CGPA across Semesters 1 through 8. Enter semester SGPAs and credit counts to compute overall university CGPA and percentage equivalence."
  breadcrumbs={breadcrumbs}
  faqSchema={faqSchema}
  softwareSchema={{
    name: "Semester-wise CGPA Calculator",
    description: "Cumulative multi-semester CGPA calculator supporting Semesters 1 through 8 for university degree programs.",
    applicationCategory: "EducationalApplication"
  }}
>
  <div class="container" style="max-width: 960px; padding-top: 2.5rem; padding-bottom: 5rem;">
    <!-- Breadcrumbs -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.8125rem; color: var(--color-mute);">
        <a href="/" style="color: var(--color-mute); text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: var(--color-hairline);">&gt;</span>
        <span style="color: var(--color-ink); font-weight: 500;">Semester-wise CGPA Calculator</span>
      </nav>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/indian-sgpa-calculator" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          SGPA Calculator &rarr;
        </a>
        <a href="/target-cgpa-calculator" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          Target Planner &rarr;
        </a>
      </div>
    </div>

    <!-- Header Section -->
    <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 1.5rem;">
      <span class="mono-eyebrow" style="color: var(--color-violet); margin-bottom: 0.35rem;">Multi-Semester Progression</span>
      <h1 class="heading-lg" style="color: var(--color-ink); font-size: clamp(1.85rem, 4vw, 2.5rem); letter-spacing: -0.02em; margin-top: 0.25rem;">
        Semester-wise CGPA Calculator
      </h1>
      <p style="font-size: 1.05rem; color: var(--color-body); margin-top: 0.75rem; line-height: 1.6; max-width: 780px;">
        Combine your individual semester SGPAs from Semester 1 through Semester 8 (or custom semester ranges) to determine your cumulative degree CGPA and academic standing.
      </p>
    </header>

    <!-- Interactive Calculator -->
    <section style="margin-bottom: 3rem;">
      <SemesterCgpaCalculator idPrefix="page-semcgpa" />
    </section>

    <!-- Guide & Formula Section -->
    <article class="geist-card" style="padding: 2.25rem 2rem; line-height: 1.75; color: var(--color-body); margin-bottom: 2rem;">
      <h2 class="heading-md" style="color: var(--color-ink); font-size: 1.35rem; margin-bottom: 1rem;">
        Why a Simple Average of SGPAs is Often Incorrect
      </h2>
      <p style="margin-bottom: 1rem;">
        A common mistake students make is taking an arithmetic average of their semester SGPAs:
      </p>
      <div style="background: var(--color-canvas-subtle); padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); font-family: var(--font-mono); font-size: 0.8125rem; margin-bottom: 1rem; color: var(--color-red);">
        Incorrect: Simple Average = (SGPA₁ + SGPA₂ + ... + SGPAₙ) &divide; N
      </div>
      <p style="margin-bottom: 1rem;">
        This simple average is only mathematically valid if every single semester had the exact same credit weight. In reality, Indian engineering and university degree programs vary in semester credit allocation (e.g. Semester 1 may have 22 credits, Semester 4 may have 25 credits, and Semester 8 may have 18 credits).
      </p>
      <p style="margin-bottom: 1.25rem;">
        The true cumulative CGPA must be computed using <strong>credit-weighted aggregation</strong>:
      </p>
      <div style="background: var(--color-canvas-subtle); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: 1.25rem; color: var(--color-emerald);">
        Correct: CGPA = &Sigma;(SGPA<sub>i</sub> &times; Credits<sub>i</sub>) &divide; &Sigma;Credits<sub>i</sub>
      </div>
    </article>

    <!-- FAQs -->
    <section class="faq-card" style="margin-bottom: 3rem;">
      <h2 class="heading-md" style="margin-bottom: 1.25rem; color: var(--color-ink);">
        Frequently Asked Questions
      </h2>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div class="faq-item">
          <div class="faq-question">Can I calculate CGPA for 4 or 6 semesters instead of 8?</div>
          <div class="faq-answer">
            Yes. Simply leave any uncompleted semesters blank or click the remove button. The calculator automatically computes your cumulative CGPA strictly based on the completed terms you provide.
          </div>
        </div>
        <div class="faq-item">
          <div class="faq-question">What if one of my semesters has backlog/re-evaluations?</div>
          <div class="faq-answer">
            Enter the updated, cleared SGPA for that semester. Once your university issues the revised marksheet, your official degree CGPA will reflect the updated quality points.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">How is 8-semester CGPA calculated for BTech and BE engineering degrees?</div>
          <div class="faq-answer">
            For 4-year engineering degrees (8 semesters), each semester's SGPA is multiplied by that semester's total credit hours. The sum of all quality points across all 8 terms is then divided by the total graduation credits (typically 160 to 180 credits).
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">What is the minimum CGPA required for First Class with Distinction?</div>
          <div class="faq-answer">
            In most Indian universities (such as Anna University, VTU, Mumbai University, and AKTU), a cumulative CGPA of 8.50 or higher without backlogs qualifies for First Class with Distinction, while 6.50 to 8.49 qualifies for First Class.
          </div>
        </div>
      </div>
    </section>

    <!-- Related Links -->
    <section>
      <h3 class="heading-md" style="margin-bottom: 1rem; color: var(--color-ink);">Related Calculators</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <a href="/target-cgpa-calculator" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Target CGPA Planner</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Calculate required future term SGPA.</p>
        </a>
        <a href="/indian-sgpa-calculator" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Indian SGPA Calculator</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Calculate term GPA for individual subjects.</p>
        </a>
        <a href="/cgpa-to-percentage" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">CGPA to Percentage</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Convert degree CGPA to marks %.</p>
        </a>
      </div>
    </section>
  </div>
</Layout>
