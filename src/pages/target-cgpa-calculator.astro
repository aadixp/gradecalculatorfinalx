---
// src/pages/target-cgpa-calculator.astro
import Layout from '../layouts/Layout.astro';
import TargetCgpaCalculator from '../components/TargetCgpaCalculator.astro';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Target CGPA Calculator', item: '/target-cgpa-calculator' }
];

const faqSchema = [
  {
    question: "Can I raise my CGPA from 7.0 to 8.5 in my final year?",
    answer: "It depends on completed versus remaining credits. If you have completed 120 credits at 7.0 and have 40 credits left, reaching 8.5 would require an impossible SGPA of 13.0. However, with more remaining credits in earlier terms, raising your CGPA is achievable with consistent 9.0+ SGPA terms."
  },
  {
    question: "What if my required SGPA is lower than 0?",
    answer: "A required SGPA of 0 or below indicates that your target CGPA is mathematically secured. Even with minimal passing grades in remaining courses, your cumulative average cannot drop below your goal."
  },
  {
    question: "How can I strategically improve my CGPA in Indian engineering colleges?",
    answer: "Focus intensely on high-credit subjects (such as 4-credit core theory courses, major projects, and multi-credit laboratory electives). Because CGPA is credit-weighted, earning an O or A+ in a 4-credit subject elevates your cumulative average far more than doing well in a 1-credit or 2-credit course."
  },
  {
    question: "How does the Target CGPA Calculator handle remaining credits?",
    answer: "The calculator takes your current cumulative CGPA and completed credits, compares them with your desired graduation target, and computes the exact average SGPA required across all remaining credits before degree completion."
  }
];
---

<Layout
  title="Target CGPA Calculator | Required Future SGPA Planner (10-Point Scale)"
  description="Calculate the exact future SGPA average needed across remaining credits to graduate with your target CGPA. Includes feasibility analysis, impossible target alerts, and goal planning."
  breadcrumbs={breadcrumbs}
  faqSchema={faqSchema}
  softwareSchema={{
    name: "Target CGPA Calculator",
    description: "Required future semester SGPA planner and academic feasibility calculator for Indian 10-point degree programs.",
    applicationCategory: "EducationalApplication"
  }}
>
  <div class="container" style="max-width: 960px; padding-top: 2.5rem; padding-bottom: 5rem;">
    <!-- Breadcrumbs -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.8125rem; color: var(--color-mute);">
        <a href="/" style="color: var(--color-mute); text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: var(--color-hairline);">&gt;</span>
        <span style="color: var(--color-ink); font-weight: 500;">Target CGPA Calculator</span>
      </nav>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/target-gpa-calculator" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          US Target GPA &rarr;
        </a>
      </div>
    </div>

    <!-- Header Section -->
    <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 1.5rem;">
      <span class="mono-eyebrow" style="color: var(--color-violet); margin-bottom: 0.35rem;">Strategic Graduation Planner</span>
      <h1 class="heading-lg" style="color: var(--color-ink); font-size: clamp(1.85rem, 4vw, 2.5rem); letter-spacing: -0.02em; margin-top: 0.25rem;">
        Target CGPA Calculator
      </h1>
      <p style="font-size: 1.05rem; color: var(--color-body); margin-top: 0.75rem; line-height: 1.6; max-width: 780px;">
        Determine the exact average SGPA you must achieve in remaining semesters to attain your desired graduation CGPA. Provides instant feasibility assessment across distinction and honors benchmarks.
      </p>
    </header>

    <!-- Interactive Calculator -->
    <section style="margin-bottom: 3rem;">
      <TargetCgpaCalculator idPrefix="page-targetcgpa" />
    </section>

    <!-- Guide & Formula Section -->
    <article class="geist-card" style="padding: 2.25rem 2rem; line-height: 1.75; color: var(--color-body); margin-bottom: 2rem;">
      <h2 class="heading-md" style="color: var(--color-ink); font-size: 1.35rem; margin-bottom: 1rem;">
        How Target CGPA is Calculated
      </h2>
      <p style="margin-bottom: 1rem;">
        Your cumulative grade is governed by total quality points divided by total credits. When planning your future semesters, the mathematical formula to find your <strong>Required Future SGPA</strong> is:
      </p>
      <div style="background: var(--color-canvas-subtle); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: 1.25rem;">
        Required SGPA = [Target &times; (Credits<sub>completed</sub> + Credits<sub>remaining</sub>) - (Current &times; Credits<sub>completed</sub>)] &divide; Credits<sub>remaining</sub>
      </div>

      <h3 class="heading-md" style="font-size: 1.15rem; color: var(--color-ink); margin-bottom: 0.75rem;">
        Handling Impossible Targets
      </h3>
      <p style="margin-bottom: 1rem;">
        Because the maximum obtainable SGPA in an Indian university is <strong>10.00</strong> (earning an 'O' grade in every subject), there exists a mathematical upper bound for what any student can achieve given their completed credit history.
      </p>
      <p>
        If the required SGPA exceeds 10.00, our calculator automatically flags the target as mathematically unattainable and displays the maximum achievable graduating CGPA based on a flawless 10.00 run.
      </p>
    </article>

    <!-- FAQs -->
    <section class="faq-card" style="margin-bottom: 3rem;">
      <h2 class="heading-md" style="margin-bottom: 1.25rem; color: var(--color-ink);">
        Frequently Asked Questions
      </h2>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div class="faq-item">
          <div class="faq-question">Can I raise my CGPA from 7.0 to 8.5 in my final year?</div>
          <div class="faq-answer">
            It depends on your completed versus remaining credits. For example, if you completed 120 credits at 7.0 and have 40 credits left, reaching 8.5 would require an impossible SGPA of 13.0. However, if you are only in your second year with 90 credits remaining, reaching 8.5 is achievable with consistent 9.0+ SGPA terms.
          </div>
        </div>
        <div class="faq-item">
          <div class="faq-question">What if my required SGPA is lower than 0?</div>
          <div class="faq-answer">
            A required SGPA of 0 or below indicates that your target CGPA is mathematically secured. Even with 0 grade points in remaining courses, your cumulative average cannot drop below the target.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">How can I strategically improve my CGPA in Indian engineering colleges?</div>
          <div class="faq-answer">
            Focus intensely on high-credit subjects (such as 4-credit core theory courses, major projects, and multi-credit laboratory electives). Because CGPA is credit-weighted, earning an O or A+ in a 4-credit subject elevates your cumulative average far more than doing well in a 1-credit or 2-credit course.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">How does the Target CGPA Calculator handle remaining credits?</div>
          <div class="faq-answer">
            The calculator takes your current cumulative CGPA and completed credits, compares them with your desired graduation target, and computes the exact average SGPA required across all remaining credits before degree completion.
          </div>
        </div>
      </div>
    </section>

    <!-- Related Links -->
    <section>
      <h3 class="heading-md" style="margin-bottom: 1rem; color: var(--color-ink);">Related Calculators</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <a href="/target-gpa-calculator" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Target GPA (US 4.0/5.0)</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Goal planner for US degree programs.</p>
        </a>
        <a href="/semester-cgpa-calculator" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Semester-wise CGPA</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Track progress across Semesters 1 to 8.</p>
        </a>
        <a href="/indian-cgpa-calculator" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Indian CGPA Calculator</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Credit-weighted UGC 10-point calculator.</p>
        </a>
      </div>
    </section>
  </div>
</Layout>
