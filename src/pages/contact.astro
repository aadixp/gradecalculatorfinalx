---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us | GradeCalculatorFinalX Support & Inquiries"
  description="Contact the GradeCalculatorFinalX team for support, feature suggestions, or academic inquiries. Direct responses within 24-48 hours."
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Contact Us', item: '/contact' }
  ]}
>
  <div class="container" style="max-width: 880px; padding-top: 3rem; padding-bottom: 5rem;">
    <!-- Breadcrumb & Return to Calculator -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.8125rem; color: var(--color-mute);">
        <a href="/" style="color: var(--color-mute); text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: var(--color-hairline);">&gt;</span>
        <span style="color: var(--color-ink); font-weight: 500;">Contact Us</span>
      </nav>
      <a href="/" class="btn btn-secondary" style="font-size: 0.8125rem; padding: 0.35rem 0.75rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to Calculator</span>
      </a>
    </div>

    <!-- Page Header -->
    <header style="margin-bottom: 2.5rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 1.75rem;">
      <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.35rem;">Get in Touch</span>
      <h1 class="heading-lg" style="color: var(--color-ink); font-size: clamp(1.75rem, 4vw, 2.25rem); letter-spacing: -0.02em; margin-top: 0.25rem;">
        Contact Our Team
      </h1>
      <p style="font-size: 1rem; color: var(--color-body); margin-top: 0.75rem; line-height: 1.6;">
        Have questions, feedback, or need assistance with grade calculations? We respond to all student and educator inquiries within 24–48 hours.
      </p>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; align-items: start;">
      <!-- Contact Information Card -->
      <div class="geist-card" style="padding: 2rem;">
        <h2 class="heading-md" style="color: var(--color-ink); margin-bottom: 1.25rem; font-size: 1.15rem;">
          Direct Inquiries
        </h2>

        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div>
            <span style="font-size: 0.75rem; font-family: var(--font-mono); text-transform: uppercase; color: var(--color-mute); letter-spacing: 0.05em; display: block;">General & Student Support</span>
            <a href="mailto:support@gradecalculatorfinalx.com" style="color: var(--color-ink); font-weight: 600; text-decoration: none; font-size: 0.9375rem;">support@gradecalculatorfinalx.com</a>
          </div>

          <div>
            <span style="font-size: 0.75rem; font-family: var(--font-mono); text-transform: uppercase; color: var(--color-mute); letter-spacing: 0.05em; display: block;">Institutional & Academic Licensing</span>
            <a href="mailto:academic@gradecalculatorfinalx.com" style="color: var(--color-ink); font-weight: 600; text-decoration: none; font-size: 0.9375rem;">academic@gradecalculatorfinalx.com</a>
          </div>

          <div>
            <span style="font-size: 0.75rem; font-family: var(--font-mono); text-transform: uppercase; color: var(--color-mute); letter-spacing: 0.05em; display: block;">Privacy & Legal</span>
            <a href="mailto:privacy@gradecalculatorfinalx.com" style="color: var(--color-ink); font-weight: 600; text-decoration: none; font-size: 0.9375rem;">privacy@gradecalculatorfinalx.com</a>
          </div>

          <div style="border-top: 1px solid var(--color-hairline); padding-top: 1.25rem; margin-top: 0.5rem;">
            <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.35rem;">Frequently Asked Questions</h3>
            <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.5; margin-bottom: 0.75rem;">
              Looking for quick answers about how weighted calculations, drop-lowest scores, or final exam planners work?
            </p>
            <a href="/#faq" style="font-size: 0.8125rem; color: var(--color-blue); text-decoration: none; font-weight: 500;">Browse our FAQ section &rarr;</a>
          </div>
        </div>
      </div>

      <!-- Interactive Contact Form Card -->
      <div class="geist-card" style="padding: 2rem;">
        <h2 class="heading-md" style="color: var(--color-ink); margin-bottom: 1.25rem; font-size: 1.15rem;">
          Send Us a Message
        </h2>

        <form id="contact-form" style="display: flex; flex-direction: column; gap: 1rem;">
          <div>
            <label for="contact-name" style="display: block; font-size: 0.8125rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">Your Name</label>
            <input type="text" id="contact-name" name="name" required class="form-input" placeholder="e.g. Alex Johnson" />
          </div>

          <div>
            <label for="contact-email" style="display: block; font-size: 0.8125rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">Email Address</label>
            <input type="email" id="contact-email" name="email" required class="form-input" placeholder="e.g. alex@university.edu" />
          </div>

          <div>
            <label for="contact-topic" style="display: block; font-size: 0.8125rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">Subject / Inquiry Topic</label>
            <select id="contact-topic" name="topic" class="form-select">
              <option value="feedback">General Feedback & Suggestions</option>
              <option value="bug">Report a Calculation or Display Issue</option>
              <option value="feature">Request New Feature / Scale Preset</option>
              <option value="academic">Educator / Academic Partnership</option>
              <option value="other">Other Inquiry</option>
            </select>
          </div>

          <div>
            <label for="contact-message" style="display: block; font-size: 0.8125rem; font-weight: 500; color: var(--color-ink); margin-bottom: 0.35rem;">Message</label>
            <textarea id="contact-message" name="message" rows="4" required class="form-input" placeholder="How can we help you?" style="resize: vertical;"></textarea>
          </div>

          <button type="submit" id="submit-contact-btn" class="btn btn-primary" style="margin-top: 0.5rem; justify-content: center;">
            Send Message
          </button>

          <div id="contact-status" style="display: none; padding: 0.75rem 1rem; border-radius: var(--radius-sm); font-size: 0.8125rem; line-height: 1.4;"></div>
        </form>
      </div>
    </div>

    <!-- Bottom Return Action -->
    <div style="text-align: center; margin-top: 3rem;">
      <a href="/" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.65rem 1.25rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Return to Grade Calculator</span>
      </a>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('contact-status');
    const submitBtn = document.getElementById('submit-contact-btn') as HTMLButtonElement | null;

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form || !statusEl || !submitBtn) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      // Simulate instantaneous client-side acknowledgment
      setTimeout(() => {
        form.reset();
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';

        statusEl.style.display = 'block';
        statusEl.style.background = 'var(--color-canvas-subtle)';
        statusEl.style.border = '1px solid var(--color-emerald)';
        statusEl.style.color = 'var(--color-emerald)';
        statusEl.innerHTML = '<strong>Message sent successfully!</strong> Thank you for contacting GradeCalculatorFinalX. We will respond to your email within 24–48 hours.';
      }, 600);
    });
  </script>
</Layout>
