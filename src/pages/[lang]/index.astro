---
import MainPage from '../../components/MainPage.astro';
import { languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  const nonDefaultLocales = (Object.keys(languages) as Lang[]).filter((l) => l !== 'en');
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props as { lang: Lang };
---

<MainPage lang={lang} />
