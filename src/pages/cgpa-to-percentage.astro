---
// src/pages/cgpa-to-percentage.astro
import Layout from '../layouts/Layout.astro';
import CgpaToPercentageCalculator from '../components/CgpaToPercentageCalculator.astro';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'CGPA to Percentage Calculator', item: '/cgpa-to-percentage' }
];

const faqSchema = [
  {
    question: "Why does AICTE multiply CGPA by 9.5 instead of 10?",
    answer: "Statistical research on multi-year student cohorts revealed that the average marks percentage of students scoring 10.0 CGPA approximated 95%, rather than 100%. Therefore, AICTE and CBSE selected 9.5 as an equitable normalizing constant."
  },
  {
    question: "How is First Class with Distinction determined from CGPA in Indian universities?",
    answer: "In most Indian universities, a CGPA of 8.50 or above (or 75% aggregate marks) constitutes First Class with Distinction, provided the degree was completed without active academic arrears."
  },
  {
    question: "Which formula should I use for campus placements (TCS, Infosys, Wipro, Accenture)?",
    answer: "Unless your university transcript explicitly states a custom formula (e.g. VTU or Mumbai University), major IT recruiters and campus placement cells accept the AICTE standard formula: Percentage = CGPA * 9.5."
  },
  {
    question: "What is the Mumbai University and VTU formula for converting CGPA to percentage?",
    answer: "VTU and Mumbai University engineering faculties conventionally use: Percentage = (CGPA - 0.75) * 10. Always verify the back of your official marksheet for department-specific guidelines."
  }
];
---

<Layout
  title="CGPA to Percentage Calculator | 10-Point Indian University Scale"
  description="Convert 10-point CGPA into marks percentage instantly. Compare official conversion formulas for AICTE (9.5x), VTU, Mumbai University, Anna University, and CBSE."
  breadcrumbs={breadcrumbs}
  faqSchema={faqSchema}
  softwareSchema={{
    name: "CGPA to Percentage Calculator",
    description: "Multi-formula Indian 10.0 CGPA to percentage marks converter with AICTE, VTU, and Mumbai University rules.",
    applicationCategory: "EducationalApplication"
  }}
>
  <div class="container" style="max-width: 960px; padding-top: 2.5rem; padding-bottom: 5rem;">
    <!-- Breadcrumbs -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.8125rem; color: var(--color-mute);">
        <a href="/" style="color: var(--color-mute); text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: var(--color-hairline);">&gt;</span>
        <span style="color: var(--color-ink); font-weight: 500;">CGPA to Percentage Calculator</span>
      </nav>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/percentage-to-cgpa" class="btn btn-secondary btn-pill" style="font-size: 0.8125rem; text-decoration: none;">
          Reverse: % to CGPA &rarr;
        </a>
      </div>
    </div>

    <!-- Header Section -->
    <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 1.5rem;">
      <span class="mono-eyebrow" style="color: var(--color-blue); margin-bottom: 0.35rem;">Multi-University Equivalence</span>
      <h1 class="heading-lg" style="color: var(--color-ink); font-size: clamp(1.85rem, 4vw, 2.5rem); letter-spacing: -0.02em; margin-top: 0.25rem;">
        CGPA to Percentage Calculator
      </h1>
      <p style="font-size: 1.05rem; color: var(--color-body); margin-top: 0.75rem; line-height: 1.6; max-width: 780px;">
        Convert your 10.0 scale Cumulative Grade Point Average into percentage marks. Seamlessly toggle between AICTE benchmark, Mumbai University, VTU, and custom rules for campus placements, government exams, and foreign admissions.
      </p>
    </header>

    <!-- Interactive Calculator -->
    <section style="margin-bottom: 3rem;">
      <CgpaToPercentageCalculator idPrefix="page-cgpa2pct" />
    </section>

    <!-- Detailed Guide & Formula Comparison -->
    <article class="geist-card" style="padding: 2.25rem 2rem; line-height: 1.75; color: var(--color-body); margin-bottom: 2rem;">
      <h2 class="heading-md" style="color: var(--color-ink); font-size: 1.35rem; margin-bottom: 1rem;">
        Why There is No Single Universal Conversion Formula in India
      </h2>
      <p style="margin-bottom: 1rem;">
        Unlike standardized US GPA reporting, Indian universities and technical boards possess autonomy in establishing their own grade conversion mechanisms. While <strong>AICTE (All India Council for Technical Education)</strong> and <strong>CBSE</strong> established the standard benchmark of <code>Percentage = CGPA &times; 9.5</code>, notable state universities employ distinct mathematical formulas:
      </p>

      <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
        <div style="background: var(--color-canvas-subtle); padding: 1.125rem; border-radius: var(--radius-sm); border-left: 3px solid var(--color-blue);">
          <strong style="color: var(--color-ink); display: block; font-size: 0.9375rem; margin-bottom: 0.25rem;">1. AICTE &amp; CBSE Standard Rule</strong>
          <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-ink); margin-bottom: 0.25rem;">Percentage (%) = CGPA &times; 9.5</div>
          <span style="font-size: 0.8125rem; color: var(--color-mute);">Widely accepted for GATE, UPSC, IIM admissions, and IT campus recruitment.</span>
        </div>

        <div style="background: var(--color-canvas-subtle); padding: 1.125rem; border-radius: var(--radius-sm); border-left: 3px solid var(--color-violet);">
          <strong style="color: var(--color-ink); display: block; font-size: 0.9375rem; margin-bottom: 0.25rem;">2. Mumbai University &amp; VTU (Visvesvaraya Technological University)</strong>
          <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-ink); margin-bottom: 0.25rem;">Percentage (%) = (CGPA - 0.75) &times; 10</div>
          <span style="font-size: 0.8125rem; color: var(--color-mute);">Specifically designed for engineering colleges affiliated with VTU and Mumbai University.</span>
        </div>

        <div style="background: var(--color-canvas-subtle); padding: 1.125rem; border-radius: var(--radius-sm); border-left: 3px solid var(--color-emerald);">
          <strong style="color: var(--color-ink); display: block; font-size: 0.9375rem; margin-bottom: 0.25rem;">3. Direct 10x Scale (Anna University, IITs, NITs)</strong>
          <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-ink); margin-bottom: 0.25rem;">Percentage (%) = CGPA &times; 10</div>
          <span style="font-size: 0.8125rem; color: var(--color-mute);">Adopted by autonomous premier institutes where 10.0 CGPA directly maps to 100%.</span>
        </div>
      </div>

      <p style="font-size: 0.875rem; color: var(--color-mute);">
        <em>Note: Always examine the instructions on the reverse side of your official university grade sheet or degree certificate before submitting official job or graduate school applications.</em>
      </p>
    </article>

    <!-- FAQs -->
    <section class="faq-card" style="margin-bottom: 3rem;">
      <h2 class="heading-md" style="margin-bottom: 1.25rem; color: var(--color-ink);">
        Frequently Asked Questions
      </h2>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div class="faq-item">
          <div class="faq-question">Why does AICTE multiply CGPA by 9.5 instead of 10?</div>
          <div class="faq-answer">
            Statistical research on multi-year student cohorts revealed that the average marks percentage of students scoring 10.0 CGPA approximated 95%, rather than 100%. Therefore, AICTE and CBSE selected 9.5 as an equitable normalizing constant.
          </div>
        </div>
        <div class="faq-item">
          <div class="faq-question">How is First Class with Distinction determined from CGPA?</div>
          <div class="faq-answer">
            In most Indian universities, a CGPA of <strong>8.5 or above</strong> (or 75% aggregate marks) constitutes First Class with Distinction, provided the degree was completed without active academic arrears.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">Which formula should I use for campus placements (TCS, Infosys, Wipro, Accenture)?</div>
          <div class="faq-answer">
            Unless your university transcript explicitly states a custom formula (such as VTU or Mumbai University), major IT recruiters and campus placement cells accept the AICTE standard formula: <code>Percentage = CGPA &times; 9.5</code>.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">What is the Mumbai University and VTU formula for converting CGPA to percentage?</div>
          <div class="faq-answer">
            VTU and Mumbai University engineering faculties conventionally use: <code>Percentage = (CGPA - 0.75) &times; 10</code>. Always verify the back of your official marksheet for department-specific guidelines.
          </div>
        </div>
      </div>
    </section>

    <!-- Related Links -->
    <section>
      <h3 class="heading-md" style="margin-bottom: 1rem; color: var(--color-ink);">Related Calculators</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <a href="/percentage-to-cgpa" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Percentage to CGPA</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Reverse convert aggregate marks into CGPA.</p>
        </a>
        <a href="/indian-cgpa-calculator" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Indian CGPA Calculator</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Calculate subject-by-subject credit weighted CGPA.</p>
        </a>
        <a href="/grade-converter" class="geist-card" style="padding: 1.25rem; text-decoration: none; display: block;">
          <h4 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem;">Grade Converter</h4>
          <p style="font-size: 0.8125rem; color: var(--color-mute); line-height: 1.4;">Compare US 4.0, 5.0, and Indian 10.0 scales.</p>
        </a>
      </div>
    </section>
  </div>
</Layout>
