---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 - Page Not Found | GradeCalculatorFinalX"
  description="The academic page you are looking for could not be found. Return to GradeCalculatorFinalX to calculate your grades, semester GPA, and final exam scores."
>
  <div class="container" style="max-width: 760px; padding: 4rem 1.5rem 6rem 1.5rem; text-align: center;">
    <!-- Error Status Badge -->
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--color-canvas-subtle); border: 1px solid var(--color-hairline); border-radius: var(--radius-full); padding: 0.35rem 0.85rem; margin-bottom: 1.5rem;">
      <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--color-rose); display: inline-block;"></span>
      <span style="font-size: 0.8125rem; font-family: var(--font-mono); font-weight: 500; color: var(--color-mute); letter-spacing: 0.05em;">HTTP 404 &bull; NOT FOUND</span>
    </div>

    <!-- Big Code Display -->
    <div style="font-size: clamp(4.5rem, 12vw, 7.5rem); font-weight: 800; line-height: 1; letter-spacing: -0.05em; color: var(--color-ink); margin-bottom: 0.5rem; font-family: var(--font-sans);">
      404
    </div>

    <!-- Page Heading -->
    <h1 class="heading-lg" style="color: var(--color-ink); font-size: clamp(1.5rem, 3.5vw, 2rem); margin-bottom: 0.75rem;">
      Page Not Found
    </h1>

    <p style="font-size: 1rem; color: var(--color-body); line-height: 1.6; max-width: 520px; margin: 0 auto 2.25rem auto;">
      The page or calculator URL you requested doesn't exist, may have been relocated, or is temporarily unavailable.
    </p>

    <!-- Action Buttons -->
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3.5rem;">
      <a href="/" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.65rem 1.35rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Return to Grade Calculator</span>
      </a>

      <a href="/contact" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.65rem 1.25rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Report Broken Link</span>
      </a>
    </div>

    <!-- Quick Navigation Links Card -->
    <div class="geist-card" style="padding: 1.75rem; text-align: left; background: var(--color-canvas-subtle);">
      <h2 style="font-size: 0.875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-ink); margin-bottom: 1rem;">
        Popular Calculators & Pages
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem;">
        <a href="/#weighted" style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--color-body); text-decoration: none; padding: 0.5rem 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); background: var(--color-canvas);">
          <span style="color: var(--color-blue);">&rarr;</span>
          <span>Weighted Calculator</span>
        </a>
        <a href="/#final" style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--color-body); text-decoration: none; padding: 0.5rem 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); background: var(--color-canvas);">
          <span style="color: var(--color-emerald);">&rarr;</span>
          <span>Final Exam Planner</span>
        </a>
        <a href="/#gpa" style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--color-body); text-decoration: none; padding: 0.5rem 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); background: var(--color-canvas);">
          <span style="color: var(--color-amber);">&rarr;</span>
          <span>Semester GPA Tracker</span>
        </a>
        <a href="/about" style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--color-body); text-decoration: none; padding: 0.5rem 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); background: var(--color-canvas);">
          <span style="color: var(--color-mute);">&rarr;</span>
          <span>About GradeCalc</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
